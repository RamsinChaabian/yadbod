---
import { getIcon } from '../../utils/icons';

interface Props {
  id: string;
  label: string;
  icon: string;
  ariaLabel: string;
  isActive: boolean;
}

const { id, label, icon, ariaLabel, isActive } = Astro.props;
const emoji = getIcon(icon);
---

<button
  type="button"
  role="tab"
  id={`tab-${id}`}
  aria-selected={isActive}
  aria-controls={`panel-${id}`}
  aria-label={ariaLabel}
  data-tab-id={id}
  class="touch-target flex flex-col items-center justify-center gap-1 rounded-lg px-2 py-1.5 min-w-[52px] sm:min-w-[68px] transition-colors duration-200 text-ivory-muted hover:text-ivory hover:bg-obsidian-elevated aria-selected:text-gold aria-selected:bg-gold/10"
>
  <span class="text-base sm:text-lg leading-none" aria-hidden="true">{emoji}</span>
  <span class="text-[10px] sm:text-xs leading-tight whitespace-nowrap font-medium">{label}</span>
</button>