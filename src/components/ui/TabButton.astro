---
import { getIcon } from '../../utils/icons';

interface Props {
  id: string;
  label: string;
  icon: string;
  ariaLabel: string;
  isActive: boolean;
}

const { id, label, icon, ariaLabel, isActive } = Astro.props;
const emoji = getIcon(icon);
---

<button
  type="button"
  role="tab"
  id={`tab-${id}`}
  aria-selected={isActive}
  aria-controls={`panel-${id}`}
  aria-label={ariaLabel}
  data-tab-id={id}
  class="tab-button group relative flex flex-col items-center justify-center gap-1 rounded-2xl px-2 sm:px-3 py-2 min-w-[58px] sm:min-w-[72px] transition-all duration-300 active:scale-95"
>
  <!-- آیکون در دایره -->
  <span
    data-tab-icon
    class="tab-icon relative flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-xl transition-all duration-300"
  >
    <span class="text-lg sm:text-xl leading-none relative z-10" aria-hidden="true">{emoji}</span>
  </span>

  <!-- نام تب -->
  <span
    data-tab-label
    class="tab-label text-[10px] sm:text-xs leading-tight whitespace-nowrap font-medium transition-colors duration-300"
  >
    {label}
  </span>
</button>

<style>
  /* ---- حالت غیرفعال ---- */
  .tab-button {
    color: #9A9488;
  }

  .tab-icon {
    background: transparent;
  }

  .tab-label {
    color: #9A9488;
  }

  /* Hover (دسکتاپ) */
  @media (hover: hover) {
    .tab-button:not([aria-selected="true"]):hover {
      color: #7A6E60;
    }
    .tab-button:not([aria-selected="true"]):hover .tab-icon {
      background: #F5EDE0;
    }
  }

  /* ---- حالت فعال ---- */
  .tab-button[aria-selected="true"] {
    color: #B8915A;
  }

  .tab-button[aria-selected="true"] .tab-icon {
    background: linear-gradient(135deg, #F5A623, #E8833A);
    color: #FFFFFF;
    transform: scale(1.08) translateY(-2px);
    box-shadow:
      0 6px 16px rgba(232, 131, 58, 0.4),
      0 2px 6px rgba(232, 131, 58, 0.25);
    animation: tab-icon-pulse 2s ease-in-out infinite;
  }

  .tab-button[aria-selected="true"] .tab-label {
    color: #B8915A;
    font-weight: 700;
  }

  @keyframes tab-icon-pulse {
    0%, 100% {
      box-shadow:
        0 6px 16px rgba(232, 131, 58, 0.4),
        0 2px 6px rgba(232, 131, 58, 0.25),
        0 0 0 0 rgba(232, 131, 58, 0.4);
    }
    50% {
      box-shadow:
        0 6px 16px rgba(232, 131, 58, 0.5),
        0 2px 6px rgba(232, 131, 58, 0.3),
        0 0 0 8px rgba(232, 131, 58, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-button[aria-selected="true"] .tab-icon {
      animation: none !important;
    }
  }
</style>