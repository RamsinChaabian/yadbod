---
import { getIcon } from '../../utils/icons';

interface Props {
  id: string;
  label: string;
  icon: string;
  ariaLabel: string;
  isActive: boolean;
}

const { id, label, icon, ariaLabel, isActive } = Astro.props;
const emoji = getIcon(icon);
---

<button
  type="button"
  role="tab"
  id={`tab-${id}`}
  aria-selected={isActive}
  aria-controls={`panel-${id}`}
  aria-label={ariaLabel}
  data-tab-id={id}
  class="tab-button group relative flex flex-col items-center justify-center gap-1 rounded-[26px] px-2 sm:px-3 py-2 min-w-[58px] sm:min-w-[76px] transition-all duration-300 active:scale-95"
>
  <!-- آیکون -->
  <span
    data-tab-icon
    class="tab-icon relative flex items-center justify-center w-10 h-10 sm:w-11 sm:h-11 rounded-[18px] transition-all duration-500"
  >
    <span class="text-lg sm:text-xl leading-none relative z-10" aria-hidden="true">{emoji}</span>
  </span>

  <!-- نام -->
  <span
    data-tab-label
    class="tab-label text-[10px] sm:text-xs leading-tight whitespace-nowrap font-medium transition-colors duration-300"
  >
    {label}
  </span>
</button>

<style>
  .tab-button {
    color: #8B7D6B;
  }

  .tab-icon {
    background: transparent;
  }

  .tab-label {
    color: #8B7D6B;
  }

  @media (hover: hover) {
    .tab-button:not([aria-selected="true"]):hover {
      color: #5A4A3F;
    }
    .tab-button:not([aria-selected="true"]):hover .tab-icon {
      background: rgba(255, 255, 255, 0.4);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
  }

  /* ---- حالت فعال ---- */
  .tab-button[aria-selected="true"] {
    color: #E8833A;
  }

  .tab-button[aria-selected="true"] .tab-icon {
    background: linear-gradient(135deg, #F5A623 0%, #E8833A 100%);
    color: #FFFFFF;
    transform: scale(1.1) translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -1px 0 rgba(140, 109, 63, 0.15),
      0 8px 20px rgba(232, 131, 58, 0.4),
      0 2px 6px rgba(232, 131, 58, 0.25);
    animation: tab-icon-pulse 2.5s ease-in-out infinite;
  }

  .tab-button[aria-selected="true"] .tab-label {
    color: #E8833A;
    font-weight: 700;
  }

  @keyframes tab-icon-pulse {
    0%, 100% {
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.5),
        0 8px 20px rgba(232, 131, 58, 0.4),
        0 0 0 0 rgba(232, 131, 58, 0.35);
    }
    50% {
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.6),
        0 8px 24px rgba(232, 131, 58, 0.5),
        0 0 0 10px rgba(232, 131, 58, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-button[aria-selected="true"] .tab-icon {
      animation: none !important;
    }
  }
</style>