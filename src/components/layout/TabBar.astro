---
import { getEnabledTabs } from '../../utils/config';
import TabButton from '../ui/TabButton.astro';

const tabs = getEnabledTabs();
const firstTabId = tabs[0]?.id ?? '';
---

<nav
  role="tablist"
  aria-label="بخش‌های سایت"
  data-tabbar
  class="fixed bottom-0 inset-x-0 z-50 pointer-events-none"
>
  <div class="mx-auto max-w-2xl px-3 pb-3 sm:pb-5" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
    <div class="relative pointer-events-auto">
      <!-- ⭐ شیشه‌ی نشانگر (حباب لغزان) -->
      <div
        data-tab-indicator
        class="absolute top-1.5 bottom-1.5 rounded-[24px] bg-gradient-to-b from-white/70 to-white/40 border border-white/60 transition-all duration-500 pointer-events-none"
        style="left: 0; width: 0; opacity: 0; box-shadow: inset 0 1px 0 rgba(255,255,255,0.9), 0 4px 16px rgba(232,131,58,0.12);"
        aria-hidden="true"
      ></div>

      <!-- ⭐ نوار تب‌ها با Liquid Glass -->
      <div class="relative flex items-center justify-around gap-0.5 lg-surface px-2 py-2" style="border-radius: 32px;">
        {tabs.map((tab) => (
          <TabButton
            id={tab.id}
            label={tab.label}
            icon={tab.icon}
            ariaLabel={tab.ariaLabel}
            isActive={tab.id === firstTabId}
          />
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  function initTabIndicator() {
    const tabbar = document.querySelector<HTMLElement>('[data-tabbar]');
    const indicatorEl = document.querySelector<HTMLElement>('[data-tab-indicator]');
    if (!tabbar || !indicatorEl) return;

    const indicator: HTMLElement = indicatorEl;
    const tabs = tabbar.querySelectorAll<HTMLButtonElement>('[data-tab-id]');

    function moveIndicator(tab: HTMLButtonElement, instant = false) {
      const rect = tab.getBoundingClientRect();
      const parentRect = tab.parentElement!.getBoundingClientRect();
      const left = rect.left - parentRect.left;

      if (instant) {
        indicator.style.transition = 'none';
      } else {
        indicator.style.transition = 'all 0.55s cubic-bezier(0.34, 1.56, 0.64, 1)';
      }

      indicator.style.left = `${left}px`;
      indicator.style.width = `${rect.width}px`;
      indicator.style.opacity = '1';

      if (instant) {
        requestAnimationFrame(() => {
          indicator.style.transition = 'all 0.55s cubic-bezier(0.34, 1.56, 0.64, 1)';
        });
      }
    }

    function findActiveTab(): HTMLButtonElement | null {
      for (const tab of tabs) {
        if (tab.getAttribute('aria-selected') === 'true') return tab;
      }
      return null;
    }

    tabs.forEach((tab) => {
      const observer = new MutationObserver(() => {
        if (tab.getAttribute('aria-selected') === 'true') {
          moveIndicator(tab);
        }
      });
      observer.observe(tab, { attributes: true, attributeFilter: ['aria-selected'] });
    });

    const active = findActiveTab();
    if (active) {
      moveIndicator(active, true);
    }

    let resizeTimeout: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(() => {
        const current = findActiveTab();
        if (current) moveIndicator(current, true);
      }, 150);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTabIndicator);
  } else {
    initTabIndicator();
  }
</script>