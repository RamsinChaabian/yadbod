---
// فوتر سایت — طراحی و توسعه

const developer = {
  name: 'رامسین چعبیان',
  linkedin: 'https://www.linkedin.com/in/ramsinchaabian/',
};
---

<footer class="mt-16 mb-32 sm:mb-40">
  <div class="max-w-3xl mx-auto px-4">
    <div class="lg-surface p-6 sm:p-8" style="border-radius: 40px;">
      <!-- طراحی و توسعه -->
      <p class="text-center text-xs sm:text-sm text-stone-500 leading-relaxed">
        طراحی و توسعه توسط{' '}
        <a
          href={developer.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link inline-flex items-center gap-1.5 text-amber-700 font-bold hover:text-amber-800 transition-colors group"
          aria-label={`لینکدین ${developer.name}`}
        >
          <span class="border-b-2 border-transparent group-hover:border-amber-700 transition-colors">
            {developer.name}
          </span>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="opacity-60 group-hover:opacity-100 transition-opacity"
            aria-hidden="true"
          >
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </p>

      <!-- خط جداکننده شیشه‌ای -->
      <div class="my-4 h-px bg-gradient-to-r from-transparent via-amber-300/40 to-transparent"></div>

      <!-- ساخته‌شده با ❤️ -->
      <div class="flex justify-center text-[11px] text-stone-400">
        <p class="flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
          <span>ساخته‌شده با ❤️ برای یادگار</span>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    text-underline-offset: 3px;
  }
</style>