---
import { config } from '../../utils/config';

const enabled = config.features.threeBackground && config.features.animations;
---

{enabled && (
  <div
    data-three-bg-wrap
    aria-hidden="true"
    class="fixed inset-0 z-0 pointer-events-none"
    style="background: transparent;"
  >
    <canvas
      data-three-bg
      class="w-full h-full block"
      style="background: transparent;"
    ></canvas>
  </div>
)}