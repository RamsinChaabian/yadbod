---
import { config } from '../../utils/config';
import { withBase } from '../../utils/paths';

const { person } = config;
---

<header class="relative w-full mb-4 sm:mb-6" data-anim-header>
  <div class="relative mx-auto max-w-5xl sm:mt-6 px-0 sm:px-4">

    <!-- ⭐ کاور (بدون overflow-hidden) -->
    <div class="relative w-full h-56 sm:h-64 md:h-72" data-anim-cover>
      <!-- لایه‌ی داخلی با overflow فقط برای عکس -->
      <div class="absolute inset-0 overflow-hidden sm:rounded-[44px]">
        <img
          src={withBase(person.coverImage)}
          alt=""
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1920"
          height="600"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/20 to-black/55"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-white/15 via-transparent to-transparent pointer-events-none"></div>
      </div>

      <!-- ⭐ آواتار — absolute و بیرون از لایه‌ی overflow -->
      <div class="absolute inset-x-0 -bottom-16 sm:-bottom-20 flex justify-center pointer-events-none">
        <div class="pointer-events-auto" data-anim-avatar>
          <div class="relative">
            <!-- هاله‌ی نورانی -->
            <div class="absolute inset-0 rounded-full bg-white/40 backdrop-blur-lg scale-110 opacity-80"></div>
            <!-- آواتار -->
            <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-full overflow-hidden ring-4 ring-white shadow-glass-lg bg-white/40 backdrop-blur-md">
              <img
                src={withBase(person.profileImage)}
                alt={person.imageAlt}
                class="w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="400"
                height="400"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- کارت شیشه‌ای اطلاعات -->
    <div class="px-4 sm:px-0 mt-20 sm:mt-24">
      <div class="lg-surface max-w-2xl mx-auto p-6 sm:p-8 pt-5 sm:pt-6 text-center">
        <h1
          class="text-2xl sm:text-3xl font-bold text-stone-800 tracking-tight"
          data-anim-name
        >
          {person.fullName}
        </h1>

        <p
          class="mt-2 text-xs sm:text-sm text-amber-700/80 tracking-widest tabular-nums font-medium"
          data-anim-dates
        >
          {person.deathDateShamsi} — {person.birthDateShamsi}
        </p>

        <div class="my-4 h-px bg-gradient-to-r from-transparent via-amber-400/40 to-transparent"></div>

        <p
          class="max-w-xl mx-auto text-sm sm:text-base text-stone-600 leading-relaxed text-balance"
          data-anim-bio
        >
          {person.shortBio}
        </p>
      </div>
    </div>
  </div>
</header>