---
// دکمه اشتراک‌گذاری — Web Share API با fallback به clipboard
// در همه‌ی صفحات/تب‌ها دیده می‌شود چون در Header قرار دارد
---

<div data-share-button class="share-button">
  <button
    type="button"
    data-share-trigger
    aria-label="اشتراک‌گذاری سایت"
    class="share-trigger"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="18" cy="5" r="3"/>
      <circle cx="6" cy="12" r="3"/>
      <circle cx="18" cy="19" r="3"/>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
    </svg>
  </button>

  <!-- Toast موفقیت -->
  <div data-share-toast hidden class="share-toast lg-dark" role="status" aria-live="polite">
    <span data-share-toast-icon class="share-toast-icon" aria-hidden="true">✓</span>
    <span data-share-toast-text class="share-toast-text">لینک کپی شد</span>
  </div>
</div>

<script>
  function initShare() {
    const button = document.querySelector<HTMLElement>('[data-share-button]');
    if (!button) return;

    const triggerEl = button.querySelector<HTMLButtonElement>('[data-share-trigger]');
    const toastEl = button.querySelector<HTMLElement>('[data-share-toast]');
    const toastIcon = button.querySelector<HTMLElement>('[data-share-toast-icon]');
    const toastText = button.querySelector<HTMLElement>('[data-share-toast-text]');

    if (!triggerEl || !toastEl) return;

    const trigger: HTMLButtonElement = triggerEl;
    const toast: HTMLElement = toastEl;

    const SITE_URL = window.location.origin + '/';
    const SHARE_TITLE = 'یادبود نجیه رویشدزاده';
    const SHARE_TEXT = 'با احترام به یاد نجیه جان، سایتی برای گرامیداشت خاطرات او آماده کرده‌ایم:';

    let toastTimer: number | null = null;

    function showToast(icon: string, text: string, variant: 'success' | 'error' = 'success') {
      if (toastIcon) toastIcon.textContent = icon;
      if (toastText) toastText.textContent = text;

      toast.classList.toggle('share-toast--error', variant === 'error');
      toast.hidden = false;

      requestAnimationFrame(() => {
        toast.classList.add('is-visible');
      });

      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.classList.remove('is-visible');
        window.setTimeout(() => { toast.hidden = true; }, 300);
      }, 2400);
    }

    function hapticTap() {
      if ('vibrate' in navigator) {
        try { navigator.vibrate(10); } catch { /* ignore */ }
      }
    }

    async function copyLink(): Promise<boolean> {
      try {
        await navigator.clipboard.writeText(SITE_URL);
        return true;
      } catch {
        return false;
      }
    }

    async function handleShare() {
      hapticTap();

      const shareData = {
        title: SHARE_TITLE,
        text: SHARE_TEXT,
        url: SITE_URL,
      };

      if (typeof navigator.share === 'function') {
        try {
          await navigator.share(shareData);
          showToast('✓', 'ممنون که به اشتراک گذاشتید', 'success');
          return;
        } catch (err: unknown) {
          if (err instanceof Error && err.name === 'AbortError') return;
        }
      }

      const ok = await copyLink();
      if (ok) {
        showToast('✓', 'لینک کپی شد — برای دوستانتان بفرستید', 'success');
      } else {
        showToast('⚠', 'امکان کپی نیست. لطفاً لینک را دستی کپی کنید', 'error');
      }
    }

    trigger.addEventListener('click', handleShare);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShare);
  } else {
    initShare();
  }
</script>

<style>
  /* ============================================================
     Share Button — شیشه‌ای با Border گرادیان طلایی
     ============================================================ */
  .share-button {
    position: absolute;
    top: 1rem;
    inset-inline-start: 1rem;
    z-index: 20;
    display: inline-flex;
  }

  /* هاله‌ی نورانی چرخان پشت دکمه */
  .share-button::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 60px;
    height: 60px;
    margin: -30px 0 0 -30px;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      rgba(245, 166, 35, 0) 0deg,
      rgba(245, 166, 35, 0.55) 90deg,
      rgba(255, 244, 220, 0.35) 180deg,
      rgba(232, 131, 58, 0.55) 270deg,
      rgba(245, 166, 35, 0) 360deg
    );
    filter: blur(8px);
    opacity: 0.6;
    z-index: 0;
    pointer-events: none;
    transform-origin: center center;
    animation: share-glow-rotate 8s linear infinite;
    transition: opacity 0.4s ease, filter 0.4s ease;
  }

  .share-button:hover::before {
    opacity: 1;
    filter: blur(10px);
  }

  @keyframes share-glow-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ============================================================
     دکمه اصلی — چندلایه
     ============================================================ */
  .share-trigger {
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    padding: 0;

    /* ⭐ Border گرادیان طلایی + سطح شیشه‌ای */
    border: 1.5px solid transparent;
    background:
      /* سطح داخلی (شیشه) */
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.32) 0%,
        rgba(255, 255, 255, 0.14) 50%,
        rgba(255, 255, 255, 0.22) 100%
      ) padding-box,
      /* border گرادیان طلایی */
      linear-gradient(
        135deg,
        #FFD08A 0%,
        #FFF9EC 22%,
        #F5A623 45%,
        #E8833A 70%,
        #FFF9EC 88%,
        #FFD08A 100%
      ) border-box;

    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);

    /* ⭐ سایه‌های چندلایه */
    box-shadow:
      /* نور داخلی از بالا */
      inset 0 1.5px 0 rgba(255, 255, 255, 0.95),
      /* سایه‌ی داخلی از پایین */
      inset 0 -1.5px 0 rgba(140, 109, 63, 0.22),
      /* نور داخلی از کناره‌ها */
      inset 1px 0 0 rgba(255, 255, 255, 0.4),
      inset -1px 0 0 rgba(255, 255, 255, 0.4),
      /* سایه‌ی خارجی */
      0 6px 20px rgba(0, 0, 0, 0.28),
      0 2px 6px rgba(0, 0, 0, 0.15),
      /* هاله‌ی طلایی */
      0 0 18px rgba(245, 166, 35, 0.35),
      /* حلقه‌ی سفید بیرونی */
      0 0 0 1px rgba(255, 255, 255, 0.15);

    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* آیکون SVG — درخشش جزئی */
  .share-trigger svg {
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.2));
    transition: filter 0.3s ease;
  }

  .share-trigger:hover svg {
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.25)) drop-shadow(0 0 6px rgba(255, 244, 220, 0.6));
  }

  /* Hover — بزرگ‌تر + درخشش بیشتر */
  .share-trigger:hover {
    transform: scale(1.08);
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.42) 0%,
        rgba(255, 255, 255, 0.2) 50%,
        rgba(255, 255, 255, 0.32) 100%
      ) padding-box,
      linear-gradient(
        135deg,
        #FFE0A8 0%,
        #FFFFFF 22%,
        #FFC13D 45%,
        #F5994A 70%,
        #FFFFFF 88%,
        #FFE0A8 100%
      ) border-box;
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 1),
      inset 0 -1.5px 0 rgba(140, 109, 63, 0.28),
      inset 1px 0 0 rgba(255, 255, 255, 0.5),
      inset -1px 0 0 rgba(255, 255, 255, 0.5),
      0 10px 28px rgba(0, 0, 0, 0.32),
      0 4px 10px rgba(0, 0, 0, 0.18),
      0 0 32px rgba(245, 166, 35, 0.65),
      0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  /* Active — فشرده شدن */
  .share-trigger:active {
    transform: scale(0.93);
    transition: all 0.1s ease;
  }

  /* Focus — برای دسترسی‌پذیری */
  .share-trigger:focus-visible {
    outline: 2px solid #F5A623;
    outline-offset: 3px;
  }

  /* ============================================================
     Toast
     ============================================================ */
  .share-toast {
    position: absolute;
    top: 56px;
    inset-inline-start: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-radius: 20px;
    white-space: nowrap;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(255 240 200);
    opacity: 0;
    transform: translateY(-8px) scale(0.92);
    transition:
      opacity 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
    max-width: calc(100vw - 2rem);
  }

  .share-toast.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .share-toast--error {
    border-color: rgba(220, 80, 80, 0.5) !important;
    color: rgb(255 200 200);
  }

  .share-toast-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: linear-gradient(135deg, #F5A623, #E8833A);
    color: white;
    font-size: 0.625rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .share-toast--error .share-toast-icon {
    background: linear-gradient(135deg, #DC5050, #A03030);
  }

  .share-toast-text {
    flex: 1;
  }

  /* موبایل */
  @media (max-width: 640px) {
    .share-button {
      top: 0.75rem;
      inset-inline-start: 0.75rem;
    }

    .share-toast {
      top: 52px;
      font-size: 0.688rem;
      padding: 0.5rem 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .share-button::before {
      animation: none !important;
    }
    .share-trigger,
    .share-toast {
      transition: none !important;
    }
    .share-toast {
      transform: none;
    }
    .share-toast.is-visible {
      transform: none;
    }
  }
</style>