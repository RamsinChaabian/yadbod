---
import { musicConfig } from '../../config/music.config';

const { enabled, tracks, defaultVolume, loop } = musicConfig;
const hasTracks = tracks.length > 0;
const showPlayer = enabled && hasTracks;
const initialVolume = defaultVolume;
---

<div
  data-music-player
  data-initial-volume={initialVolume}
  data-loop={loop ? '1' : '0'}
  class="music-player"
  hidden={!showPlayer}
>
  <button
    type="button"
    data-music-trigger
    aria-label="پخش موسیقی"
    aria-expanded="false"
    class="music-trigger"
  >
    <svg
      data-music-icon-idle
      class="music-icon-idle"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9 18V5l12-2v13"/>
      <circle cx="6" cy="18" r="3"/>
      <circle cx="18" cy="16" r="3"/>
    </svg>

    <div data-music-icon-eq class="music-icon-eq" hidden aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </button>

  <div data-music-panel hidden class="music-panel lg-dark">
    <div class="music-panel-header">
      <p data-music-title class="music-title">{tracks[0]?.title ?? ''}</p>
      <button
        type="button"
        data-music-close
        aria-label="بستن پلیر"
        class="music-panel-close"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="music-controls">
      {tracks.length > 1 && (
        <button
          type="button"
          data-music-prev
          aria-label="آهنگ قبلی"
          class="music-ctrl-btn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
          </svg>
        </button>
      )}

      <button
        type="button"
        data-music-play
        aria-label="پخش"
        class="music-play-btn"
      >
        <svg data-music-play-icon width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg data-music-pause-icon width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display: none;">
          <path d="M6 5h4v14H6zm8 0h4v14h-4z"/>
        </svg>
      </button>

      {tracks.length > 1 && (
        <button
          type="button"
          data-music-next
          aria-label="آهنگ بعدی"
          class="music-ctrl-btn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16 6h2v12h-2zm-1.5 6L6 18V6z"/>
          </svg>
        </button>
      )}
    </div>

    <div
      data-music-progress
      class="music-progress"
      role="slider"
      aria-label="موقعیت پخش"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      tabindex="0"
    >
      <div data-music-progress-fill class="music-progress-fill"></div>
    </div>

    <div class="music-time">
      <span data-music-time-current>0:00</span>
      <span data-music-time-total>0:00</span>
    </div>
  </div>

  <audio
    data-music-audio
    preload="metadata"
    loop={loop}
  ></audio>
</div>

<script>
  import { musicConfig } from '../../config/music.config';

  type Track = { id: string; title: string; src: string };

  function initMusicPlayer() {
    const player = document.querySelector<HTMLElement>('[data-music-player]');
    if (!player || player.hidden) return;

    const triggerEl = player.querySelector<HTMLButtonElement>('[data-music-trigger]');
    const panelEl = player.querySelector<HTMLElement>('[data-music-panel]');
    const audioEl = player.querySelector<HTMLAudioElement>('[data-music-audio]');
    const playBtnEl = player.querySelector<HTMLButtonElement>('[data-music-play]');

    if (!triggerEl || !panelEl || !audioEl || !playBtnEl) return;

    const trigger: HTMLButtonElement = triggerEl;
    const panel: HTMLElement = panelEl;
    const audio: HTMLAudioElement = audioEl;
    const playBtn: HTMLButtonElement = playBtnEl;

    const closeBtn = player.querySelector<HTMLButtonElement>('[data-music-close]');
    const iconIdle = player.querySelector<HTMLElement>('[data-music-icon-idle]');
    const iconEq = player.querySelector<HTMLElement>('[data-music-icon-eq]');
    const titleEl = player.querySelector<HTMLElement>('[data-music-title]');
    const playIcon = player.querySelector<SVGElement>('[data-music-play-icon]');
    const pauseIcon = player.querySelector<SVGElement>('[data-music-pause-icon]');
    const prevBtn = player.querySelector<HTMLButtonElement>('[data-music-prev]');
    const nextBtn = player.querySelector<HTMLButtonElement>('[data-music-next]');
    const progressBar = player.querySelector<HTMLElement>('[data-music-progress]');
    const progressFill = player.querySelector<HTMLElement>('[data-music-progress-fill]');
    const timeCurrent = player.querySelector<HTMLElement>('[data-music-time-current]');
    const timeTotal = player.querySelector<HTMLElement>('[data-music-time-total]');

    const tracks: Track[] = [...musicConfig.tracks];
    if (tracks.length === 0) return;

    const storageKeys = {
      trackIndex: 'najiye-music-track-index',
      volume: 'najiye-music-volume',
      isOpen: 'najiye-music-open',
    };

    let currentTrackIndex = 0;
    let isPlaying = false;
    let isPanelOpen = false;

    try {
      const savedIndex = localStorage.getItem(storageKeys.trackIndex);
      if (savedIndex) {
        const idx = parseInt(savedIndex, 10);
        if (idx >= 0 && idx < tracks.length) currentTrackIndex = idx;
      }
      const savedVolume = localStorage.getItem(storageKeys.volume);
      if (savedVolume) {
        const v = parseFloat(savedVolume);
        if (v >= 0 && v <= 1) audio.volume = v;
      } else {
        audio.volume = parseFloat(player.dataset.initialVolume ?? '0.35');
      }
      if (localStorage.getItem(storageKeys.isOpen) === '1') {
        setTimeout(() => openPanel(), 200);
      }
    } catch {
      audio.volume = parseFloat(player.dataset.initialVolume ?? '0.35');
    }

    function loadTrack(index: number) {
      const wasPlaying = isPlaying;
      currentTrackIndex = ((index % tracks.length) + tracks.length) % tracks.length;
      const track = tracks[currentTrackIndex];

      audio.src = track.src;
      if (titleEl) titleEl.textContent = track.title;

      try {
        localStorage.setItem(storageKeys.trackIndex, String(currentTrackIndex));
      } catch { /* ignore */ }

      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: track.title,
          artist: 'یادبود نجیه رویشدزاده',
          album: 'یادگار',
        });
      }

      if (wasPlaying) {
        audio.play().catch(() => { /* ignore */ });
      }
    }

    function updatePlayIcon() {
      if (isPlaying) {
        playIcon?.style.setProperty('display', 'none');
        pauseIcon?.style.setProperty('display', 'block');
        iconIdle?.setAttribute('hidden', '');
        iconEq?.removeAttribute('hidden');
        playBtn.setAttribute('aria-label', 'توقف');
      } else {
        playIcon?.style.setProperty('display', 'block');
        pauseIcon?.style.setProperty('display', 'none');
        iconIdle?.removeAttribute('hidden');
        iconEq?.setAttribute('hidden', '');
        playBtn.setAttribute('aria-label', 'پخش');
      }
    }

    function formatTime(seconds: number): string {
      if (!isFinite(seconds) || seconds < 0) return '0:00';
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${s.toString().padStart(2, '0')}`;
    }

    function updateProgress() {
      if (!audio.duration || !isFinite(audio.duration)) return;
      const percent = (audio.currentTime / audio.duration) * 100;
      if (progressFill) progressFill.style.width = `${percent}%`;
      if (timeCurrent) timeCurrent.textContent = formatTime(audio.currentTime);
      if (progressBar) progressBar.setAttribute('aria-valuenow', String(Math.round(percent)));
    }

    function updateDuration() {
      if (timeTotal) timeTotal.textContent = formatTime(audio.duration);
    }

    function openPanel() {
      isPanelOpen = true;
      panel.removeAttribute('hidden');
      trigger.setAttribute('aria-expanded', 'true');
      trigger.classList.add('is-open');
      try { localStorage.setItem(storageKeys.isOpen, '1'); } catch { /* ignore */ }
    }

    function closePanel() {
      isPanelOpen = false;
      panel.setAttribute('hidden', '');
      trigger.setAttribute('aria-expanded', 'false');
      trigger.classList.remove('is-open');
      try { localStorage.setItem(storageKeys.isOpen, '0'); } catch { /* ignore */ }
    }

    async function togglePlay() {
      if (isPlaying) {
        audio.pause();
      } else {
        try {
          await audio.play();
        } catch (err) {
          console.warn('[music] play failed:', err);
        }
      }
    }

    trigger.addEventListener('click', () => {
      if (isPanelOpen) closePanel();
      else openPanel();
    });

    closeBtn?.addEventListener('click', closePanel);
    playBtn.addEventListener('click', togglePlay);

    prevBtn?.addEventListener('click', () => loadTrack(currentTrackIndex - 1));
    nextBtn?.addEventListener('click', () => loadTrack(currentTrackIndex + 1));

    audio.addEventListener('timeupdate', updateProgress);
    audio.addEventListener('loadedmetadata', updateDuration);

    audio.addEventListener('ended', () => {
      if (tracks.length > 1) {
        loadTrack(currentTrackIndex + 1);
      } else {
        isPlaying = false;
        updatePlayIcon();
      }
    });

    audio.addEventListener('play', () => {
      isPlaying = true;
      updatePlayIcon();
    });

    audio.addEventListener('pause', () => {
      isPlaying = false;
      updatePlayIcon();
    });

    if (progressBar) {
      progressBar.addEventListener('click', (e) => {
        if (!audio.duration || !isFinite(audio.duration)) return;

        const rect = progressBar.getBoundingClientRect();
        const x = e.clientX - rect.left;

        const isRTL = getComputedStyle(progressBar).direction === 'rtl';
        const percent = isRTL ? 1 - x / rect.width : x / rect.width;

        audio.currentTime = Math.max(0, Math.min(1, percent)) * audio.duration;
      });

      progressBar.addEventListener('keydown', (e) => {
        if (!audio.duration) return;
        const isRTL = getComputedStyle(progressBar).direction === 'rtl';

        if (e.key === 'ArrowRight') {
          e.preventDefault();
          if (isRTL) {
            audio.currentTime = Math.max(0, audio.currentTime - 5);
          } else {
            audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
          }
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          if (isRTL) {
            audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
          } else {
            audio.currentTime = Math.max(0, audio.currentTime - 5);
          }
        } else if (e.key === ' ') {
          e.preventDefault();
          togglePlay();
        }
      });
    }

    audio.addEventListener('volumechange', () => {
      try {
        localStorage.setItem(storageKeys.volume, String(audio.volume));
      } catch { /* ignore */ }
    });

    if ('mediaSession' in navigator) {
      navigator.mediaSession.setActionHandler('play', () => {
        audio.play().catch(() => { /* ignore */ });
      });
      navigator.mediaSession.setActionHandler('pause', () => {
        audio.pause();
      });
      if (tracks.length > 1) {
        navigator.mediaSession.setActionHandler('previoustrack', () => {
          loadTrack(currentTrackIndex - 1);
        });
        navigator.mediaSession.setActionHandler('nexttrack', () => {
          loadTrack(currentTrackIndex + 1);
        });
      }
    }

    loadTrack(currentTrackIndex);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMusicPlayer);
  } else {
    initMusicPlayer();
  }
</script>

<style>
  /* ============================================================
     Music Player
     ============================================================ */
  .music-player {
    position: absolute;
    top: 1rem;
    inset-inline-end: 1rem;
    z-index: 20;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: calc(100% - 2rem);
  }

  /* هاله‌ی نورانی چرخان پشت دکمه */
  .music-player::before {
    content: '';
    position: absolute;
    top: 1rem;
    inset-inline-end: 0;
    width: 60px;
    height: 60px;
    margin-top: -30px;
    margin-inline-end: -8px;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      rgba(245, 166, 35, 0) 0deg,
      rgba(245, 166, 35, 0.55) 90deg,
      rgba(255, 244, 220, 0.35) 180deg,
      rgba(232, 131, 58, 0.55) 270deg,
      rgba(245, 166, 35, 0) 360deg
    );
    filter: blur(8px);
    opacity: 0.6;
    z-index: 0;
    pointer-events: none;
    transform-origin: center center;
    animation: music-glow-rotate 8s linear infinite;
    transition: opacity 0.4s ease, filter 0.4s ease;
  }

  .music-player:hover::before {
    opacity: 1;
    filter: blur(10px);
  }

  @keyframes music-glow-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ============================================================
     دکمه اصلی
     ============================================================ */
  .music-trigger {
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;

    /* ⭐ Border گرادیان طلایی + سطح شیشه‌ای */
    border: 1.5px solid transparent;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.32) 0%,
        rgba(255, 255, 255, 0.14) 50%,
        rgba(255, 255, 255, 0.22) 100%
      ) padding-box,
      linear-gradient(
        135deg,
        #FFD08A 0%,
        #FFF9EC 22%,
        #F5A623 45%,
        #E8833A 70%,
        #FFF9EC 88%,
        #FFD08A 100%
      ) border-box;

    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);

    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1.5px 0 rgba(140, 109, 63, 0.22),
      inset 1px 0 0 rgba(255, 255, 255, 0.4),
      inset -1px 0 0 rgba(255, 255, 255, 0.4),
      0 6px 20px rgba(0, 0, 0, 0.28),
      0 2px 6px rgba(0, 0, 0, 0.15),
      0 0 18px rgba(245, 166, 35, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.15);

    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* آیکون SVG */
  .music-trigger svg {
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.2));
    transition: filter 0.3s ease;
  }

  .music-trigger:hover svg {
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.25)) drop-shadow(0 0 6px rgba(255, 244, 220, 0.6));
  }

  .music-trigger:hover {
    transform: scale(1.08);
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.42) 0%,
        rgba(255, 255, 255, 0.2) 50%,
        rgba(255, 255, 255, 0.32) 100%
      ) padding-box,
      linear-gradient(
        135deg,
        #FFE0A8 0%,
        #FFFFFF 22%,
        #FFC13D 45%,
        #F5994A 70%,
        #FFFFFF 88%,
        #FFE0A8 100%
      ) border-box;
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 1),
      inset 0 -1.5px 0 rgba(140, 109, 63, 0.28),
      inset 1px 0 0 rgba(255, 255, 255, 0.5),
      inset -1px 0 0 rgba(255, 255, 255, 0.5),
      0 10px 28px rgba(0, 0, 0, 0.32),
      0 4px 10px rgba(0, 0, 0, 0.18),
      0 0 32px rgba(245, 166, 35, 0.65),
      0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  .music-trigger:active {
    transform: scale(0.94);
    transition: all 0.1s ease;
  }

  .music-trigger:focus-visible {
    outline: 2px solid #F5A623;
    outline-offset: 3px;
  }

  /* ⭐ حالت باز — طلایی درخشان */
  .music-trigger.is-open {
    background:
      linear-gradient(
        135deg,
        rgba(245, 166, 35, 0.95) 0%,
        rgba(232, 131, 58, 0.98) 100%
      ) padding-box,
      linear-gradient(
        135deg,
        #FFE0A8 0%,
        #FFFFFF 22%,
        #FFC13D 45%,
        #F5994A 70%,
        #FFFFFF 88%,
        #FFE0A8 100%
      ) border-box;
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 0.6),
      inset 0 -1.5px 0 rgba(140, 109, 63, 0.3),
      0 10px 28px rgba(232, 131, 58, 0.5),
      0 4px 12px rgba(232, 131, 58, 0.3),
      0 0 24px rgba(245, 166, 35, 0.7),
      0 0 0 1px rgba(255, 255, 255, 0.3);
  }

  /* Equalizer */
  .music-icon-idle {
    display: block;
  }

  .music-icon-eq {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
    height: 18px;
    width: 18px;
  }

  .music-icon-eq span {
    display: block;
    width: 3px;
    background: currentColor;
    border-radius: 2px;
    transform-origin: bottom center;
    animation: music-eq-bounce 0.9s ease-in-out infinite;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.2));
  }

  .music-icon-eq span:nth-child(1) {
    animation-delay: 0s;
    height: 60%;
  }
  .music-icon-eq span:nth-child(2) {
    animation-delay: 0.15s;
    height: 100%;
  }
  .music-icon-eq span:nth-child(3) {
    animation-delay: 0.3s;
    height: 70%;
  }

  @keyframes music-eq-bounce {
    0%, 100% { transform: scaleY(0.35); }
    50% { transform: scaleY(1); }
  }

  /* ============================================================
     Panel
     ============================================================ */
  .music-panel {
    min-width: 240px;
    max-width: calc(100vw - 5rem);
    padding: 0.875rem 1rem;
    border-radius: 24px;
    animation: music-panel-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes music-panel-in {
    from {
      opacity: 0;
      transform: translateX(-10px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  .music-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .music-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: rgb(245 208 122);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
  }

  .music-panel-close {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.6);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: all 0.2s;
  }

  .music-panel-close:hover {
    background: rgba(255, 255, 255, 0.15);
    color: white;
  }

  .music-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .music-play-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    background: linear-gradient(135deg, #F5A623, #E8833A);
    border: 1.5px solid transparent;
    cursor: pointer;
    padding: 0;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -1px 0 rgba(140, 109, 63, 0.2),
      0 4px 16px rgba(232, 131, 58, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.15);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .music-play-btn:hover {
    transform: scale(1.1);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      inset 0 -1px 0 rgba(140, 109, 63, 0.25),
      0 6px 22px rgba(232, 131, 58, 0.6),
      0 0 20px rgba(245, 166, 35, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  .music-play-btn:active {
    transform: scale(0.95);
  }

  .music-ctrl-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    cursor: pointer;
    padding: 0;
    transition: all 0.25s;
  }

  .music-ctrl-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(245, 166, 35, 0.4);
    color: white;
    transform: scale(1.08);
  }

  .music-progress {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    overflow: hidden;
    cursor: pointer;
    position: relative;
    margin-bottom: 0.5rem;
    outline: none;
    direction: ltr;
  }

  .music-progress:focus-visible {
    box-shadow: 0 0 0 2px rgba(245, 166, 35, 0.6);
  }

  .music-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #F5A623, #E8833A);
    border-radius: 3px;
    transition: width 0.15s linear;
    box-shadow: 0 0 8px rgba(245, 166, 35, 0.5);
  }

  .music-time {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.625rem;
    color: rgba(255, 255, 255, 0.5);
    font-variant-numeric: tabular-nums;
    direction: ltr;
  }

  @media (max-width: 640px) {
    .music-player {
      top: 0.75rem;
      inset-inline-end: 0.75rem;
    }

    .music-player::before {
      top: 0.75rem;
    }

    .music-panel {
      min-width: 220px;
      padding: 0.75rem 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .music-player::before {
