---
import { config } from '../../utils/config';
import { withBase } from '../../utils/paths';

interface Props {
  profileImage: string;
  imageAlt: string;
}

const { profileImage, imageAlt } = Astro.props;
const { uiStrings, emotionalBadges, panoramaUrl, defaultRainAmount } = config.shrine;
---

<!-- عکس پروفایل و شمارنده زنده -->
<div class="pointer-events-auto" data-anim-avatar>
  <div class="relative flex flex-col items-center" id="avatar-story-wrapper" data-story-active="false">
    <!-- هاله‌ی نورانی پایه -->
    <div class="absolute inset-0 rounded-full bg-white/40 backdrop-blur-lg scale-110 opacity-80 transition-all duration-500"></div>

    <!-- موج پالس بیرونی (فقط وقتی بیش از ۱ نفر آنلاین است فعال می‌شود) -->
    <div
      id="story-pulse-halo"
      class="absolute -inset-2 rounded-full opacity-0 pointer-events-none transition-opacity duration-500"
    ></div>

    <!-- حلقه‌ی چرخان استوری اینستاگرام (فقط وقتی بیش از ۱ نفر آنلاین است فعال می‌شود) -->
    <div
      id="story-gradient-ring"
      class="relative p-[3.5px] sm:p-[4px] rounded-full transition-all duration-500 bg-white/80 shadow-glass-lg"
    >
      <!-- لایه گرادینت چرخان -->
      <div
        id="story-spinner"
        class="story-conic-gradient absolute inset-0 rounded-full opacity-0 transition-opacity duration-500"
      ></div>

      <!-- آواتار (قابل کلیک) با فاصله سفید داخلی مشابه استوری اینستاگرام -->
      <div
        id="trigger-shrine-modal"
        class="relative z-10 w-28 h-28 sm:w-32 sm:h-32 rounded-full overflow-hidden ring-[3px] ring-white bg-white cursor-pointer group transition-transform duration-300 hover:scale-[1.03] active:scale-95"
        title={uiStrings.avatarTitle}
      >
        <img
          src={withBase(profileImage)}
          alt={imageAlt}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="400"
          height="400"
        />

        <!-- افکت درخشش روی عکس (فقط در حالت Hover نمایش داده می‌شود) -->
        <div
          id="avatar-overlay-hint"
          class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-2.5"
        >
          <span class="text-[10px] sm:text-[11px] text-white font-bold drop-shadow-md tracking-tight flex items-center gap-1">
            {uiStrings.avatarHoverText}
          </span>
        </div>
      </div>
    </div>

    <!-- نشانگر آنلاین زنده (روی عکس پروفایل) -->
    <button
      type="button"
      id="trigger-shrine-badge"
      class="relative z-20 -mt-3.5 bg-stone-900/92 hover:bg-stone-900 border border-amber-500/45 text-amber-300 text-[11px] sm:text-xs font-bold px-3.5 py-1.5 rounded-full flex items-center gap-1.5 backdrop-blur-md shadow-lg whitespace-nowrap transition-all duration-300 cursor-pointer hover:scale-105 active:scale-95"
      title={uiStrings.badgeTitle}
    >
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span><span id="live-user-count">۱</span> {uiStrings.onlineSuffix}</span>
      <span
        id="story-cta-pill"
        class="hidden items-center gap-0.5 text-[10px] text-white bg-gradient-to-r from-amber-500 to-rose-500 px-1.5 py-0.5 rounded-full font-extrabold mr-0.5 shadow-sm animate-pulse"
      >
        {uiStrings.enterCtaText}
      </span>
    </button>
  </div>
</div>

<!-- مدال محراب -->
<div
  id="shrine-modal"
  class="fixed inset-0 z-[99999] hidden opacity-0 transition-opacity duration-500 bg-black select-none"
  data-panorama-url={panoramaUrl}
  data-default-rain={defaultRainAmount}
  data-default-label={uiStrings.defaultTributeLabel}
  data-default-emoji={uiStrings.defaultTributeEmoji}
>
  <!-- نوار بالایی مدال: دکمه بستن + شمارنده زنده کاربران در داخل محراب -->
  <div class="absolute top-5 sm:top-6 left-5 sm:left-6 right-5 sm:right-6 z-[100000] flex items-center justify-between pointer-events-none">
    <!-- نشانگر بلادرنگ کاربران حاضر در محراب -->
    <div class="pointer-events-auto bg-stone-950/75 border border-amber-500/35 text-amber-200 text-xs sm:text-sm font-bold px-4 py-2 rounded-full flex items-center gap-2 backdrop-blur-md shadow-[0_4px_20px_rgba(0,0,0,0.6)] transition-transform duration-300" id="modal-live-badge">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <span><strong id="modal-live-user-count" class="text-amber-300 font-extrabold mx-0.5">۱</strong> {uiStrings.modalOnlineSuffix}</span>
    </div>

    <!-- دکمه بستن -->
    <button id="close-shrine-modal" class="pointer-events-auto w-11 h-11 sm:w-12 sm:h-12 bg-white/10 hover:bg-white/20 backdrop-blur-md rounded-full text-white flex items-center justify-center transition-all cursor-pointer border border-white/15 shadow-lg active:scale-90">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- کانتینر پیام‌های شناور احساسی -->
  <div id="floating-tributes-container" class="pointer-events-none absolute inset-0 z-[99999] overflow-hidden"></div>

  <!-- کانتینر Three.js -->
  <div id="three-container" class="w-full h-full relative cursor-grab active:cursor-grabbing">
    <!-- ویگنت سینمایی ملایم برای عمق دادن به تصویر -->
    <div class="pointer-events-none absolute inset-0 z-[5] bg-[radial-gradient(circle_at_center,transparent_50%,rgba(0,0,0,0.68)_100%)]"></div>

    <!-- بخش پایینی: راهنما + بج‌های احساسی برای گل‌باران همگانی -->
    <div class="absolute bottom-5 sm:bottom-8 inset-x-0 z-20 flex flex-col items-center gap-3 px-4 pointer-events-none">
      <!-- راهنما -->
      <div class="text-center text-amber-100/80 text-xs sm:text-sm pointer-events-none transition-opacity duration-300 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]" id="shrine-hint">
        {uiStrings.shrineHint}
      </div>

      <!-- نوار بج‌های رنگی و احساسی -->
      <div
        id="shrine-badges-bar"
        class="pointer-events-auto flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 max-w-2xl bg-stone-950/60 backdrop-blur-xl border border-white/15 px-3.5 py-2.5 sm:px-5 sm:py-3 rounded-3xl shadow-[0_12px_40px_rgba(0,0,0,0.65)]"
      >
        {emotionalBadges.map((badge) => (
          <button
            type="button"
            data-shrine-badge
            data-label={badge.label}
            data-emoji={badge.emoji}
            data-petal-type={badge.petalType}
            data-amount={badge.amount}
            class={`group relative overflow-hidden rounded-full bg-gradient-to-r ${badge.gradient} border backdrop-blur-md px-3.5 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-bold flex items-center gap-1.5 shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:scale-105 active:scale-95 cursor-pointer`}
          >
            <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 pointer-events-none"></span>
            <span class="text-sm sm:text-base transition-transform duration-300 group-hover:scale-125 group-hover:rotate-6">{badge.emoji}</span>
            <span class="tracking-tight drop-shadow-sm">{badge.label}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .story-conic-gradient {
    background: conic-gradient(
      from 0deg,
      #f5a623,
      #e8833a,
      #f43f5e,
      #d95b43,
      #fbbf24,
      #f43f5e,
      #f5a623
    );
    animation: story-spin 3.2s linear infinite;
  }

  #avatar-story-wrapper[data-story-active="true"] #story-spinner {
    opacity: 1;
  }

  #avatar-story-wrapper[data-story-active="true"] #story-gradient-ring {
    box-shadow:
      0 0 25px rgba(244, 63, 94, 0.45),
      0 0 45px rgba(245, 166, 35, 0.35);
    transform: scale(1.02);
  }

  #avatar-story-wrapper[data-story-active="true"] #story-pulse-halo {
    opacity: 1;
    border: 2px solid rgba(245, 166, 35, 0.65);
    box-shadow: 0 0 20px rgba(244, 63, 94, 0.4);
    animation: story-ripple 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes story-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes story-ripple {
    0% {
      transform: scale(0.96);
      opacity: 0.85;
    }
    70% {
      transform: scale(1.16);
      opacity: 0;
    }
    100% {
      transform: scale(1.16);
      opacity: 0;
    }
  }

  :global(.floating-tribute-pill) {
    position: absolute;
    bottom: 110px;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 99999;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border-radius: 9999px;
    background: linear-gradient(135deg, rgba(28, 25, 23, 0.85), rgba(41, 37, 36, 0.72));
    border: 1px solid rgba(251, 191, 36, 0.45);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.5), 0 0 20px rgba(245, 158, 11, 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fef3c7;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    animation: float-up-tribute 3.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes float-up-tribute {
    0% {
      opacity: 0;
      transform: translate(-50%, 16px) scale(0.8);
    }
    15% {
      opacity: 1;
      transform: translate(-50%, 0px) scale(1.04);
    }
    30% {
      transform: translate(calc(-50% + var(--sway-x, 12px)), -45px) scale(1);
    }
    75% {
      opacity: 0.9;
      transform: translate(calc(-50% - var(--sway-x, 12px)), -160px) scale(0.98);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -230px) scale(0.9);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-conic-gradient,
    #avatar-story-wrapper[data-story-active="true"] #story-pulse-halo {
      animation: none !important;
    }
  }
</style>

<script>
  import { joinRoom } from '@trystero-p2p/mqtt';
  import * as THREE from 'three';

  const modalElement = document.getElementById('shrine-modal');
  if (modalElement && modalElement.parentElement !== document.body) {
    document.body.appendChild(modalElement);
  }

  const PANORAMA_URL = modalElement?.getAttribute('data-panorama-url') || 'https://threejs.org/examples/textures/2294472375_24a3b8ef46_o.jpg';
  const DEFAULT_RAIN_AMOUNT = parseInt(modalElement?.getAttribute('data-default-rain') || '10', 10);
  const DEFAULT_LABEL = modalElement?.getAttribute('data-default-label') || 'یادش گرامی';
  const DEFAULT_EMOJI = modalElement?.getAttribute('data-default-emoji') || '🌸';

  interface FlowerPayload {
    amount: number;
    label?: string;
    emoji?: string;
    petalType?: number;
  }

  // ==========================================
  // ۱. راه‌اندازی Trystero و مدیریت حلقه استوری زنده
  // ==========================================
  let sendFlowerClick: ((payload: FlowerPayload) => void) | null = null;
  let room: any = null;
  let lastDisplayedCount = 1;

  const countEl = document.getElementById('live-user-count');
  const modalCountEl = document.getElementById('modal-live-user-count');
  const modalBadgeEl = document.getElementById('modal-live-badge');
  const storyWrapper = document.getElementById('avatar-story-wrapper');
  const storyCtaPill = document.getElementById('story-cta-pill');
  const tributesContainer = document.getElementById('floating-tributes-container');

  function spawnFloatingTribute(label?: string, emoji?: string) {
    if (!label || !tributesContainer) return;

    const pill = document.createElement('div');
    pill.className = 'floating-tribute-pill';

    const leftPercent = 28 + Math.random() * 44;
    const swayX = (Math.random() - 0.5) * 36;
    pill.style.left = `${leftPercent}%`;
    pill.style.setProperty('--sway-x', `${swayX}px`);

    const emojiSpan = document.createElement('span');
    emojiSpan.textContent = emoji || DEFAULT_EMOJI;
    emojiSpan.style.fontSize = '1.1rem';

    const textSpan = document.createElement('span');
    textSpan.textContent = label;

    pill.appendChild(emojiSpan);
    pill.appendChild(textSpan);
    tributesContainer.appendChild(pill);

    setTimeout(() => {
      pill.remove();
    }, 3600);
  }

  const tabId = Math.random().toString(36).substring(2, 10);
  const activeLocalTabs = new Map<string, number>();
  let bc: BroadcastChannel | null = null;

  if (typeof window !== 'undefined' && 'BroadcastChannel' in window) {
    bc = new BroadcastChannel('yadbod-shrine-live-sync');
    bc.onmessage = (ev) => {
      const msg = ev.data;
      if (!msg || msg.sender === tabId) return;

      if (msg.type === 'heartbeat') {
        activeLocalTabs.set(msg.sender, Date.now());
        updatePeerCount();
      } else if (msg.type === 'leave') {
        activeLocalTabs.delete(msg.sender);
        updatePeerCount();
      } else if (msg.type === 'flower-click') {
        if ((window as any).triggerFlowerRain) {
          (window as any).triggerFlowerRain(msg.amount || DEFAULT_RAIN_AMOUNT, msg.petalType);
        }
        if (msg.label) {
          spawnFloatingTribute(msg.label, msg.emoji);
        }
      }
    };

    window.addEventListener('beforeunload', () => {
      bc?.postMessage({ type: 'leave', sender: tabId });
    });
  }

  const updatePeerCount = () => {
    const now = Date.now();
    for (const [id, lastSeen] of activeLocalTabs.entries()) {
      if (now - lastSeen > 6000) activeLocalTabs.delete(id);
    }

    const trysteroPeers = room && typeof room.getPeers === 'function'
      ? Object.keys(room.getPeers()).length
      : 0;

    const totalOnline = Math.max(trysteroPeers, activeLocalTabs.size) + 1;
    const formatted = totalOnline.toLocaleString('fa-IR');

    if (countEl) countEl.textContent = formatted;
    if (modalCountEl) modalCountEl.textContent = formatted;

    if (storyWrapper) {
      const isMultiUser = totalOnline > 1;
      storyWrapper.setAttribute('data-story-active', isMultiUser ? 'true' : 'false');

      if (storyCtaPill) {
        if (isMultiUser) {
          storyCtaPill.classList.remove('hidden');
          storyCtaPill.classList.add('inline-flex');
        } else {
          storyCtaPill.classList.add('hidden');
          storyCtaPill.classList.remove('inline-flex');
        }
      }
    }

    if (totalOnline !== lastDisplayedCount && modalBadgeEl) {
      lastDisplayedCount = totalOnline;
      modalBadgeEl.classList.add('scale-105');
      setTimeout(() => modalBadgeEl.classList.remove('scale-105'), 300);
    }
  };

  try {
    room = joinRoom(
      {
        appId: 'yadbod-memorial-shrine-v1',
        relayConfig: {
          urls: [
            'wss://broker.emqx.io:8084/mqtt',
            'wss://test.mosquitto.org:8081/mqtt'
          ]
        }
      },
      'main-room'
    );

    room.onPeerJoin = () => updatePeerCount();
    room.onPeerLeave = () => updatePeerCount();
    updatePeerCount();

    const flowerAction = room.makeAction('flower-click');

    sendFlowerClick = (payload: FlowerPayload) => {
      flowerAction.send(payload);
      bc?.postMessage({
        type: 'flower-click',
        sender: tabId,
        amount: payload.amount,
        label: payload.label,
        emoji: payload.emoji,
        petalType: payload.petalType
      });
    };

    flowerAction.onMessage = (data: FlowerPayload) => {
      if (typeof window !== 'undefined' && (window as any).triggerFlowerRain) {
        (window as any).triggerFlowerRain(data.amount, data.petalType);
      }
      if (data && data.label) {
        spawnFloatingTribute(data.label, data.emoji);
      }
    };

  } catch (err) {
    console.error('Trystero initialization failed:', err);
  }

  setInterval(() => {
    bc?.postMessage({ type: 'heartbeat', sender: tabId });
    updatePeerCount();
  }, 2000);
  bc?.postMessage({ type: 'heartbeat', sender: tabId });

  // ==========================================
  // ۲. متغیرهای محیط سه‌بعدی
  // ==========================================
  let scene: THREE.Scene;
  let camera: THREE.PerspectiveCamera;
  let renderer: THREE.WebGLRenderer;
  let warmTopLight: THREE.PointLight;

  const MAX_PARTICLES = 800;
  let flowerParticles: THREE.Points;
  let particleVelocities: Float32Array;
  let particleTargetVy: Float32Array;
  let particleAngles: Float32Array;
  let particleRotSpeeds: Float32Array;
  let particlePhases: Float32Array;
  let globalClickMultiplier = 1;

  const FIREFLY_COUNT = 110;
  let firefliesPoints: THREE.Points;
  let fireflyBaseY: Float32Array;
  let fireflyPhases: Float32Array;

  let isThreeInitialized = false;
  let isRendering = false;
  let animationFrameId: number;
  let clock = new THREE.Clock();

  let isUserDragging = false;
  let previousMousePosition = { x: 0, y: 0 };
  let lon = 0;
  let lat = 0;
  let smoothLon = 0;
  let smoothLat = 0;
  let lastInteractionTime = 0;
  const phi = new THREE.Vector3();

  let cachedFlowerAtlas: THREE.CanvasTexture | null = null;
  let cachedGlowTex: THREE.CanvasTexture | null = null;

  // ==========================================
  // ۳. ساخت اطلس بافت ۴ گلبرگ طبیعی (۲×۲) و بافت نور
  // ==========================================
  function getFlowerAtlasTexture(): THREE.CanvasTexture {
    if (cachedFlowerAtlas) return cachedFlowerAtlas;

    const canvas = document.createElement('canvas');
    canvas.width = 256;
    canvas.height = 256;
    const ctx = canvas.getContext('2d')!;

    const drawPetal = (cx: number, cy: number, type: number) => {
      ctx.save();
      ctx.translate(cx, cy);

      if (type === 0) {
        const grad = ctx.createRadialGradient(0, -6, 4, 0, 0, 52);
        grad.addColorStop(0, '#ff4d6d');
        grad.addColorStop(0.6, '#e11d48');
        grad.addColorStop(0.92, '#881337');
        grad.addColorStop(1, 'rgba(136, 19, 55, 0)');
        ctx.fillStyle = grad;

        ctx.beginPath();
        ctx.moveTo(0, 46);
        ctx.bezierCurveTo(-48, 22, -46, -42, -8, -46);
        ctx.bezierCurveTo(0, -38, 0, -38, 8, -46);
        ctx.bezierCurveTo(46, -42, 48, 22, 0, 46);
        ctx.closePath();
        ctx.fill();

        ctx.strokeStyle = 'rgba(255, 204, 213, 0.35)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(0, 36);
        ctx.quadraticCurveTo(-10, 0, -15, -30);
        ctx.moveTo(0, 36);
        ctx.quadraticCurveTo(10, 0, 15, -30);
        ctx.stroke();

      } else if (type === 1) {
        const grad = ctx.createLinearGradient(0, -48, 0, 48);
        grad.addColorStop(0, '#ffe4e6');
        grad.addColorStop(0.5, '#fb7185');
        grad.addColorStop(0.92, '#f43f5e');
        grad.addColorStop(1, 'rgba(244, 63, 94, 0)');
        ctx.fillStyle = grad;

        ctx.beginPath();
        ctx.moveTo(0, 48);
        ctx.bezierCurveTo(-36, 18, -34, -36, 0, -48);
        ctx.bezierCurveTo(34, -36, 36, 18, 0, 48);
        ctx.closePath();
        ctx.fill();

      } else if (type === 2) {
        const grad = ctx.createRadialGradient(0, 14, 3, 0, 0, 48);
        grad.addColorStop(0, '#fef08a');
        grad.addColorStop(0.35, '#ffffff');
        grad.addColorStop(0.88, '#e2e8f0');
        grad.addColorStop(1, 'rgba(226, 232, 240, 0)');
        ctx.fillStyle = grad;

        ctx.beginPath();
        ctx.moveTo(0, 46);
        ctx.bezierCurveTo(-32, 24, -40, -24, 0, -48);
        ctx.bezierCurveTo(40, -24, 32, 24, 0, 46);
        ctx.closePath();
        ctx.fill();

      } else {
        const grad = ctx.createRadialGradient(0, 0, 4, 0, 0, 46);
        grad.addColorStop(0, '#fef9c3');
        grad.addColorStop(0.55, '#fbbf24');
        grad.addColorStop(0.92, '#d97706');
        grad.addColorStop(1, 'rgba(217, 119, 6, 0)');
        ctx.fillStyle = grad;

        ctx.beginPath();
        ctx.ellipse(0, 0, 28, 44, Math.PI / 8, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.restore();
    };

    drawPetal(64, 64, 0);
    drawPetal(192, 64, 1);
    drawPetal(64, 192, 2);
    drawPetal(192, 192, 3);

    cachedFlowerAtlas = new THREE.CanvasTexture(canvas);
    cachedFlowerAtlas.colorSpace = THREE.SRGBColorSpace;
    cachedFlowerAtlas.needsUpdate = true;
    return cachedFlowerAtlas;
  }

  function createGlowTexture(): THREE.CanvasTexture {
    if (cachedGlowTex) return cachedGlowTex;

    const canvas = document.createElement('canvas');
    canvas.width = 64;
    canvas.height = 64;
    const ctx = canvas.getContext('2d')!;

    const grad = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    grad.addColorStop(0, 'rgba(255, 251, 235, 1)');
    grad.addColorStop(0.35, 'rgba(252, 211, 77, 0.85)');
    grad.addColorStop(0.7, 'rgba(245, 158, 11, 0.25)');
    grad.addColorStop(1, 'rgba(245, 158, 11, 0)');

    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 64, 64);

    cachedGlowTex = new THREE.CanvasTexture(canvas);
    return cachedGlowTex;
  }

  // ==========================================
  // ۴. مقداردهی اولیه Three.js
  // ==========================================
  function initThreeJS() {
    if (isThreeInitialized) return;
    const container = document.getElementById('three-container');
    if (!container) return;

    scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x0c0a09, 0.0035);

    camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(0, 0, 0);

    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    container.appendChild(renderer.domElement);

    const ambientLight = new THREE.AmbientLight(0xfff1e6, 1.35);
    scene.add(ambientLight);

    const hemiLight = new THREE.HemisphereLight(0xfde68a, 0x1c1917, 0.85);
    hemiLight.position.set(0, 50, 0);
    scene.add(hemiLight);

    warmTopLight = new THREE.PointLight(0xffedd5, 3.2, 140, 1.2);
    warmTopLight.position.set(0, 38, 0);
    scene.add(warmTopLight);

    const glowSpriteMat = new THREE.SpriteMaterial({
      map: createGlowTexture(),
      color: 0xfde68a,
      transparent: true,
      opacity: 0.35,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const lightHalo = new THREE.Sprite(glowSpriteMat);
    lightHalo.position.set(0, 42, 0);
    lightHalo.scale.set(60, 60, 1);
    scene.add(lightHalo);

    initFlowerParticles();
    initFireflies();

    const geometry = new THREE.SphereGeometry(50, 64, 32);
    geometry.scale(-1, 1, 1);

    const textureLoader = new THREE.TextureLoader();

    textureLoader.load(PANORAMA_URL, (texture) => {
      texture.colorSpace = THREE.SRGBColorSpace;
      const material = new THREE.MeshStandardMaterial({
        map: texture,
        roughness: 0.85,
        metalness: 0.05,
      });
      const sphere = new THREE.Mesh(geometry, material);
      scene.add(sphere);
    });

    window.addEventListener('resize', onWindowResize, false);
    setupInteraction(container);
    isThreeInitialized = true;
  }

  // ==========================================
  // ۵. سیستم ذرات گل (THREE.Points با چرخش، پرسپکتیو و ۴ نوع گلبرگ)
  // ==========================================
  function initFlowerParticles() {
    const particleGeo = new THREE.BufferGeometry();
    const positions = new Float32Array(MAX_PARTICLES * 3);
    const scales = new Float32Array(MAX_PARTICLES);
    const types = new Float32Array(MAX_PARTICLES);
    particleAngles = new Float32Array(MAX_PARTICLES);
    particleVelocities = new Float32Array(MAX_PARTICLES);
    particleTargetVy = new Float32Array(MAX_PARTICLES);
    particleRotSpeeds = new Float32Array(MAX_PARTICLES);
    particlePhases = new Float32Array(MAX_PARTICLES);

    for (let i = 0; i < MAX_PARTICLES; i++) {
      positions[i * 3] = (Math.random() - 0.5) * 80;
      positions[i * 3 + 1] = -100;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 80;

      scales[i] = 2.8 + Math.random() * 2.2;
      types[i] = i % 4;
      particleAngles[i] = Math.random() * Math.PI * 2;
      particleVelocities[i] = 0;
      particleTargetVy[i] = 0;
      particleRotSpeeds[i] = (Math.random() - 0.5) * 3.0;
      particlePhases[i] = Math.random() * Math.PI * 2;
    }

    particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    particleGeo.setAttribute('aScale', new THREE.BufferAttribute(scales, 1));
    particleGeo.setAttribute('aType', new THREE.BufferAttribute(types, 1));
    particleGeo.setAttribute('aAngle', new THREE.BufferAttribute(particleAngles, 1));

    const particleMat = new THREE.ShaderMaterial({
      uniforms: {
        uTexture: { value: getFlowerAtlasTexture() },
        uPixelRatio: { value: Math.min(window.devicePixelRatio, 2) },
      },
      vertexShader: `
        attribute float aScale;
        attribute float aType;
        attribute float aAngle;
        varying float vType;
        varying float vAngle;
        varying float vAlpha;
        uniform float uPixelRatio;

        void main() {
          vType = aType;
          vAngle = aAngle;
          vAlpha = smoothstep(-32.0, -18.0, position.y);

          vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
          gl_Position = projectionMatrix * mvPosition;
          gl_PointSize = aScale * uPixelRatio * (130.0 / max(1.0, -mvPosition.z));
        }
      `,
      fragmentShader: `
        uniform sampler2D uTexture;
        varying float vType;
        varying float vAngle;
        varying float vAlpha;

        void main() {
          if (vAlpha <= 0.01) discard;

          vec2 centered = gl_PointCoord - vec2(0.5);
          float c = cos(vAngle);
          float s = sin(vAngle);
          vec2 rotated = vec2(
            centered.x * c - centered.y * s,
            centered.x * s + centered.y * c
          );

          rotated.x /= (0.65 + 0.35 * abs(cos(vAngle * 0.7)));

          vec2 uv = rotated + vec2(0.5);
          if (uv.x < 0.02 || uv.x > 0.98 || uv.y < 0.02 || uv.y > 0.98) discard;

          float col = mod(vType, 2.0);
          float row = floor(vType / 2.0);
          vec2 atlasUV = (uv * 0.5) + vec2(col * 0.5, row * 0.5);

          vec4 texColor = texture2D(uTexture, atlasUV);
          if (texColor.a < 0.05) discard;

          gl_FragColor = vec4(texColor.rgb, texColor.a * vAlpha * 0.95);
        }
      `,
      transparent: true,
      depthWrite: false,
      blending: THREE.NormalBlending,
    });

    flowerParticles = new THREE.Points(particleGeo, particleMat);
    flowerParticles.frustumCulled = false;
    scene.add(flowerParticles);
  }

  function initFireflies() {
    const geo = new THREE.BufferGeometry();
    const positions = new Float32Array(FIREFLY_COUNT * 3);
    fireflyBaseY = new Float32Array(FIREFLY_COUNT);
    fireflyPhases = new Float32Array(FIREFLY_COUNT);

    for (let i = 0; i < FIREFLY_COUNT; i++) {
      const radius = 10 + Math.random() * 35;
      const theta = Math.random() * Math.PI * 2;
      const y = (Math.random() - 0.35) * 48;

      positions[i * 3] = Math.cos(theta) * radius;
      positions[i * 3 + 1] = y;
      positions[i * 3 + 2] = Math.sin(theta) * radius;

      fireflyBaseY[i] = y;
      fireflyPhases[i] = Math.random() * Math.PI * 2;
    }

    geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    const mat = new THREE.PointsMaterial({
      size: 0.95,
      map: createGlowTexture(),
      color: 0xfde68a,
      transparent: true,
      opacity: 0.55,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      sizeAttenuation: true,
    });

    firefliesPoints = new THREE.Points(geo, mat);
    firefliesPoints.frustumCulled = false;
    scene.add(firefliesPoints);
  }

  (window as any).triggerFlowerRain = (amount: number, preferredPetalType?: number) => {
    if (!flowerParticles) return;

    const positions = flowerParticles.geometry.attributes.position.array as Float32Array;
    const types = flowerParticles.geometry.attributes.aType.array as Float32Array;
    globalClickMultiplier = Math.min(5, globalClickMultiplier + 0.08);

    const viewRad = THREE.MathUtils.degToRad(smoothLon);

    let spawned = 0;
    const totalToSpawn = Math.ceil(amount * globalClickMultiplier * 1.8);

    for (let i = 0; i < MAX_PARTICLES && spawned < totalToSpawn; i++) {
      if (particleVelocities[i] === 0) {
        const inFront = Math.random() < 0.72;
        const angle = inFront
          ? viewRad + (Math.random() - 0.5) * 1.5
          : Math.random() * Math.PI * 2;
        const radius = inFront
          ? 7 + Math.random() * 18
          : 10 + Math.random() * 28;

        positions[i * 3] = Math.cos(angle) * radius;
        positions[i * 3 + 1] = 14 + Math.random() * 18;
        positions[i * 3 + 2] = Math.sin(angle) * radius;

        if (typeof preferredPetalType === 'number' && preferredPetalType >= 0 && preferredPetalType <= 3) {
          types[i] = Math.random() < 0.8 ? preferredPetalType : Math.floor(Math.random() * 4);
        } else {
          types[i] = i % 4;
        }

        particleVelocities[i] = 0.15;
        particleTargetVy[i] = 1.2 + Math.random() * 1.8;
        particleAngles[i] = Math.random() * Math.PI * 2;

        spawned++;
      }
    }
    flowerParticles.geometry.attributes.position.needsUpdate = true;
    flowerParticles.geometry.attributes.aAngle.needsUpdate = true;
    flowerParticles.geometry.attributes.aType.needsUpdate = true;
  };

  // ==========================================
  // ۶. تعاملات (چرخش + کلیک روی مزار + کلیک روی بج‌های احساسی)
  // ==========================================
  function setupInteraction(container: HTMLElement) {
    let hasMoved = false;
    let clickedOnUI = false;

    const isUIElement = (target: EventTarget | null) => {
      return target instanceof HTMLElement && Boolean(target.closest('#shrine-badges-bar'));
    };

    container.addEventListener('mousedown', (e) => {
      if (isUIElement(e.target)) {
        clickedOnUI = true;
        return;
      }
      clickedOnUI = false;
      isUserDragging = true;
      hasMoved = false;
      lastInteractionTime = clock.getElapsedTime();
      previousMousePosition = { x: e.clientX, y: e.clientY };
    });

    container.addEventListener('mousemove', (e) => {
      if (!isUserDragging || clickedOnUI) return;

      const deltaX = e.clientX - previousMousePosition.x;
      const deltaY = e.clientY - previousMousePosition.y;

      if (Math.abs(deltaX) > 2 || Math.abs(deltaY) > 2) hasMoved = true;

      lon -= deltaX * 0.1;
      lat += deltaY * 0.1;
      lat = Math.max(-85, Math.min(85, lat));
      lastInteractionTime = clock.getElapsedTime();

      previousMousePosition = { x: e.clientX, y: e.clientY };
    });

    container.addEventListener('mouseup', () => {
      if (clickedOnUI) {
        clickedOnUI = false;
        return;
      }
      isUserDragging = false;
      lastInteractionTime = clock.getElapsedTime();
      if (!hasMoved) handleShrineClick();
    });

    container.addEventListener('touchstart', (e) => {
      if (isUIElement(e.target)) {
        clickedOnUI = true;
        return;
      }
      clickedOnUI = false;
      isUserDragging = true;
      hasMoved = false;
      lastInteractionTime = clock.getElapsedTime();
      previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }, { passive: true });

    container.addEventListener('touchmove', (e) => {
      if (!isUserDragging || clickedOnUI) return;

      const deltaX = e.touches[0].clientX - previousMousePosition.x;
      const deltaY = e.touches[0].clientY - previousMousePosition.y;

      if (Math.abs(deltaX) > 2 || Math.abs(deltaY) > 2) hasMoved = true;

      lon -= deltaX * 0.2;
      lat += deltaY * 0.2;
      lat = Math.max(-85, Math.min(85, lat));
      lastInteractionTime = clock.getElapsedTime();

      previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }, { passive: true });

    container.addEventListener('touchend', () => {
      if (clickedOnUI) {
        clickedOnUI = false;
        return;
      }
      isUserDragging = false;
      lastInteractionTime = clock.getElapsedTime();
      if (!hasMoved) handleShrineClick();
    });

    const badgeButtons = document.querySelectorAll<HTMLButtonElement>('[data-shrine-badge]');
    badgeButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const label = btn.getAttribute('data-label') || DEFAULT_LABEL;
        const emoji = btn.getAttribute('data-emoji') || DEFAULT_EMOJI;
        const petalType = parseInt(btn.getAttribute('data-petal-type') || '-1', 10);
        const amount = parseInt(btn.getAttribute('data-amount') || String(DEFAULT_RAIN_AMOUNT), 10);

        handleShrineClick({ amount, label, emoji, petalType });
      });
    });
  }

  // ==========================================
  // ۷. منطق کلیک و ارسال همگانی
  // ==========================================
  function handleShrineClick(customPayload?: FlowerPayload) {
    if (typeof navigator !== 'undefined' && navigator.vibrate) {
      navigator.vibrate([50, 30, 50]);
    }

    const payload: FlowerPayload = customPayload || { amount: DEFAULT_RAIN_AMOUNT };

    (window as any).triggerFlowerRain(payload.amount, payload.petalType);

    if (payload.label) {
      spawnFloatingTribute(payload.label, payload.emoji);
    }

    if (sendFlowerClick) {
      sendFlowerClick(payload);
    }
  }

  // ==========================================
  // ۸. انیمیشن و فیزیک سینمایی
  // ==========================================
  function animate() {
    if (!isRendering) return;
    animationFrameId = requestAnimationFrame(animate);

    const delta = Math.min(clock.getDelta(), 0.1);
    const elapsed = clock.getElapsedTime();

    if (!isUserDragging) {
      const idleTime = elapsed - lastInteractionTime;
      const driftFactor = Math.min(1, idleTime * 0.4);
      lon += Math.sin(elapsed * 0.35) * 0.035 * driftFactor;
      lat += Math.cos(elapsed * 0.25) * 0.015 * driftFactor;
    }

    lat = Math.max(-85, Math.min(85, lat));

    smoothLon += (lon - smoothLon) * Math.min(1, delta * 10);
    smoothLat += (lat - smoothLat) * Math.min(1, delta * 10);

    phi.set(
      THREE.MathUtils.degToRad(90 - smoothLat),
      THREE.MathUtils.degToRad(smoothLon),
      0
    );

    camera.lookAt(
      Math.sin(phi.x) * Math.cos(phi.y),
      Math.cos(phi.x),
      Math.sin(phi.x) * Math.sin(phi.y)
    );

    if (warmTopLight) {
      warmTopLight.intensity = 3.1 + Math.sin(elapsed * 1.4) * 0.35;
    }

    if (flowerParticles) {
      const positions = flowerParticles.geometry.attributes.position.array as Float32Array;
      let needsUpdate = false;

      for (let i = 0; i < MAX_PARTICLES; i++) {
        if (particleVelocities[i] > 0) {
          needsUpdate = true;
          const phase = particlePhases[i];

          particleVelocities[i] += (particleTargetVy[i] - particleVelocities[i]) * delta * 1.2;

          const flutterLift = 1.0 - 0.25 * Math.abs(Math.sin(elapsed * 1.5 + phase));
          positions[i * 3 + 1] -= particleVelocities[i] * flutterLift * delta * 6.5;

          positions[i * 3] += (Math.sin(elapsed * 1.3 + phase) * 2.2 + Math.cos(elapsed * 0.5 + i) * 0.8) * delta;
          positions[i * 3 + 2] += (Math.cos(elapsed * 1.1 + phase) * 2.2 + Math.sin(elapsed * 0.4 + i) * 0.8) * delta;

          particleAngles[i] += particleRotSpeeds[i] * delta + Math.sin(elapsed + phase) * 0.4 * delta;

          if (positions[i * 3 + 1] < -32) {
            positions[i * 3 + 1] = -100;
            particleVelocities[i] = 0;
          }
        }
      }

      if (needsUpdate) {
        flowerParticles.geometry.attributes.position.needsUpdate = true;
        flowerParticles.geometry.attributes.aAngle.needsUpdate = true;
      }
    }

    if (firefliesPoints) {
      const ffPos = firefliesPoints.geometry.attributes.position.array as Float32Array;
      for (let i = 0; i < FIREFLY_COUNT; i++) {
        const phase = fireflyPhases[i];
        ffPos[i * 3] += Math.sin(elapsed * 0.3 + phase) * 0.012;
        ffPos[i * 3 + 1] = fireflyBaseY[i] + Math.sin(elapsed * 0.6 + phase) * 1.5;
        ffPos[i * 3 + 2] += Math.cos(elapsed * 0.25 + phase) * 0.012;
      }
      firefliesPoints.geometry.attributes.position.needsUpdate = true;

      const ffMat = firefliesPoints.material as THREE.PointsMaterial;
      ffMat.opacity = 0.45 + Math.sin(elapsed * 1.8) * 0.2;
    }

    renderer.render(scene, camera);
  }

  // ==========================================
  // ۹. مدیریت مدال و پیش‌بارگذاری بدون لگ
  // ==========================================
  const triggerBtn = document.getElementById('trigger-shrine-modal');
  const triggerBadge = document.getElementById('trigger-shrine-badge');
  const modal = document.getElementById('shrine-modal');
  const closeBtn = document.getElementById('close-shrine-modal');

  let isModalOpen = false;

  if (typeof window !== 'undefined') {
    const prewarm = () => {
      getFlowerAtlasTexture();
      createGlowTexture();
    };
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(prewarm);
    } else {
      setTimeout(prewarm, 1000);
    }
  }

  const openModal = () => {
    if (!modal) return;

    modal.classList.remove('hidden');
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
    });
    isModalOpen = true;
    document.body.style.overflow = 'hidden';

    setTimeout(() => {
      if (!isThreeInitialized) {
        initThreeJS();
      }
      isRendering = true;
      clock.start();
      animate();
    }, 30);
  };

  const closeModal = () => {
    if (!modal) return;

    modal.classList.add('opacity-0');
    setTimeout(() => modal.classList.add('hidden'), 500);
    isModalOpen = false;
    document.body.style.overflow = '';

    isRendering = false;
    cancelAnimationFrame(animationFrameId);
  };

  triggerBtn?.addEventListener('click', openModal);
  triggerBadge?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isModalOpen) closeModal();
  });

  function onWindowResize() {
    if (!camera || !renderer) return;
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  }
</script>