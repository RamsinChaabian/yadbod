---
import { withBase } from '../../utils/paths';

interface Props {
  profileImage: string;
  imageAlt: string;
}

const { profileImage, imageAlt } = Astro.props;
---

<!-- عکس پروفایل و شمارنده زنده -->
<div class="pointer-events-auto" data-anim-avatar>
  <div class="relative">
    <!-- هاله‌ی نورانی -->
    <div class="absolute inset-0 rounded-full bg-white/40 backdrop-blur-lg scale-110 opacity-80"></div>
    
    <!-- آواتار (قابل کلیک) -->
    <div 
      id="trigger-shrine-modal"
      class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-full overflow-hidden ring-4 ring-white shadow-glass-lg bg-white/40 backdrop-blur-md cursor-pointer group transition-transform duration-300 hover:scale-105"
      title="برای مشاهده محراب کلیک کنید"
    >
      <img
        src={withBase(profileImage)}
        alt={imageAlt}
        class="w-full h-full object-cover transition-opacity group-hover:opacity-90"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="400"
        height="400"
      />
      <!-- افکت درخشش روی عکس -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center pb-2">
        <span class="text-[10px] text-white font-bold drop-shadow-md">مشاهده محراب</span>
      </div>
    </div>

    <!-- نشانگر آنلاین زنده (روی عکس پروفایل) -->
    <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 bg-stone-900/90 border border-amber-500/40 text-amber-300 text-[11px] sm:text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1.5 backdrop-blur-md shadow-lg whitespace-nowrap transition-all duration-300">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span id="live-user-count">۱</span> نفر آنلاین
    </div>
  </div>
</div>

<!-- مدال محراب -->
<div id="shrine-modal" class="fixed inset-0 z-[99999] hidden opacity-0 transition-opacity duration-500 bg-black">
  <!-- دکمه بستن -->
  <button id="close-shrine-modal" class="absolute top-6 right-6 z-[100000] w-12 h-12 bg-white/10 hover:bg-white/20 backdrop-blur-md rounded-full text-white flex items-center justify-center transition-all cursor-pointer">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>

  <!-- کانتینر Three.js -->
  <div id="three-container" class="w-full h-full relative cursor-grab active:cursor-grabbing">
    <!-- راهنما -->
    <div class="absolute bottom-10 left-0 right-0 text-center text-white/70 text-sm animate-pulse pointer-events-none z-10 transition-opacity duration-300" id="shrine-hint">
      برای گل‌باران، روی سنگ قبر کلیک کنید 🌸
    </div>
  </div>
</div>

<script>
  import { joinRoom } from '@trystero-p2p/mqtt';
  import * as THREE from 'three';

  const modalElement = document.getElementById('shrine-modal');
  if (modalElement && modalElement.parentElement !== document.body) {
    document.body.appendChild(modalElement);
  }

  // ==========================================
  // ۱. راه‌اندازی Trystero
  // ==========================================
  let sendFlowerClick: any = null;
  let room: any = null;

  try {
    room = joinRoom(
      {
        appId: 'yadbod-memorial-shrine-v1',
        relayConfig: {
          urls: [
            'wss://broker.emqx.io:8084/mqtt',
            'wss://broker.hivemq.com:8884/mqtt',
            'wss://test.mosquitto.org:8081/mqtt'
          ]
        }
      },
      'main-room'
    );

    const countEl = document.getElementById('live-user-count');
    const updatePeerCount = () => {
      const peers = Object.keys(room.getPeers()).length;
      if (countEl) countEl.textContent = (peers + 1).toLocaleString('fa-IR');
    };

    room.onPeerJoin = () => updatePeerCount();
    room.onPeerLeave = () => updatePeerCount();
    updatePeerCount();

    // ✅ API جدید Trystero: makeAction یک شیء برمی‌گرداند
    const flowerAction = room.makeAction('flower-click');

    // ارسال سیگنال کلیک به بقیه کاربران
    sendFlowerClick = (payload: { amount: number }) => {
      flowerAction.send(payload);
    };

    // دریافت سیگنال کلیک از بقیه کاربران
    flowerAction.onMessage = (data: { amount: number }) => {
      if (typeof window !== 'undefined' && (window as any).triggerFlowerRain) {
        (window as any).triggerFlowerRain(data.amount);
      }
    };

  } catch (err) {
    console.error('Trystero initialization failed:', err);
  }

  // ==========================================
  // ۲. متغیرهای محیط سه‌بعدی
  // ==========================================
  let scene: THREE.Scene;
  let camera: THREE.PerspectiveCamera;
  let renderer: THREE.WebGLRenderer;
  let flowerParticles: THREE.Points;
  let particleVelocities: Float32Array;
  let isThreeInitialized = false;
  let isRendering = false;
  let animationFrameId: number;
  let clock = new THREE.Clock();

  const MAX_PARTICLES = 800;
  let globalClickMultiplier = 1;

  let isUserDragging = false;
  let previousMousePosition = { x: 0, y: 0 };
  let lon = 0;
  let lat = 0;
  const phi = new THREE.Vector3();

  // ==========================================
  // ۳. بافت گل
  // ==========================================
  function getFlowerTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 64;
    canvas.height = 64;
    const ctx = canvas.getContext('2d')!;

    ctx.beginPath();
    ctx.ellipse(32, 32, 20, 32, Math.PI / 4, 0, Math.PI * 2);
    ctx.fillStyle = '#f43f5e';
    ctx.fill();

    ctx.shadowColor = 'rgba(255,255,255,0.5)';
    ctx.shadowBlur = 5;
    ctx.fill();

    return new THREE.CanvasTexture(canvas);
  }

  // ==========================================
  // ۴. مقداردهی اولیه Three.js
  // ==========================================
  function initThreeJS() {
    const container = document.getElementById('three-container');
    if (!container) return;

    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(0, 0, 0);

    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const geometry = new THREE.SphereGeometry(50, 64, 32);
    geometry.scale(-1, 1, 1);

    const textureLoader = new THREE.TextureLoader();
    const imageUrl = 'https://threejs.org/examples/textures/2294472375_24a3b8ef46_o.jpg';

    textureLoader.load(imageUrl, (texture) => {
      texture.colorSpace = THREE.SRGBColorSpace;
      const material = new THREE.MeshBasicMaterial({ map: texture });
      const sphere = new THREE.Mesh(geometry, material);
      scene.add(sphere);

      initFlowerParticles();
      isRendering = true;
      clock.start();
      animate();
    });

    window.addEventListener('resize', onWindowResize, false);
    setupInteraction(container);
    isThreeInitialized = true;
  }

  // ==========================================
  // ۵. سیستم ذرات گل
  // ==========================================
  function initFlowerParticles() {
    const particleGeo = new THREE.BufferGeometry();
    const positions = new Float32Array(MAX_PARTICLES * 3);
    particleVelocities = new Float32Array(MAX_PARTICLES);

    for (let i = 0; i < MAX_PARTICLES; i++) {
      positions[i * 3] = (Math.random() - 0.5) * 100;
      positions[i * 3 + 1] = -100;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 100;
      particleVelocities[i] = 0;
    }

    particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    const particleMat = new THREE.PointsMaterial({
      size: 2.5,
      map: getFlowerTexture(),
      transparent: true,
      opacity: 0.9,
      depthWrite: false,
      blending: THREE.NormalBlending,
    });

    flowerParticles = new THREE.Points(particleGeo, particleMat);
    scene.add(flowerParticles);
  }

  (window as any).triggerFlowerRain = (amount: number) => {
    if (!flowerParticles) return;

    const positions = flowerParticles.geometry.attributes.position.array as Float32Array;
    globalClickMultiplier = Math.min(5, globalClickMultiplier + 0.05);

    let spawned = 0;
    for (let i = 0; i < MAX_PARTICLES && spawned < amount * globalClickMultiplier; i++) {
      if (particleVelocities[i] === 0) {
        positions[i * 3] = (Math.random() - 0.5) * 90;
        positions[i * 3 + 1] = 35 + Math.random() * 10;
        positions[i * 3 + 2] = (Math.random() - 0.5) * 90;
        particleVelocities[i] = 1.5 + Math.random() * 2.5;
        spawned++;
      }
    }
    flowerParticles.geometry.attributes.position.needsUpdate = true;
  };

  // ==========================================
  // ۶. تعاملات (چرخش + کلیک)
  // ==========================================
  function setupInteraction(container: HTMLElement) {
    let hasMoved = false;

    container.addEventListener('mousedown', (e) => {
      isUserDragging = true;
      hasMoved = false;
      previousMousePosition = { x: e.clientX, y: e.clientY };
    });

    container.addEventListener('mousemove', (e) => {
      if (!isUserDragging) return;

      const deltaX = e.clientX - previousMousePosition.x;
      const deltaY = e.clientY - previousMousePosition.y;

      if (Math.abs(deltaX) > 2 || Math.abs(deltaY) > 2) hasMoved = true;

      lon -= deltaX * 0.1;
      lat += deltaY * 0.1;
      lat = Math.max(-85, Math.min(85, lat));

      previousMousePosition = { x: e.clientX, y: e.clientY };
    });

    container.addEventListener('mouseup', () => {
      isUserDragging = false;
      if (!hasMoved) handleShrineClick();
    });

    container.addEventListener('touchstart', (e) => {
      isUserDragging = true;
      hasMoved = false;
      previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }, { passive: true });

    container.addEventListener('touchmove', (e) => {
      if (!isUserDragging) return;

      const deltaX = e.touches[0].clientX - previousMousePosition.x;
      const deltaY = e.touches[0].clientY - previousMousePosition.y;

      if (Math.abs(deltaX) > 2 || Math.abs(deltaY) > 2) hasMoved = true;

      lon -= deltaX * 0.2;
      lat += deltaY * 0.2;
      lat = Math.max(-85, Math.min(85, lat));

      previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }, { passive: true });

    container.addEventListener('touchend', () => {
      isUserDragging = false;
      if (!hasMoved) handleShrineClick();
    });
  }

  // ==========================================
  // ۷. منطق کلیک
  // ==========================================
  function handleShrineClick() {
    if (typeof navigator !== 'undefined' && navigator.vibrate) {
      navigator.vibrate([60, 40, 60]);
    }

    // بارش محلی
    (window as any).triggerFlowerRain(10);

    // ارسال به بقیه کاربران
    if (sendFlowerClick) {
      sendFlowerClick({ amount: 10 });
    }
  }

  // ==========================================
  // ۸. انیمیشن
  // ==========================================
  function animate() {
    if (!isRendering) return;
    animationFrameId = requestAnimationFrame(animate);

    const delta = clock.getDelta();
    const elapsed = clock.getElapsedTime();

    lat = Math.max(-85, Math.min(85, lat));
    phi.set(THREE.MathUtils.degToRad(90 - lat), THREE.MathUtils.degToRad(lon), 0);

    camera.lookAt(
      Math.sin(phi.x) * Math.cos(phi.y),
      Math.cos(phi.x),
      Math.sin(phi.x) * Math.sin(phi.y)
    );

    if (flowerParticles) {
      const positions = flowerParticles.geometry.attributes.position.array as Float32Array;
      let needsUpdate = false;

      for (let i = 0; i < MAX_PARTICLES; i++) {
        if (particleVelocities[i] > 0) {
          needsUpdate = true;

          positions[i * 3 + 1] -= particleVelocities[i] * delta * 15;
          positions[i * 3] += Math.sin(elapsed + i) * 0.05;
          positions[i * 3 + 2] += Math.cos(elapsed + i * 2) * 0.05;

          if (positions[i * 3 + 1] < -30) {
            positions[i * 3 + 1] = -100;
            particleVelocities[i] = 0;
          }
        }
      }

      if (needsUpdate) {
        flowerParticles.geometry.attributes.position.needsUpdate = true;
      }
    }

    renderer.render(scene, camera);
  }

  // ==========================================
  // ۹. مدیریت مدال
  // ==========================================
  const triggerBtn = document.getElementById('trigger-shrine-modal');
  const modal = document.getElementById('shrine-modal');
  const closeBtn = document.getElementById('close-shrine-modal');

  let isModalOpen = false;

  const openModal = () => {
    if (!modal) return;

    modal.classList.remove('hidden');
    setTimeout(() => modal.classList.remove('opacity-0'), 10);
    isModalOpen = true;
    document.body.style.overflow = 'hidden';

    if (!isThreeInitialized) {
      initThreeJS();
    } else {
      isRendering = true;
      clock.start();
      animate();
    }
  };

  const closeModal = () => {
    if (!modal) return;

    modal.classList.add('opacity-0');
    setTimeout(() => modal.classList.add('hidden'), 500);
    isModalOpen = false;
    document.body.style.overflow = '';

    isRendering = false;
    cancelAnimationFrame(animationFrameId);
  };

  triggerBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isModalOpen) closeModal();
  });

  function onWindowResize() {
    if (!camera || !renderer) return;
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  }
</script>