---
// نشانگر وضعیت آنلاین/آفلاین + اطلاع‌رسانی به‌روزرسانی
---

<!-- نوار آفلاین — شیشه‌ی تیره -->
<div
  data-pwa-offline
  hidden
  class="fixed top-3 inset-x-3 z-[300] mx-auto max-w-md lg-dark p-0 overflow-hidden transition-all duration-400"
  style="transform: translateY(-150%); border-radius: 32px;"
>
  <div class="px-5 py-3 flex items-center justify-center gap-2.5">
    <span class="relative flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
    </span>
    <p class="text-amber-100 text-xs font-medium">
      شما آفلاین هستید — محتوای ذخیره‌شده در دسترس است
    </p>
  </div>
</div>

<!-- Toast به‌روزرسانی — شیشه‌ی تیره -->
<div
  data-pwa-update
  hidden
  class="fixed bottom-28 inset-x-4 z-[300] max-w-md mx-auto lg-dark overflow-hidden"
  style="animation: slide-up 0.4s ease-out; border-radius: 32px;"
>
  <div class="p-4 flex items-center gap-3">
    <div class="w-11 h-11 rounded-[18px] bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center shrink-0 shadow-lg">
      <span class="text-xl">✨</span>
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-amber-100 text-sm font-bold">نسخه جدید آماده است</p>
      <p class="text-stone-400 text-xs mt-0.5">برای مشاهده آخرین تغییرات، رفرش کنید</p>
    </div>
    <button
      type="button"
      data-pwa-update-btn
      class="shrink-0 rounded-[18px] bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold px-4 py-2.5 text-xs hover:from-amber-600 hover:to-orange-600 transition-all active:scale-95 shadow-lg"
    >
      به‌روزرسانی
    </button>
  </div>
</div>

<style is:global>
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<script>
  function initOnlineStatus() {
    const offlineBar = document.querySelector<HTMLElement>('[data-pwa-offline]');
    if (!offlineBar) return;

    const bar: HTMLElement = offlineBar;

    function updateStatus() {
      if (navigator.onLine) {
        bar.style.transform = 'translateY(-150%)';
        setTimeout(() => { bar.hidden = true; }, 400);
      } else {
        bar.hidden = false;
        requestAnimationFrame(() => {
          bar.style.transform = 'translateY(0)';
        });
      }
    }

    window.addEventListener('online', updateStatus);
    window.addEventListener('offline', updateStatus);
    updateStatus();
  }

  function initUpdateNotify() {
    const updateToast = document.querySelector<HTMLElement>('[data-pwa-update]');
    const updateBtn = document.querySelector<HTMLButtonElement>('[data-pwa-update-btn]');

    if (!updateToast || !updateBtn) return;

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.ready.then((registration) => {
        setInterval(() => {
          registration.update().catch(() => {});
        }, 30 * 60 * 1000);

        registration.addEventListener('updatefound', () => {
          const newWorker = registration.installing;
          if (!newWorker) return;

          newWorker.addEventListener('statechange', () => {
            if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
              updateToast.hidden = false;
            }
          });
        });
      });

      updateBtn.addEventListener('click', () => {
        navigator.serviceWorker.ready.then((registration) => {
          if (registration.waiting) {
            registration.waiting.postMessage({ type: 'SKIP_WAITING' });
          }
          window.location.reload();
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initOnlineStatus();
      initUpdateNotify();
    });
  } else {
    initOnlineStatus();
    initUpdateNotify();
  }
</script>