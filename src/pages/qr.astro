---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../utils/config';

const siteUrl = `${config.site.baseUrl}/`;
const cemeteryName = config.location.cemeteryName;
const personName = config.person.fullName;
---

<BaseLayout title="QR کد سایت" description="QR کد برای چاپ روی سنگ قبر" noindex>
  <div class="min-h-dvh flex flex-col items-center justify-center px-4 sm:px-6 py-12">
    <!-- کارت شیشه‌ای اصلی -->
    <div class="lg-card max-w-md w-full p-6 sm:p-8 text-center space-y-6">
      <!-- سربرگ -->
      <div>
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-amber-100 to-orange-100 text-3xl mb-4 shadow-glass">
          🔳
        </div>
        <h1 class="text-2xl font-bold text-stone-800 mb-2">QR کد سایت یادبود</h1>
        <p class="text-sm text-stone-500 leading-relaxed">
          این QR کد را روی سنگ قبر چاپ کنید تا بازدیدکنندگان به سایت یادبود دسترسی داشته باشند.
        </p>
      </div>

      <!-- QR Code Container -->
      <div class="lg-thin rounded-[28px] p-6 inline-block">
        <div class="bg-white/90 backdrop-blur-md rounded-[20px] p-4 shadow-glass">
          <canvas id="qr-canvas" class="w-full max-w-[260px] mx-auto block rounded-[12px]"></canvas>
          <p class="mt-3 text-xs text-stone-600 text-center font-medium">
            {personName} — {cemeteryName}
          </p>
        </div>
      </div>

      <!-- URL -->
      <p class="text-xs text-stone-400 break-all" dir="ltr">{siteUrl}</p>

      <!-- Buttons -->
      <div class="flex flex-wrap gap-2 justify-center">
        <button
          type="button"
          id="download-png"
          class="lg-button-primary touch-target inline-flex items-center gap-2 px-5 py-3 font-bold text-sm"
        >
          <span aria-hidden="true">⬇️</span>
          <span>دانلود PNG</span>
        </button>
        <button
          type="button"
          id="download-svg"
          class="lg-button touch-target inline-flex items-center gap-2 px-5 py-3 font-semibold text-sm text-amber-700"
        >
          <span aria-hidden="true">⬇️</span>
          <span>دانلود SVG</span>
        </button>
        <button
          type="button"
          id="print-qr"
          class="lg-button touch-target inline-flex items-center gap-2 px-5 py-3 font-semibold text-sm text-amber-700"
        >
          <span aria-hidden="true">🖨️</span>
          <span>چاپ</span>
        </button>
      </div>

      <!-- نکته -->
      <div class="lg-thin rounded-[20px] p-4 text-start">
        <p class="text-xs text-stone-600 leading-relaxed">
          <strong class="text-stone-700">پیشنهاد:</strong> QR کد را با کیفیت بالا چاپ کنید (حداقل ۵×۵ سانتی‌متر)
          و در محلی قرار دهید که رطوبت و نور مستقیم خورشید به آن نرسد.
        </p>
      </div>
    </div>
  </div>

  <script>
    const SITE_URL = document.querySelector('[dir="ltr"]')?.textContent?.trim() ?? '';

    async function initQR() {
      const canvas = document.querySelector<HTMLCanvasElement>('#qr-canvas');
      if (!canvas || !SITE_URL) return;

      try {
        const { generate } = await import('lean-qr');
        const qr = generate(SITE_URL);

        const size = 280;
        const scale = Math.max(1, Math.floor(size / qr.size));
        const realSize = qr.size * scale;
        canvas.width = realSize;
        canvas.height = realSize;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, realSize, realSize);

        ctx.fillStyle = '#0B0B0C';
        for (let y = 0; y < qr.size; y++) {
          for (let x = 0; x < qr.size; x++) {
            if (qr.get(x, y)) {
              ctx.fillRect(x * scale, y * scale, scale, scale);
            }
          }
        }

        console.log('[yadbod-qr] QR generated:', SITE_URL);
      } catch (err) {
        console.error('[yadbod-qr] failed:', err);
      }
    }

    // ---------- Download PNG ----------
    document.querySelector('#download-png')?.addEventListener('click', () => {
      const canvas = document.querySelector<HTMLCanvasElement>('#qr-canvas');
      if (!canvas) return;
      const link = document.createElement('a');
      link.download = 'yadbod-qr.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    });

    // ---------- Download SVG ----------
    document.querySelector('#download-svg')?.addEventListener('click', async () => {
      const canvas = document.querySelector<HTMLCanvasElement>('#qr-canvas');
      if (!canvas) return;
      const { generate } = await import('lean-qr');
      const qr = generate(SITE_URL);

      let svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${qr.size} ${qr.size}">`;
      svg += `<rect width="${qr.size}" height="${qr.size}" fill="#FFFFFF"/>`;
      for (let y = 0; y < qr.size; y++) {
        for (let x = 0; x < qr.size; x++) {
          if (qr.get(x, y)) {
            svg += `<rect x="${x}" y="${y}" width="1" height="1" fill="#0B0B0C"/>`;
          }
        }
      }
      svg += '</svg>';

      const blob = new Blob([svg], { type: 'image/svg+xml' });
      const link = document.createElement('a');
      link.download = 'yadbod-qr.svg';
      link.href = URL.createObjectURL(blob);
      link.click();
      URL.revokeObjectURL(link.href);
    });

    // ---------- Print ----------
    document.querySelector('#print-qr')?.addEventListener('click', () => {
      window.print();
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initQR);
    } else {
      initQR();
    }
  </script>

  <style is:global>
    @media print {
      /* در چاپ: فقط QR را نشان بده */
      body {
        background: white !important;
      }
      nav[data-tabbar],
      footer,
      .lg-card > *:not(.lg-thin),
      [data-pwa-offline],
      [data-pwa-update] {
        display: none !important;
      }
      .lg-card,
      .lg-thin {
        background: white !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        box-shadow: none !important;
        border: none !important;
        padding: 0 !important;
      }
      #qr-canvas {
        max-width: 100% !important;
      }
      h1, h2, h3 {
        color: #0B0B0C !important;
      }
      p {
        color: #333 !important;
      }
    }
  </style>
</BaseLayout>