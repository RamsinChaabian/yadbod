---
// صفحه تست AR با locar مستقل
---

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>AR Standalone Test</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; overflow: hidden; background: #000; font-family: 'Vazirmatn', sans-serif; }
    #ar-container { position: fixed; inset: 0; }
    #ar-container canvas { display: block; width: 100% !important; height: 100% !important; }

    .start-screen {
      position: fixed; inset: 0; z-index: 10;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      background: #000; color: #fff; padding: 20px; text-align: center;
    }
    .start-screen.hidden { display: none; }
    .btn {
      background: #E8833A; color: #fff; border: none;
      padding: 16px 40px; border-radius: 50px;
      font-size: 16px; font-weight: bold; cursor: pointer;
      margin-top: 20px; font-family: inherit;
    }
    .btn:active { transform: scale(0.97); }

    .debug {
      position: fixed; top: 10px; left: 10px; z-index: 100;
      color: #0f0; font-size: 11px; background: rgba(0,0,0,0.7);
      padding: 6px 8px; border-radius: 4px; font-family: monospace;
      max-width: 220px; line-height: 1.4; direction: ltr; text-align: left;
    }
  </style>
</head>
<body>
  <div class="debug" id="debug">Ready</div>

  <div id="ar-container"></div>

  <div class="start-screen" id="start-screen">
    <div style="font-size: 60px;">📍</div>
    <h1 style="margin: 10px 0;">تست AR</h1>
    <p style="opacity: 0.7; max-width: 300px;">برای شروع، دکمه زیر را بزنید و به دوربین و موقعیت اجازه بدهید.</p>
    <button class="btn" id="start-btn">شروع</button>
  </div>

  <script>
    const debugEl = document.getElementById('debug');
    const log = (msg: string) => {
      console.log('[AR]', msg);
      debugEl.innerHTML += '<br>' + msg;
    };

    document.getElementById('start-btn')!.addEventListener('click', async () => {
      log('Start clicked');
      document.getElementById('start-screen')!.classList.add('hidden');

      try {
  log('Importing three...');
  const THREE = await import('three');
  log('three loaded: ' + (THREE as any).REVISION);

  log('Importing locar...');
  const LocAR = await import('locar');
  log('locar loaded');

  log('Creating LocAR.App...');
  const app = new (LocAR as any).App({
    cameraOptions: { hFov: 80 },
  });

  log('Starting AR (camera + orientation)...');
  const locar = await app.start();
  log('✓ AR started!');

  // ⚠️ راه‌اندازی GPS — بدون این، موقعیت اولیه تعیین نمی‌شود
  log('Starting GPS watch...');
  await locar.startGps();
  log('✓ GPS watch started');

  // منتظر اولین موقعیت معتبر بمان (با timeout 20s)
  log('Waiting for initial GPS fix...');
  await new Promise<void>((resolve) => {
    let done = false;

    const onGps = (e: any) => {
      if (done) return;
      done = true;
      const c = e.position.coords;
      log('✓ GPS fix: ' + c.latitude.toFixed(6) + ', ' + c.longitude.toFixed(6));
      log('  accuracy: ' + Math.round(c.accuracy) + 'm');
      locar.off('gpsupdate', onGps);
      resolve();
    };

    const onError = (e: any) => {
      if (done) return;
      log('GPS error: ' + (e.message || JSON.stringify(e)));
      // به تلاش ادامه بده — شاید بعداً fix بشه
    };

    locar.on('gpsupdate', onGps);
    locar.on('gpserror', onError);

    // timeout بعد از ۲۰ ثانیه
    setTimeout(() => {
      if (!done) {
        done = true;
        log('⚠ GPS timeout — continuing without fix');
        resolve();
      }
    }, 20000);
  });

  // ---------- حالا نشانگر را بساز و اضافه کن ----------
  log('Building marker...');
  const group = new THREE.Group();

  const ring = new THREE.Mesh(
    new THREE.RingGeometry(0.8, 1.2, 32),
    new THREE.MeshBasicMaterial({
      color: 0xE8833A,
      side: THREE.DoubleSide,
      transparent: true,
      opacity: 0.9,
    })
  );
  ring.rotation.x = -Math.PI / 2;
  ring.position.y = 0.05;
  group.add(ring);

  const cyl = new THREE.Mesh(
    new THREE.CylinderGeometry(0.15, 0.15, 3, 16),
    new THREE.MeshBasicMaterial({
      color: 0xF5A623,
      transparent: true,
      opacity: 0.6,
    })
  );
  cyl.position.y = 1.5;
  group.add(cyl);

  // اضافه کردن به موقعیت قبر: (object, lng, lat, elevation)
  try {
    locar.add(group, 48.8765405, 32.0498053, 0);
    log('✓ Marker added at grave coordinates');
  } catch (e: any) {
    log('❌ Marker add failed: ' + e.message);
  }

  // بررسی نهایی
  setTimeout(() => {
    const videos = document.querySelectorAll('video');
    log('Videos: ' + videos.length);
    if (videos.length > 0) {
      const v = videos[0] as HTMLVideoElement;
      log('Video dims: ' + v.videoWidth + 'x' + v.videoHeight);
      log('Video visible: ' + (v.offsetWidth > 0 && v.offsetHeight > 0));
    }
    log('Canvases: ' + document.querySelectorAll('canvas').length);
  }, 2000);
} catch (err: any) {
  const msg = err?.message || String(err);
  log('❌ ERROR: ' + msg);
  console.error('[AR] Full error:', err);
}
    });
  </script>
</body>
</html>