---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="آفلاین">
  <div class="min-h-dvh flex items-center justify-center px-4 sm:px-6">
    <div class="lg-card max-w-md w-full p-8 sm:p-10 text-center">
      <!-- آیکون در یک دایره شیشه‌ای -->
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-gradient-to-br from-amber-100/80 to-orange-100/70 backdrop-blur-md text-5xl mb-6 shadow-glass">
        📡
      </div>

      <h1 class="text-2xl font-bold text-stone-800 mb-3">
        شما آفلاین هستید
      </h1>

      <p class="text-stone-500 text-sm leading-relaxed mb-8">
        ارتباط اینترنت قطع شده است. اما نگران نباشید — محتوای ذخیره‌شده در گوشی شما هنوز در دسترس است.
      </p>

      <div class="space-y-3">
        <a
          href="/"
          class="lg-button-primary touch-target w-full inline-flex items-center justify-center gap-2 py-4 px-6 font-bold"
        >
          <span aria-hidden="true">🏠</span>
          <span>بازگشت به صفحه اصلی</span>
        </a>

        <button
          type="button"
          onclick="window.location.reload()"
          class="lg-button touch-target w-full inline-flex items-center justify-center gap-2 py-4 px-6 font-semibold text-stone-600"
        >
          <span aria-hidden="true">🔄</span>
          <span>تلاش مجدد</span>
        </button>
      </div>

      <p class="mt-8 text-xs text-stone-400 leading-relaxed">
        برای دسترسی کامل به نقشه و واقعیت افزوده، به اینترنت نیاز دارید.
      </p>
    </div>
  </div>
</BaseLayout>