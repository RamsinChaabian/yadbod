---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="آفلاین">
  <div class="min-h-dvh flex items-center justify-center px-6">
    <div class="text-center max-w-md">
      <div class="text-7xl mb-6">📡</div>
      <h1 class="text-2xl font-bold text-stone-800 mb-3">
        شما آفلاین هستید
      </h1>
      <p class="text-stone-500 text-sm leading-relaxed mb-8">
        ارتباط اینترنت قطع شده است. اما نگران نباشید — محتوای ذخیره‌شده در گوشی شما هنوز در دسترس است.
      </p>
      <div class="space-y-3">
        <a
          href="/"
          class="touch-target w-full inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold px-6 py-4 transition-all hover:from-amber-600 hover:to-orange-600 shadow-lg"
        >
          <span>🏠</span>
          <span>بازگشت به صفحه اصلی</span>
        </a>
        <button
          type="button"
          onclick="window.location.reload()"
          class="touch-target w-full inline-flex items-center justify-center gap-2 rounded-2xl border border-stone-300 text-stone-600 font-medium px-6 py-4 transition-all hover:bg-stone-100"
        >
          <span>🔄</span>
          <span>تلاش مجدد</span>
        </button>
      </div>
      <p class="mt-6 text-xs text-stone-400 leading-relaxed">
        برای دسترسی کامل به نقشه و واقعیت افزوده، به اینترنت نیاز دارید.
      </p>
    </div>
  </div>
</BaseLayout>