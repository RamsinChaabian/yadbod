---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import TabBar from '../components/layout/TabBar.astro';
import TabContent from '../components/layout/TabContent.astro';
---

<BaseLayout>
  <!-- ⭐ تزئین پس‌زمینه — blob شیشه‌ای -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10" aria-hidden="true">
    <div class="absolute top-[10%] -start-32 w-72 h-72 rounded-full bg-gradient-to-br from-amber-200/30 to-orange-200/20 blur-3xl"></div>
    <div class="absolute top-[40%] -end-32 w-80 h-80 rounded-full bg-gradient-to-br from-rose-200/25 to-amber-200/20 blur-3xl"></div>
    <div class="absolute bottom-[15%] start-1/4 w-64 h-64 rounded-full bg-gradient-to-br from-amber-100/40 to-orange-100/25 blur-3xl"></div>
  </div>

  <Header />

  <main class="pb-32 sm:pb-40">
    <TabContent />
  </main>

  <TabBar />

  <script>
    import { haptic } from '../utils/haptic';

    function initTabs() {
      const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-tab-id]');
      const tabPanels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');

      if (tabButtons.length === 0) return;

      const validIds = Array.from(tabButtons)
        .map((b) => b.dataset.tabId)
        .filter((id): id is string => Boolean(id));

      function getActiveFromHash(): string {
        const hash = window.location.hash.replace(/^#/, '');
        return validIds.includes(hash) ? hash : validIds[0]!;
      }

      function setActive(id: string, updateHash = true) {
        tabButtons.forEach((btn) => {
          btn.setAttribute('aria-selected', String(btn.dataset.tabId === id));
        });

        tabPanels.forEach((panel) => {
          if (panel.dataset.tabPanel === id) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });

        if (updateHash && window.location.hash !== `#${id}`) {
          history.replaceState(null, '', `#${id}`);
        }
      }

      let currentActiveId = getActiveFromHash();

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.tabId;
          if (!id) return;

          if (id !== currentActiveId) {
            haptic.tap();
            currentActiveId = id;
          }

          setActive(id);
        });
      });

      window.addEventListener('hashchange', () => {
        const newId = getActiveFromHash();
        setActive(newId, false);
        currentActiveId = newId;
      });

      setActive(currentActiveId, false);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTabs);
    } else {
      initTabs();
    }
  </script>
</BaseLayout>