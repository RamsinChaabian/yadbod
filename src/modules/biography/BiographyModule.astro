---
import { render } from 'astro:content';
import { getBio } from '../../utils/content';

const entries = await getBio();
---

<div class="px-4 py-8 max-w-3xl mx-auto space-y-6">
  <!-- سربرگ شیشه‌ای -->
  <header class="lg-card p-6 sm:p-8 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-amber-100 to-orange-100 text-3xl mb-4 shadow-glass">
      📖
    </div>
    <h2 class="text-2xl font-bold text-stone-800 mb-2">زندگی‌نامه</h2>
    <p class="text-sm text-stone-500">روایت زندگی نجیه جان</p>
  </header>

  {entries.length === 0 && (
    <p class="text-stone-500 italic text-center">هنوز محتوایی اضافه نشده است.</p>
  )}

  {await Promise.all(
    entries.map(async (entry) => {
      const { Content } = await render(entry);
      return (
        <article class="lg-card p-6 sm:p-10 space-y-4">
          {entry.data.subtitle && (
            <p class="text-sm text-amber-700 tracking-wide font-medium">{entry.data.subtitle}</p>
          )}
          <div class="prose-custom text-stone-700 leading-relaxed">
            <Content />
          </div>
        </article>
      );
    })
  )}
</div>

<style>
  .prose-custom :global(p) {
    margin-bottom: 1.25rem;
    text-align: justify;
    text-justify: inter-word;
    text-align-last: start;
  }

  .prose-custom :global(blockquote) {
    border-right: 3px solid #B8915A;
    padding-right: 1.25rem;
    margin: 1.75rem 0;
    color: #8C6D3F;
    font-style: italic;
    text-align: justify;
    text-justify: inter-word;
    text-align-last: start;
    background: rgba(255, 255, 255, 0.4);
    padding: 1rem 1.25rem 1rem 1.25rem;
    border-radius: 16px;
    backdrop-filter: blur(8px);
  }

  .prose-custom :global(h2),
  .prose-custom :global(h3) {
    color: #8C6D3F;
    margin: 1.5rem 0 0.75rem;
    font-weight: 700;
    text-align: start;
  }

  .prose-custom :global(ul),
  .prose-custom :global(ol) {
    padding-right: 1.5rem;
    margin-bottom: 1rem;
  }

  .prose-custom :global(li) {
    margin-bottom: 0.5rem;
    text-align: justify;
    text-justify: inter-word;
  }
</style>