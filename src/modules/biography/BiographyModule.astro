---
import { render } from 'astro:content';
import { getBio } from '../../utils/content';

const entries = await getBio();
---

<div class="px-4 py-8 max-w-3xl mx-auto space-y-8">
  <h2 class="text-xl font-bold text-gold">زندگی‌نامه</h2>

  {entries.length === 0 && (
    <p class="text-ivory-muted italic">هنوز محتوایی اضافه نشده است.</p>
  )}

  {await Promise.all(
    entries.map(async (entry) => {
      const { Content } = await render(entry);
      return (
        <article class="space-y-4">
          {entry.data.subtitle && (
            <p class="text-sm text-gold-light tracking-wide">{entry.data.subtitle}</p>
          )}
          <div class="prose-custom text-ivory-soft leading-loose">
            <Content />
          </div>
        </article>
      );
    })
  )}
</div>

<style>
  .prose-custom :global(p) {
    margin-bottom: 1rem;
  }
  .prose-custom :global(blockquote) {
    border-right: 3px solid var(--color-gold);
    padding-right: 1rem;
    margin: 1.5rem 0;
    color: var(--color-gold-light);
    font-style: italic;
  }
  .prose-custom :global(h2),
  .prose-custom :global(h3) {
    color: var(--color-gold);
    margin: 1.5rem 0 0.75rem;
    font-weight: 700;
  }
  .prose-custom :global(ul),
  .prose-custom :global(ol) {
    padding-right: 1.5rem;
    margin-bottom: 1rem;
  }
  .prose-custom :global(li) {
    margin-bottom: 0.5rem;
  }
</style>