---
import { render } from 'astro:content';
import { getTimeline } from '../../utils/content';
import FamilyTree from './FamilyTree.astro';

const entries = await getTimeline();
---

<div class="px-4 py-8 max-w-3xl mx-auto">
  <!-- سربرگ -->
  <header class="lg-card p-6 sm:p-8 text-center mb-8">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-amber-100 to-orange-100 text-3xl mb-4 shadow-glass">
      ⏱️
    </div>
    <h2 class="text-2xl font-bold text-stone-800 mb-2">تایم‌لاین زندگی</h2>
    <p class="text-sm text-stone-500">رویدادهای مهم زندگی</p>
  </header>

  {entries.length === 0 && (
    <p class="text-stone-500 italic text-center">هنوز رویدادی اضافه نشده است.</p>
  )}

  {entries.length > 0 && (
    <ol class="relative border-s-2 border-amber-400/40 ps-6 space-y-6">
      {await Promise.all(
        entries.map(async (entry) => {
          const { Content } = await render(entry);
          return (
            <li class="relative" data-timeline-item>
              <!-- نقطه‌ی تایم‌لاین -->
              <span
                class="absolute -start-[33px] top-6 w-4 h-4 rounded-full bg-gradient-to-br from-amber-400 to-orange-500 ring-4 ring-white/70 shadow-glass z-10"
                aria-hidden="true"
              />
              <!-- کارت شیشه‌ای -->
              <div class="lg-card p-5 sm:p-6">
                <p class="text-amber-700 font-bold text-sm tabular-nums mb-1.5">
                  {entry.data.icon && <span class="me-2 text-base">{entry.data.icon}</span>}
                  {entry.data.year}
                  {entry.data.yearGregorian && (
                    <span class="text-stone-400 font-normal text-xs"> ({entry.data.yearGregorian})</span>
                  )}
                </p>
                <h3 class="text-stone-800 font-bold text-base mb-2">{entry.data.title}</h3>
                <div class="prose-custom text-stone-600 text-sm leading-relaxed">
                  <Content />
                </div>
              </div>
            </li>
          );
        })
      )}
    </ol>
  )}

  <!-- شجره‌نامه -->
  <div class="mt-12 pt-8">
    <FamilyTree />
  </div>
</div>

<style>
  .prose-custom :global(p) {
    margin: 0 0 0.75rem 0;
    text-align: justify;
    text-justify: inter-word;
    text-align-last: start;
  }
  .prose-custom :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose-custom :global(blockquote) {
    border-right: 3px solid #B8915A;
    padding-right: 1rem;
    margin: 1rem 0;
    color: #8C6D3F;
    font-style: italic;
  }
  .prose-custom :global(ul),
  .prose-custom :global(ol) {
    padding-right: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-custom :global(li) {
    margin-bottom: 0.25rem;
  }
</style>