---
import { render } from 'astro:content';
import { getTimeline } from '../../utils/content';
import FamilyTree from './FamilyTree.astro';

const entries = await getTimeline();
---

<div class="px-4 py-8 max-w-3xl mx-auto">
  <!-- ============================================================ -->
  <!-- بخش تایم‌لاین -->
  <!-- ============================================================ -->
  <header class="mb-8 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-amber-100 to-orange-100 text-3xl mb-4 shadow-card">
      ⏱️
    </div>
    <h2 class="text-2xl font-bold text-stone-800 mb-2">تایم‌لاین زندگی</h2>
    <p class="text-sm text-stone-500">رویدادهای مهم زندگی نجیه جان</p>
  </header>

  {entries.length === 0 && (
    <p class="text-stone-500 italic text-center">هنوز رویدادی اضافه نشده است.</p>
  )}

  {entries.length > 0 && (
    <ol class="relative border-s-2 border-amber-300/40 ps-6 space-y-10">
      {await Promise.all(
        entries.map(async (entry) => {
          const { Content } = await render(entry);
          return (
            <li class="relative" data-timeline-item>
              <span
                class="absolute -start-[33px] top-1.5 w-4 h-4 rounded-full bg-gradient-to-br from-amber-400 to-orange-500 ring-4 ring-cream shadow-md"
                aria-hidden="true"
              />
              <div class="rounded-2xl bg-white border border-stone-200 p-5 shadow-card hover:shadow-card-hover transition-shadow">
                <p class="text-amber-600 font-bold text-sm tabular-nums mb-1">
                  {entry.data.icon && <span class="me-2 text-base">{entry.data.icon}</span>}
                  {entry.data.year}
                  {entry.data.yearGregorian && (
                    <span class="text-stone-400 font-normal text-xs"> ({entry.data.yearGregorian})</span>
                  )}
                </p>
                <h3 class="text-stone-800 font-bold text-base mb-2">{entry.data.title}</h3>
                <div class="prose-custom text-stone-600 text-sm leading-relaxed">
                  <Content />
                </div>
              </div>
            </li>
          );
        })
      )}
    </ol>
  )}

  <!-- ============================================================ -->
  <!-- شجره‌نامه خانوادگی -->
  <!-- ============================================================ -->
  <div class="mt-16 pt-12 border-t-2 border-dashed border-amber-200/60">
    <FamilyTree />
  </div>
</div>

<style>
  .prose-custom :global(p) {
    margin: 0 0 0.75rem 0;
    text-align: justify;
    text-justify: inter-word;
    text-align-last: start;
  }
  .prose-custom :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose-custom :global(blockquote) {
    border-right: 3px solid var(--color-gold);
    padding-right: 1rem;
    margin: 1rem 0;
    color: var(--color-gold-light);
    font-style: italic;
  }
  .prose-custom :global(ul),
  .prose-custom :global(ol) {
    padding-right: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-custom :global(li) {
    margin-bottom: 0.25rem;
  }
</style>