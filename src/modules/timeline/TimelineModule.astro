---
import { render } from 'astro:content';
import { getTimeline } from '../../utils/content';

const entries = await getTimeline();
---

<div class="px-4 py-8 max-w-3xl mx-auto">
  <h2 class="text-xl font-bold text-gold mb-8">تایم‌لاین زندگی</h2>

  {entries.length === 0 && (
    <p class="text-ivory-muted italic">هنوز رویدادی اضافه نشده است.</p>
  )}

  {entries.length > 0 && (
    <ol class="relative border-s-2 border-gold/20 ps-6 space-y-10">
      {await Promise.all(
        entries.map(async (entry) => {
          const { Content } = await render(entry);
          return (
            <li class="relative" data-timeline-item>
              <span
                class="absolute -start-[33px] top-1 w-3 h-3 rounded-full bg-gold ring-4 ring-obsidian"
                aria-hidden="true"
              />
              <p class="text-gold font-bold text-sm tabular-nums">
                {entry.data.icon && <span class="me-2">{entry.data.icon}</span>}
                {entry.data.year}
                {entry.data.yearGregorian && (
                  <span class="text-ivory-muted font-normal"> ({entry.data.yearGregorian})</span>
                )}
              </p>
              <h3 class="text-ivory font-semibold mt-1">{entry.data.title}</h3>
              <div class="prose-custom text-ivory-soft text-sm mt-2 leading-relaxed">
                <Content />
              </div>
            </li>
          );
        })
      )}
    </ol>
  )}
</div>

<style>
  .prose-custom :global(p) {
    margin: 0;
  }
</style>