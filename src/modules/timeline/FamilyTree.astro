---
import { config } from '../../utils/config';

const { family } = config;
const { parents, siblings, spouse, children: kids } = family;

// شمارش خواهران و برادران
const sisterCount = siblings.filter((s) => s.gender === 'female').length;
const brotherCount = siblings.filter((s) => s.gender === 'male').length;
const daughterCount = kids.filter((c) => c.gender === 'female').length;
const sonCount = kids.filter((c) => c.gender === 'male').length;
---

<section class="family-tree my-12">
  <!-- سربرگ -->
  <header class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-amber-100 to-orange-100 text-3xl mb-4 shadow-card">
      🌳
    </div>
    <h3 class="text-2xl font-bold text-stone-800 mb-2">{family.title}</h3>
    <p class="text-sm text-stone-500">{family.subtitle}</p>
  </header>

  <!-- ============================================================ -->
  <!-- نسل اول: پدر و مادر -->
  <!-- ============================================================ -->
  <div class="family-generation" data-generation="1">
    <p class="family-generation-label">نسل اول</p>

    <div class="flex justify-center gap-4 sm:gap-8 flex-wrap">
      {parents.map((parent) => (
        <article class="family-card family-card--parent">
          <div class="family-card-avatar family-card-avatar--parent">
            {parent.avatar}
          </div>
          <p class="family-card-name">{parent.name}</p>
          <p class="family-card-role">{parent.role}</p>
        </article>
      ))}
    </div>

    <!-- خط اتصال پایین -->
    <div class="family-connector-line family-connector-line--down"></div>
  </div>

  <!-- ============================================================ -->
  <!-- نسل دوم: خواهران و برادران -->
  <!-- ============================================================ -->
  <div class="family-generation" data-generation="2">
    <p class="family-generation-label">
      خواهران و برادران
      <span class="family-count">
        {sisterCount} خواهر · {brotherCount} برادر
      </span>
    </p>

    <div class="family-siblings-grid">
      {siblings.map((sib) => (
        <article
          class:list={[
            'family-card family-card--sibling',
            sib.gender === 'female' ? 'family-card--female' : 'family-card--male',
            sib.isMain && 'family-card--main',
          ]}
        >
          {sib.isMain && <span class="family-card-star" aria-label="شخص اصلی">⭐</span>}
          <div class:list={[
            'family-card-avatar family-card-avatar--sibling',
            sib.gender === 'female' ? 'family-card-avatar--female' : 'family-card-avatar--male',
            sib.isMain && 'family-card-avatar--main',
          ]}>
            {sib.gender === 'female' ? '👩' : '👨'}
          </div>
          <p class="family-card-name">{sib.name}</p>
          {sib.isMain && <p class="family-card-role">صاحب یادبود</p>}
        </article>
      ))}
    </div>

    <!-- خط اتصال به نسل بعد -->
    <div class="family-connector-line family-connector-line--down"></div>
  </div>

  <!-- ============================================================ -->
  <!-- نجیه + همسر -->
  <!-- ============================================================ -->
  <div class="family-generation" data-generation="2.5">
    <p class="family-generation-label">پیوند</p>

    <div class="family-couple">
      <article class="family-card family-card--main-large">
        <span class="family-card-star" aria-label="شخص اصلی">⭐</span>
        <div class="family-card-avatar family-card-avatar--main-large">👩</div>
        <p class="family-card-name">نجیه</p>
        <p class="family-card-role">صاحب یادبود</p>
      </article>

      <div class="family-heart" aria-hidden="true">
        <span class="family-heart-icon">❤️</span>
        <div class="family-heart-line"></div>
      </div>

      <article class="family-card family-card--spouse">
        <div class="family-card-avatar family-card-avatar--spouse">{spouse.avatar}</div>
        <p class="family-card-name">{spouse.name}</p>
        <p class="family-card-role">{spouse.role}</p>
      </article>
    </div>

    <div class="family-connector-line family-connector-line--down"></div>
  </div>

  <!-- ============================================================ -->
  <!-- نسل سوم: فرزندان -->
  <!-- ============================================================ -->
  <div class="family-generation" data-generation="3">
    <p class="family-generation-label">
      فرزندان
      <span class="family-count">
        {daughterCount} دختر · {sonCount} پسر
      </span>
    </p>

    <div class="family-children-grid">
      {kids.map((child) => (
        <article class:list={[
          'family-card family-card--child',
          child.gender === 'female' ? 'family-card--female' : 'family-card--male',
        ]}>
          <div class:list={[
            'family-card-avatar family-card-avatar--child',
            child.gender === 'female' ? 'family-card-avatar--female' : 'family-card-avatar--male',
          ]}>
            {child.gender === 'female' ? '👧' : '👦'}
          </div>
          <p class="family-card-name">{child.name}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* ============================================================ */
  /* ساختار کلی درخت */
  /* ============================================================ */
  .family-tree {
    position: relative;
    padding: 2rem 0;
  }

  .family-generation {
    position: relative;
    margin-bottom: 3rem;
  }

  .family-generation-label {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: #9A9488;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .family-count {
    display: block;
    font-size: 0.7rem;
    color: #B8915A;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    margin-top: 0.25rem;
  }

  /* ============================================================ */
  /* کارت‌ها */
  /* ============================================================ */
  .family-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 0.875rem 0.75rem;
    border-radius: 1.25rem;
    background: #FFFFFF;
    border: 1.5px solid #F5EDE0;
    box-shadow:
      0 2px 8px -2px rgba(74, 63, 53, 0.06),
      0 1px 3px -1px rgba(74, 63, 53, 0.04);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    min-width: 72px;
  }

  @media (hover: hover) {
    .family-card:hover {
      transform: translateY(-3px);
      box-shadow:
        0 8px 20px -4px rgba(74, 63, 53, 0.12),
        0 3px 8px -2px rgba(74, 63, 53, 0.06);
      border-color: #E8833A;
    }
  }

  /* آواتار */
  .family-card-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    flex-shrink: 0;
    transition: transform 0.3s;
  }

  .family-card:hover .family-card-avatar {
    transform: scale(1.08);
  }

  .family-card-name {
    font-size: 0.813rem;
    font-weight: 700;
    color: #4A3F35;
    text-align: center;
    line-height: 1.2;
  }

  .family-card-role {
    font-size: 0.688rem;
    color: #9A9488;
    font-weight: 500;
    text-align: center;
  }

  /* ستاره‌ی نفر اصلی */
  .family-card-star {
    position: absolute;
    top: -8px;
    inset-inline-end: -8px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: linear-gradient(135deg, #F5A623, #E8833A);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    box-shadow: 0 2px 8px rgba(232, 131, 58, 0.5);
    animation: star-pulse 2s ease-in-out infinite;
  }

  @keyframes star-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  /* ============================================================ */
  /* کارت والدین */
  /* ============================================================ */
  .family-card--parent {
    background: linear-gradient(135deg, #FFF8F0 0%, #FBF2E5 100%);
    border-color: #E8D5B8;
    min-width: 110px;
    padding: 1.25rem 1rem;
  }

  .family-card-avatar--parent {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #F5EDE0, #E8D5B8);
    font-size: 2.25rem;
  }

  /* ============================================================ */
  /* کارت خواهر و برادر */
  /* ============================================================ */
  .family-card--sibling {
    min-width: 76px;
  }

  .family-card-avatar--female {
    background: linear-gradient(135deg, #FCE7E0, #F4C9B8);
  }

  .family-card-avatar--male {
    background: linear-gradient(135deg, #E0EDF5, #C8DAE8);
  }

  /* کارت نجیه (برجسته) */
  .family-card--main {
    background: linear-gradient(135deg, #FFF8F0 0%, #FFEBD6 100%);
    border-color: #E8833A;
    border-width: 2px;
    box-shadow:
      0 4px 16px -2px rgba(232, 131, 58, 0.25),
      0 2px 6px -1px rgba(232, 131, 58, 0.15);
    transform: scale(1.05);
  }

  @media (hover: hover) {
    .family-card--main:hover {
      transform: translateY(-3px) scale(1.08);
      box-shadow:
        0 8px 24px -4px rgba(232, 131, 58, 0.35),
        0 3px 10px -2px rgba(232, 131, 58, 0.2);
    }
  }

  .family-card-avatar--main {
    background: linear-gradient(135deg, #F5A623, #E8833A);
    color: white;
    width: 56px;
    height: 56px;
    font-size: 2rem;
    box-shadow: 0 4px 12px rgba(232, 131, 58, 0.4);
  }

  /* ============================================================ */
  /* Grid خواهران و برادران */
  /* ============================================================ */
  .family-siblings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(76px, 1fr));
    gap: 0.75rem;
    max-width: 100%;
    padding: 0 0.25rem;
  }

  @media (min-width: 640px) {
    .family-siblings-grid {
      grid-template-columns: repeat(auto-fit, minmax(84px, 1fr));
      gap: 1rem;
    }
  }

  /* ============================================================ */
  /* زوج (نجیه + همسر) */
  /* ============================================================ */
  .family-couple {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (min-width: 640px) {
    .family-couple {
      gap: 1.5rem;
    }
  }

  .family-card--main-large {
    background: linear-gradient(135deg, #FFF8F0 0%, #FFEBD6 100%);
    border-color: #E8833A;
    border-width: 2px;
    padding: 1.25rem 1rem;
    min-width: 110px;
    box-shadow:
      0 6px 20px -4px rgba(232, 131, 58, 0.3),
      0 2px 8px -2px rgba(232, 131, 58, 0.15);
  }

  .family-card-avatar--main-large {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, #F5A623, #E8833A);
    font-size: 2.25rem;
    box-shadow: 0 4px 12px rgba(232, 131, 58, 0.4);
  }

  .family-card--spouse {
    background: linear-gradient(135deg, #F0F5FF 0%, #E0E9F5 100%);
    border-color: #C8DAE8;
    padding: 1.25rem 1rem;
    min-width: 110px;
  }

  .family-card-avatar--spouse {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #E0EDF5, #C8DAE8);
    font-size: 2.25rem;
  }

  /* قلب وسط */
  .family-heart {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }

  .family-heart-icon {
    font-size: 1.5rem;
    z-index: 1;
    animation: heart-beat 1.6s ease-in-out infinite;
  }

  @keyframes heart-beat {
    0%, 100% { transform: scale(1); }
    25% { transform: scale(1.15); }
    50% { transform: scale(1); }
    75% { transform: scale(1.15); }
  }

  .family-heart-line {
    position: absolute;
    inset: -4px;
    border: 2px dashed #E8A0A0;
    border-radius: 50%;
    opacity: 0.4;
    animation: heart-ring 3s linear infinite;
  }

  @keyframes heart-ring {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ============================================================ */
  /* Grid فرزندان */
  /* ============================================================ */
  .family-children-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(84px, 1fr));
    gap: 0.75rem;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 0.25rem;
  }

  @media (min-width: 640px) {
    .family-children-grid {
      grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
      gap: 1rem;
    }
  }

  .family-card--child {
    min-width: 84px;
  }

  .family-card-avatar--child {
    width: 52px;
    height: 52px;
    font-size: 1.75rem;
  }

  /* ============================================================ */
  /* خطوط اتصال */
  /* ============================================================ */
  .family-connector-line {
    position: relative;
    margin: 0 auto;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      #E8D5B8 20%,
      #E8D5B8 80%,
      transparent 100%
    );
  }

  .family-connector-line--down {
    height: 32px;
    margin-top: 1.5rem;
  }

  .family-connector-line--down::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #E8833A;
    box-shadow: 0 0 0 4px rgba(232, 131, 58, 0.15);
  }

  /* ============================================================ */
  /* Reduced Motion */
  /* ============================================================ */
  @media (prefers-reduced-motion: reduce) {
    .family-card,
    .family-card-avatar,
    .family-card-star,
    .family-heart-icon,
    .family-heart-line {
      transition: none !important;
      animation: none !important;
    }
  }
</style>