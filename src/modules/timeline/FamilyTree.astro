---
import { config } from '../../utils/config';

const { family, person } = config;
const { parents, siblings, spouse, children: kids } = family;

const sisterCount = siblings.filter((s) => s.gender === 'female').length;
const brotherCount = siblings.filter((s) => s.gender === 'male').length;
const daughterCount = kids.filter((c) => c.gender === 'female').length;
const sonCount = kids.filter((c) => c.gender === 'male').length;
---

<section class="family-tree my-12">
  <!-- سربرگ -->
  <header class="text-center mb-8">
    <div class="lg-thin inline-flex items-center justify-center w-16 h-16 rounded-full text-3xl mb-4 shadow-glass">
      🌳
    </div>
    <h3 class="text-2xl font-bold text-stone-800 mb-2">{family.title}</h3>
    <p class="text-sm text-stone-500">{family.subtitle}</p>
  </header>

  <!-- نسل اول -->
  <div class="family-generation" data-generation="1">
    <p class="family-generation-label">نسل اول</p>

    <div class="flex justify-center gap-4 sm:gap-8 flex-wrap">
      {parents.map((parent) => (
        <article class="family-card family-card--parent lg-card">
          <div class="family-card-avatar family-card-avatar--parent">
            {parent.avatar}
          </div>
          <p class="family-card-name">{parent.name}</p>
          <p class="family-card-role">{parent.role}</p>
        </article>
      ))}
    </div>

    <div class="family-connector-line family-connector-line--down"></div>
  </div>

  <!-- نسل دوم -->
  <div class="family-generation" data-generation="2">
    <p class="family-generation-label">
      خواهران و برادران
      <span class="family-count">
        {sisterCount} خواهر · {brotherCount} برادر
      </span>
    </p>

    <div class="family-siblings-grid">
      {siblings.map((sib) => (
        <article
          class:list={[
            'family-card family-card--sibling lg-card',
            sib.gender === 'female' ? 'family-card--female' : 'family-card--male',
            sib.isMain && 'family-card--main',
          ]}
        >
          {sib.isMain && <span class="family-card-star" aria-label="شخص اصلی">⭐</span>}
          {sib.isMain ? (
            <div class="family-card-avatar family-card-avatar--main">
              <img
                src={person.profileImage}
                alt={person.imageAlt}
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            <div class:list={[
              'family-card-avatar family-card-avatar--sibling',
              sib.gender === 'female' ? 'family-card-avatar--female' : 'family-card-avatar--male',
            ]}>
              {sib.gender === 'female' ? '👩' : '👨'}
            </div>
          )}
          <p class="family-card-name">{sib.name}</p>
        </article>
      ))}
    </div>

    <div class="family-connector-line family-connector-line--down"></div>
  </div>

  <!-- پیوند -->
  <div class="family-generation" data-generation="2.5">
    <p class="family-generation-label">پیوند</p>

    <div class="family-couple">
      <article class="family-card family-card--main-large lg-card">
        <span class="family-card-star" aria-label="شخص اصلی">⭐</span>
        <div class="family-card-avatar family-card-avatar--main-large">
          <img
            src={person.profileImage}
            alt={person.imageAlt}
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="family-card-name">نجیه</p>
      </article>

      <div class="family-heart" aria-hidden="true">
        <span class="family-heart-icon">❤️</span>
        <div class="family-heart-line"></div>
      </div>

      <article class="family-card family-card--spouse lg-card">
        <div class="family-card-avatar family-card-avatar--spouse">{spouse.avatar}</div>
        <p class="family-card-name">{spouse.name}</p>
        <p class="family-card-role">{spouse.role}</p>
      </article>
    </div>

    <div class="family-connector-line family-connector-line--down"></div>
  </div>

  <!-- نسل سوم -->
  <div class="family-generation" data-generation="3">
    <p class="family-generation-label">
      فرزندان
      <span class="family-count">
        {daughterCount} دختر · {sonCount} پسر
      </span>
    </p>

    <div class="family-children-grid">
      {kids.map((child) => (
        <article class:list={[
          'family-card family-card--child lg-card',
          child.gender === 'female' ? 'family-card--female' : 'family-card--male',
        ]}>
          <div class:list={[
            'family-card-avatar family-card-avatar--child',
            child.gender === 'female' ? 'family-card-avatar--female' : 'family-card-avatar--male',
          ]}>
            {child.gender === 'female' ? '👧' : '👦'}
          </div>
          <p class="family-card-name">{child.name}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* ============================================================ */
  /* ساختار کلی */
  /* ============================================================ */
  .family-tree {
    position: relative;
    padding: 1rem 0;
  }

  .family-generation {
    position: relative;
    margin-bottom: 2rem;
  }

  .family-generation-label {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: #8B7D6B;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .family-count {
    display: block;
    font-size: 0.7rem;
    color: #B8915A;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    margin-top: 0.25rem;
  }

  /* ============================================================ */
  /* کارت‌ها — با lg-card پایه */
  /* ============================================================ */
  .family-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 0.875rem 0.75rem;
    min-width: 72px;
    /* lg-card از HTML اومده */
  }

  /* کارت والدین */
  .family-card--parent {
    min-width: 110px;
    padding: 1.25rem 1rem;
  }

  .family-card--parent .family-card-avatar--parent {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #F5EDE0, #E8D5B8);
    font-size: 2.25rem;
  }

  /* کارت خواهر و برادر */
  .family-card--sibling {
    min-width: 76px;
  }

  /* کارت فرزند */
  .family-card--child {
    min-width: 84px;
  }

  /* کارت اصلی (نجیه) — برجسته */
  .family-card--main {
    border-color: #E8833A !important;
    background: linear-gradient(
      135deg,
      rgba(255, 248, 240, 0.85) 0%,
      rgba(255, 235, 214, 0.75) 100%
    ) !important;
    transform: scale(1.05);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 8px 24px rgba(232, 131, 58, 0.3),
      0 2px 8px rgba(232, 131, 58, 0.2) !important;
  }

  @media (hover: hover) {
    .family-card--main:hover {
      transform: translateY(-3px) scale(1.08);
    }
  }

  .family-card--main-large {
    min-width: 110px;
    padding: 1.25rem 1rem;
    border-color: #E8833A !important;
    background: linear-gradient(
      135deg,
      rgba(255, 248, 240, 0.85) 0%,
      rgba(255, 235, 214, 0.75) 100%
    ) !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 8px 24px rgba(232, 131, 58, 0.3),
      0 2px 8px rgba(232, 131, 58, 0.2) !important;
  }

  /* کارت همسر */
  .family-card--spouse {
    min-width: 110px;
    padding: 1.25rem 1rem;
    background: linear-gradient(
      135deg,
      rgba(240, 245, 255, 0.75) 0%,
      rgba(224, 233, 245, 0.65) 100%
    ) !important;
  }

  /* ============================================================ */
  /* آواتارها */
  /* ============================================================ */
  .family-card-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    flex-shrink: 0;
    transition: transform 0.3s;
    overflow: hidden;
  }

  .family-card:hover .family-card-avatar {
    transform: scale(1.08);
  }

  .family-card-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }

  .family-card-avatar--female {
    background: linear-gradient(135deg, #FCE7E0, #F4C9B8);
  }

  .family-card-avatar--male {
    background: linear-gradient(135deg, #E0EDF5, #C8DAE8);
  }

  .family-card-avatar--main {
    width: 56px;
    height: 56px;
    padding: 2px;
    background: linear-gradient(135deg, #F5A623, #E8833A);
    box-shadow: 0 4px 12px rgba(232, 131, 58, 0.4);
  }

  .family-card-avatar--main img {
    border: 2px solid #FFFFFF;
  }

  .family-card-avatar--main-large {
    width: 64px;
    height: 64px;
    padding: 2px;
    background: linear-gradient(135deg, #F5A623, #E8833A);
    box-shadow: 0 4px 12px rgba(232, 131, 58, 0.4);
  }

  .family-card-avatar--main-large img {
    border: 2px solid #FFFFFF;
  }

  .family-card-avatar--spouse {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #E0EDF5, #C8DAE8);
    font-size: 2.25rem;
  }

  .family-card-avatar--child {
    width: 52px;
    height: 52px;
    font-size: 1.75rem;
  }

  /* ============================================================ */
  /* متن کارت */
  /* ============================================================ */
  .family-card-name {
    font-size: 0.813rem;
    font-weight: 700;
    color: #4A3F35;
    text-align: center;
    line-height: 1.2;
  }

  .family-card-role {
    font-size: 0.688rem;
    color: #8B7D6B;
    font-weight: 500;
    text-align: center;
  }

  /* ستاره */
  .family-card-star {
    position: absolute;
    top: -8px;
    inset-inline-end: -8px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: linear-gradient(135deg, #F5A623, #E8833A);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    box-shadow: 0 2px 8px rgba(232, 131, 58, 0.5);
    animation: star-pulse 2s ease-in-out infinite;
    z-index: 2;
  }

  @keyframes star-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  /* ============================================================ */
  /* Grid ها */
  /* ============================================================ */
  .family-siblings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(76px, 1fr));
    gap: 0.75rem;
    padding: 0 0.25rem;
  }

  @media (min-width: 640px) {
    .family-siblings-grid {
      grid-template-columns: repeat(auto-fit, minmax(84px, 1fr));
      gap: 1rem;
    }
  }

  .family-couple {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (min-width: 640px) {
    .family-couple {
      gap: 1.5rem;
    }
  }

  .family-children-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(84px, 1fr));
    gap: 0.75rem;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 0.25rem;
  }

  @media (min-width: 640px) {
    .family-children-grid {
      grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
      gap: 1rem;
    }
  }

  /* ============================================================ */
  /* قلب وسط */
  /* ============================================================ */
  .family-heart {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }

  .family-heart-icon {
    font-size: 1.5rem;
    z-index: 1;
    animation: heart-beat 1.6s ease-in-out infinite;
  }

  @keyframes heart-beat {
    0%, 100% { transform: scale(1); }
    25% { transform: scale(1.15); }
    50% { transform: scale(1); }
    75% { transform: scale(1.15); }
  }

  .family-heart-line {
    position: absolute;
    inset: -4px;
    border: 2px dashed rgba(232, 160, 160, 0.5);
    border-radius: 50%;
    opacity: 0.6;
    animation: heart-ring 3s linear infinite;
  }

  @keyframes heart-ring {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ============================================================ */
  /* خطوط اتصال */
  /* ============================================================ */
  .family-connector-line {
    position: relative;
    margin: 0 auto;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(184, 145, 90, 0.4) 20%,
      rgba(184, 145, 90, 0.4) 80%,
      transparent 100%
    );
  }

  .family-connector-line--down {
    height: 28px;
    margin-top: 1.25rem;
  }

  .family-connector-line--down::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #E8833A;
    box-shadow: 0 0 0 4px rgba(232, 131, 58, 0.15);
  }

  /* ============================================================ */
  /* Reduced Motion */
  /* ============================================================ */
  @media (prefers-reduced-motion: reduce) {
    .family-card,
    .family-card-avatar,
    .family-card-star,
    .family-heart-icon,
    .family-heart-line {
      transition: none !important;
      animation: none !important;
    }
  }
</style>