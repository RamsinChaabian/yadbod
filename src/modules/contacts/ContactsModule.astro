---
import { config } from '../../utils/config';
import ContactCard from './ContactCard.astro';

const { contacts } = config;
---

<div class="px-4 py-8 max-w-3xl mx-auto">
  <header class="mb-8 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-amber-100 to-orange-100 text-3xl mb-4 shadow-card">
      📞
    </div>
    <h2 class="text-2xl font-bold text-stone-800 mb-2">{contacts.title}</h2>
    <p class="text-sm text-stone-500 max-w-md mx-auto leading-relaxed">{contacts.description}</p>
  </header>

  {contacts.contacts.length === 0 ? (
    <div class="rounded-2xl bg-amber-50 border border-amber-200 p-6 text-center text-stone-500 text-sm">
      هنوز شماره‌ای اضافه نشده است.
    </div>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {contacts.contacts.map((contact) => (
        <ContactCard contact={contact} />
      ))}
    </div>
  )}

  <!-- توضیح پایانی -->
  <div class="mt-10 rounded-2xl bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 p-5 text-center">
    <p class="text-xs text-stone-600 leading-relaxed">
      🕊️ در صورت عدم پاسخ، لطفاً بعداً تماس بگیرید یا پیام بگذارید. از همراهی شما سپاسگزاریم.
    </p>
  </div>
</div>