---
import MapModule from '../map/MapModule.astro';
import ARModule from '../ar/ARModule.astro';
---

<div class="px-4 py-6 max-w-4xl mx-auto">
  <!-- سربرگ شیشه‌ای -->
  <header class="lg-card p-6 sm:p-8 text-center mb-5">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-amber-100 to-orange-100 text-3xl mb-4 shadow-glass">
      🧭
    </div>
    <h2 class="text-2xl font-bold text-stone-800 mb-2">مسیر و قبر</h2>
    <p class="text-sm text-stone-500">مسیریابی زنده و یافتن قبر با دوربین</p>
  </header>

  <!-- Toggle شیشه‌ای -->
  <div class="lg-surface p-1.5 mb-5 flex gap-1.5" style="border-radius: 28px;">
    <button
      type="button"
      data-nav-tab="map"
      class="nav-toggle-btn flex-1 rounded-[22px] px-4 py-3 text-sm font-semibold transition-all duration-300"
    >
      🗺️ نقشه و مسیریابی
    </button>
    <button
      type="button"
      data-nav-tab="ar"
      class="nav-toggle-btn flex-1 rounded-[22px] px-4 py-3 text-sm font-semibold transition-all duration-300"
    >
      📷 یافتن با دوربین
    </button>
  </div>

  <div data-nav-panel="map"><MapModule /></div>
  <div data-nav-panel="ar" hidden><ARModule /></div>
</div>

<style>
  /* حالت پیش‌فرض: غیرفعال */
  .nav-toggle-btn {
    color: #8B7D6B;
    background: transparent;
    border: 1px solid transparent;
  }

  @media (hover: hover) {
    .nav-toggle-btn:not(.is-active):hover {
      color: #5A4A3F;
      background: rgba(255, 255, 255, 0.4);
    }
  }

  /* حالت فعال: شیشه‌ی روشن */
  .nav-toggle-btn.is-active {
    color: #E8833A;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.85) 0%,
      rgba(255, 255, 255, 0.7) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 4px 16px rgba(232, 131, 58, 0.15);
  }
</style>

<script>
  function initNavToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-nav-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-nav-panel]');

    function setActive(target: string) {
      buttons.forEach((b) => {
        const isActive = b.dataset.navTab === target;
        b.classList.toggle('is-active', isActive);
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.navPanel !== target;
      });
    }

    // مقدار اولیه
    setActive('map');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.navTab;
        if (target) setActive(target);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavToggle);
  } else {
    initNavToggle();
  }
</script>