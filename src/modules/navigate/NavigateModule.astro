---
import MapModule from '../map/MapModule.astro';
import ARModule from '../ar/ARModule.astro';
---

<div class="px-4 py-6 max-w-4xl mx-auto">
  <h2 class="text-2xl font-bold text-stone-800 mb-6">مسیر و قبر</h2>

  <!-- Toggle داخلی: نقشه / AR -->
  <div class="flex gap-2 mb-5 bg-stone-100 rounded-2xl p-1.5">
    <button type="button" data-nav-tab="map" class="flex-1 rounded-xl px-4 py-3 text-sm font-semibold transition-all duration-300 bg-white text-amber-700 shadow-sm">
      🗺️ نقشه و مسیریابی
    </button>
    <button type="button" data-nav-tab="ar" class="flex-1 rounded-xl px-4 py-3 text-sm font-semibold transition-all duration-300 text-stone-500 hover:text-stone-700">
      📷 یافتن با دوربین
    </button>
  </div>

  <div data-nav-panel="map"><MapModule /></div>
  <div data-nav-panel="ar" hidden><ARModule /></div>
</div>

<script>
  function initNavToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-nav-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-nav-panel]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.navTab;
        buttons.forEach((b) => {
          const isActive = b.dataset.navTab === target;
          b.classList.toggle('bg-white', isActive);
          b.classList.toggle('text-amber-700', isActive);
          b.classList.toggle('shadow-sm', isActive);
          b.classList.toggle('text-stone-500', !isActive);
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.navPanel !== target;
        });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initNavToggle);
  else initNavToggle();
</script>