---
import { config } from '../../utils/config';
import ARScene from './ARScene.astro';

const { location } = config;
---

<div class="px-4 py-8 max-w-3xl mx-auto">
  <header class="mb-6">
    <h2 class="text-xl font-bold text-gold mb-1">یافتن قبر با واقعیت افزوده</h2>
    <p class="text-sm text-ivory-muted">
      با دوربین گوشی، مسیر رسیدن به قبر را ببینید.
    </p>
  </header>

  <!-- وضعیت: آماده شروع -->
  <div data-ar-start-panel class="space-y-5">
    <!-- کارت پیش‌نمایش -->
    <div class="aspect-video rounded-lg bg-obsidian-elevated border border-gold/10 flex items-center justify-center relative overflow-hidden">
      <div class="text-center">
        <div class="text-5xl mb-3">📷</div>
        <p class="text-ivory-soft text-sm">دوربین گوشی شما فعال می‌شود</p>
        <p class="text-ivory-muted text-xs mt-1">برای مشاهده نشانگر قبر، دکمه‌ی زیر را بزنید</p>
      </div>
    </div>

    <!-- دکمه شروع -->
    <button
      type="button"
      data-ar-start
      class="touch-target w-full inline-flex items-center justify-center gap-2 rounded-lg bg-gold text-obsidian font-semibold px-6 py-4 transition-colors hover:bg-gold-light text-base"
    >
      <span aria-hidden="true">📸</span>
      <span>شروع واقعیت افزوده</span>
    </button>

    <!-- هشدار عدم پشتیبانی -->
    <div
      data-ar-unsupported
      hidden
      class="rounded-lg bg-warning/10 border border-warning/40 p-4 text-sm text-ivory"
      role="alert"
    >
      <p data-ar-unsupported-msg></p>
      <a
        href={location.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-2 text-gold hover:text-gold-light underline underline-offset-4"
      >
        📍 مسیریابی با Google Maps
      </a>
    </div>

    <!-- هشدار خطا -->
    <div
      data-ar-error
      hidden
      class="rounded-lg bg-danger/10 border border-danger/40 p-4 text-sm text-ivory"
      role="alert"
    >
      <p data-ar-error-msg></p>
      <button
        type="button"
        data-ar-retry
        class="mt-3 text-gold hover:text-gold-light underline underline-offset-4"
      >
        تلاش مجدد
      </button>
    </div>

    <!-- راهنمای استفاده -->
    <div class="rounded-lg bg-obsidian-elevated border border-gold/10 p-4">
      <h3 class="text-sm font-semibold text-gold mb-3">راهنما</h3>
      <ul class="space-y-2 text-xs text-ivory-muted leading-relaxed">
        <li>• در فضای باز و با دید آسمان باز استفاده کنید</li>
        <li>• گوشی را به آرامی بچرخانید تا نشانگر طلایی ظاهر شود</li>
        <li>• فاصله و جهت در گوشه صفحه نمایش داده می‌شود</li>
        <li>• برای عملکرد صحیح به HTTPS نیاز است</li>
      </ul>
    </div>
  </div>

  <!-- AR Scene (مخفی تا زمان شروع) -->
  <ARScene />
</div>

<!-- اسکریپت A-Frame و LocAR — فقط زمانی لود می‌شوند که کاربر دکمه بزند -->
<script>
  // ---------- Type Declarations ----------
  declare global {
    interface Window {
      AFRAME?: {
        registerComponent: (name: string, def: object) => void;
        scenes: Array<{
          emit: (event: string, detail?: unknown) => void;
          object3D: { children: Array<{ name: string; visible: boolean }> };
        }>;
      };
    }
  }

  // ---------- Lazy Load ----------
  async function loadARLibs(): Promise<boolean> {
    if (window.AFRAME) return true;
    try {
      await Promise.all([
        import('aframe'),
        import('locar-aframe'),
      ]);
      return true;
    } catch (e) {
      console.error('[AR] Failed to load libs:', e);
      return false;
    }
  }

  // ---------- Init AR ----------
  async function initAR() {
    const startPanel = document.querySelector<HTMLElement>('[data-ar-start-panel]');
    const startBtn = document.querySelector<HTMLButtonElement>('[data-ar-start]');
    const sceneWrap = document.querySelector<HTMLElement>('[data-ar-scene]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-ar-close]');
    const distanceEl = document.querySelector<HTMLElement>('[data-ar-distance]');
    const bearingEl = document.querySelector<HTMLElement>('[data-ar-bearing]');
    const errorBox = document.querySelector<HTMLElement>('[data-ar-error]');
    const errorMsg = document.querySelector<HTMLElement>('[data-ar-error-msg]');
    const unsupportedBox = document.querySelector<HTMLElement>('[data-ar-unsupported]');
    const unsupportedMsg = document.querySelector<HTMLElement>('[data-ar-unsupported-msg]');
    const hintEl = document.querySelector<HTMLElement>('[data-ar-hint]');

    if (!startBtn || !sceneWrap || !startPanel) return;

    // ---------- Check Support ----------
    function checkSupport(): { supported: boolean; reason?: string } {
      if (!('geolocation' in navigator)) {
        return { supported: false, reason: 'مرورگر شما از GPS پشتیبانی نمی‌کند.' };
      }
      if (!('DeviceOrientationEvent' in window)) {
        return { supported: false, reason: 'مرورگر شما از سنسور جهت‌یابی پشتیبانی نمی‌کند.' };
      }
      if (!navigator.mediaDevices?.getUserMedia) {
        return { supported: false, reason: 'مرورگر شما از دوربین پشتیبانی نمی‌کند.' };
      }
      const ua = navigator.userAgent.toLowerCase();
      if (ua.includes('firefox')) {
        return { supported: false, reason: 'Firefox از AR مبتنی بر مکان پشتیبانی نمی‌کند. لطفاً Chrome یا Safari استفاده کنید.' };
      }
      return { supported: true };
    }

    // ---------- Errors ----------
    function showError(msg: string) {
      if (errorBox && errorMsg) {
        errorMsg.textContent = msg;
        errorBox.hidden = false;
      }
    }
    function hideError() {
      if (errorBox) errorBox.hidden = true;
    }

    // ---------- Haversine Distance ----------
    function calcDistance(lat1: number, lon1: number, lat2: number, lon2: number): number {
      const R = 6371000;
      const toRad = (d: number) => (d * Math.PI) / 180;
      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);
      const a = Math.sin(dLat / 2) ** 2 +
        Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    // ---------- Bearing ----------
    function calcBearing(lat1: number, lon1: number, lat2: number, lon2: number): number {
      const toRad = (d: number) => (d * Math.PI) / 180;
      const toDeg = (r: number) => (r * 180) / Math.PI;
      const dLon = toRad(lon2 - lon1);
      const y = Math.sin(dLon) * Math.cos(toRad(lat2));
      const x = Math.cos(toRad(lat1)) * Math.sin(toRad(lat2)) -
        Math.sin(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.cos(dLon);
      return (toDeg(Math.atan2(y, x)) + 360) % 360;
    }

    // ---------- Format Distance ----------
    function formatDist(m: number): string {
      if (m < 1000) return `${Math.round(m)} متر`;
      return `${(m / 1000).toFixed(1)} کیلومتر`;
    }

    // ---------- Update HUD ----------
    let watchId: number | null = null;

    function startPositionWatch(lat: number, lng: number) {
      if (watchId !== null) navigator.geolocation.clearWatch(watchId);
      watchId = navigator.geolocation.watchPosition(
        (pos) => {
          const dist = calcDistance(
            pos.coords.latitude, pos.coords.longitude,
            lat, lng
          );
          const bearing = calcBearing(
            pos.coords.latitude, pos.coords.longitude,
            lat, lng
          );
          if (distanceEl) distanceEl.textContent = formatDist(dist);
          if (bearingEl) {
            const dirs = ['شمال', 'شمال‌شرق', 'شرق', 'جنوب‌شرق', 'جنوب', 'جنوب‌غرب', 'غرب', 'شمال‌غرب'];
            const idx = Math.round(bearing / 45) % 8;
            bearingEl.textContent = `جهت: ${dirs[idx]}`;
          }

          // پنهان کردن راهنما وقتی فاصله کم شد
          if (hintEl) {
            hintEl.hidden = dist < 50;
          }
        },
        () => {},
        { enableHighAccuracy: true, maximumAge: 5000, timeout: 15000 }
      );
    }

    // ---------- Start AR ----------
    startBtn.addEventListener('click', async () => {
      hideError();

      // ۱. بررسی پشتیبانی
      const support = checkSupport();
      if (!support.supported) {
        if (unsupportedBox && unsupportedMsg) {
          unsupportedMsg.textContent = support.reason ?? '';
          unsupportedBox.hidden = false;
        }
        return;
      }

      // ۲. لود کتابخانه‌ها
      startBtn.disabled = true;
      startBtn.innerHTML = '<span>در حال بارگذاری…</span>';

      const loaded = await loadARLibs();
      if (!loaded) {
        showError('بارگذاری کتابخانه‌های AR با مشکل مواجه شد.');
        startBtn.disabled = false;
        startBtn.innerHTML = '<span aria-hidden="true">📸</span><span>شروع واقعیت افزوده</span>';
        return;
      }

      // ۳. درخواست مجوزها (بعد از کلیک کاربر — الزام iOS)
      try {
        // دوربین
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'environment' },
        });
        stream.getTracks().forEach((t) => t.stop());

        // DeviceOrientation (iOS 13+)
        const DOE = DeviceOrientationEvent as unknown as {
          requestPermission?: () => Promise<string>;
        };
        if (typeof DOE.requestPermission === 'function') {
          const perm = await DOE.requestPermission();
          if (perm !== 'granted') {
            showError('دسترسی به سنسور جهت‌یابی رد شد.');
            startBtn.disabled = false;
            startBtn.innerHTML = '<span aria-hidden="true">📸</span><span>شروع واقعیت افزوده</span>';
            return;
          }
        }
      } catch {
        showError('دسترسی به دوربین یا سنسور رد شد. لطفاً مجوزها را بررسی کنید.');
        startBtn.disabled = false;
        startBtn.innerHTML = '<span aria-hidden="true">📸</span><span>شروع واقعیت افزوده</span>';
        return;
      }

      // ۴. مخفی کردن پنل شروع، نمایش صحنه
      startPanel.hidden = true;
      sceneWrap.hidden = false;
      document.body.style.overflow = 'hidden';

      // ۵. شروع watch موقعیت
      const lat = parseFloat(sceneWrap.dataset.lat ?? '0') || window.__AR_LAT__ || 0;
      const lng = parseFloat(sceneWrap.dataset.lng ?? '0') || window.__AR_LNG__ || 0;
      startPositionWatch(lat, lng);
    });

    // ---------- Close AR ----------
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        sceneWrap.hidden = true;
        startPanel.hidden = false;
        document.body.style.overflow = '';
        if (watchId !== null) {
          navigator.geolocation.clearWatch(watchId);
          watchId = null;
        }
        startBtn.disabled = false;
        startBtn.innerHTML = '<span aria-hidden="true">📸</span><span>شروع واقعیت افزوده</span>';
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAR);
  } else {
    initAR();
  }
</script>