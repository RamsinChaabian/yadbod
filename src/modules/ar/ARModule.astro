---
import { config } from '../../utils/config';
import ARScene from './ARScene.astro';

const { location } = config;
---

<div class="px-4 py-6 max-w-3xl mx-auto">
  <header class="mb-6">
    <h2 class="text-2xl font-bold text-stone-800 mb-1">یافتن قبر با دوربین</h2>
    <p class="text-sm text-stone-500">با دوربین گوشی، مسیر رسیدن به قبر را ببینید.</p>
  </header>

  <div data-ar-start-panel class="space-y-5">
    <div class="aspect-video rounded-3xl bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 flex items-center justify-center relative overflow-hidden shadow-card">
      <div class="text-center px-4">
        <div class="text-6xl mb-3">📷</div>
        <p class="text-stone-700 font-semibold text-base">دوربین گوشی شما فعال می‌شود</p>
        <p class="text-stone-500 text-sm mt-1">برای مشاهده نشانگر قبر، دکمه‌ی زیر را بزنید</p>
      </div>
    </div>

    <button type="button" data-ar-start class="touch-target w-full inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold px-6 py-4 transition-all duration-300 hover:from-amber-600 hover:to-orange-600 shadow-button active:scale-[0.98] text-base">
      <span aria-hidden="true" class="text-xl">📸</span>
      <span>شروع واقعیت افزوده</span>
    </button>

    <div data-ar-unsupported hidden class="rounded-2xl bg-amber-50 border border-amber-200 p-4 text-sm" role="alert">
      <p data-ar-unsupported-msg class="text-stone-700"></p>
      <a href={location.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-2 text-amber-700 hover:text-amber-800 underline underline-offset-4 font-medium">
        📍 مسیریابی با Google Maps
      </a>
    </div>

    <div data-ar-error hidden class="rounded-2xl bg-red-50 border border-red-200 p-4 text-sm" role="alert">
      <p data-ar-error-msg class="text-red-700"></p>
      <button type="button" data-ar-retry class="mt-3 text-amber-700 hover:text-amber-800 underline underline-offset-4 font-medium">
        تلاش مجدد
      </button>
    </div>

    <div class="rounded-2xl bg-white border border-stone-200 p-5 shadow-card">
      <h3 class="text-sm font-bold text-stone-800 mb-3">راهنما</h3>
      <ul class="space-y-2 text-xs text-stone-600 leading-relaxed">
        <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">•</span><span>در فضای باز و با دید آسمان باز استفاده کنید</span></li>
        <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">•</span><span>گوشی را به آرامی بچرخانید تا نشانگر طلایی ظاهر شود</span></li>
        <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">•</span><span>فاصله و جهت در گوشه صفحه نمایش داده می‌شود</span></li>
        <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">•</span><span>برای عملکرد صحیح به HTTPS نیاز است</span></li>
      </ul>
    </div>
  </div>

  <ARScene />
</div>

<script>
  declare global {
    interface Window {
      __arCleanup?: () => void;
    }
  }

  // ---------- Check Support ----------
  function checkSupport(): { supported: boolean; reason?: string } {
    if (!window.isSecureContext) return { supported: false, reason: 'واقعیت افزوده فقط روی HTTPS کار می‌کند.' };
    if (!('geolocation' in navigator)) return { supported: false, reason: 'مرورگر شما از GPS پشتیبانی نمی‌کند.' };
    if (!('DeviceOrientationEvent' in window)) return { supported: false, reason: 'مرورگر شما از سنسور جهت‌یابی پشتیبانی نمی‌کند.' };
    if (!navigator.mediaDevices?.getUserMedia) return { supported: false, reason: 'مرورگر شما از دوربین پشتیبانی نمی‌کند.' };
    const ua = navigator.userAgent.toLowerCase();
    if (ua.includes('firefox')) return { supported: false, reason: 'Firefox از AR مبتنی بر مکان پشتیبانی نمی‌کند. لطفاً Chrome یا Safari استفاده کنید.' };
    return { supported: true };
  }

  // ---------- Distance / Bearing ----------
  function calcDistance(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 6371000;
    const toRad = (d: number) => (d * Math.PI) / 180;
    const dLat = toRad(lat2 - lat1);
    const dLon = toRad(lon2 - lon1);
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  function calcBearing(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const toRad = (d: number) => (d * Math.PI) / 180;
    const toDeg = (r: number) => (r * 180) / Math.PI;
    const dLon = toRad(lon2 - lon1);
    const y = Math.sin(dLon) * Math.cos(toRad(lat2));
    const x = Math.cos(toRad(lat1)) * Math.sin(toRad(lat2)) - Math.sin(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.cos(dLon);
    return (toDeg(Math.atan2(y, x)) + 360) % 360;
  }

  function formatDist(m: number): string {
    if (m < 1000) return `${Math.round(m)} متر`;
    return `${(m / 1000).toFixed(1)} کیلومتر`;
  }

  function initAR() {
    const startPanel = document.querySelector<HTMLElement>('[data-ar-start-panel]');
    const startBtn = document.querySelector<HTMLButtonElement>('[data-ar-start]');
    const sceneWrap = document.querySelector<HTMLElement>('[data-ar-scene]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-ar-close]');
    const distanceEl = document.querySelector<HTMLElement>('[data-ar-distance]');
    const bearingEl = document.querySelector<HTMLElement>('[data-ar-bearing]');
    const errorBox = document.querySelector<HTMLElement>('[data-ar-error]');
    const errorMsg = document.querySelector<HTMLElement>('[data-ar-error-msg]');
    const unsupportedBox = document.querySelector<HTMLElement>('[data-ar-unsupported]');
    const unsupportedMsg = document.querySelector<HTMLElement>('[data-ar-unsupported-msg]');
    const hintEl = document.querySelector<HTMLElement>('[data-ar-hint]');
    const retryBtn = document.querySelector<HTMLButtonElement>('[data-ar-retry]');

    if (!startBtn || !sceneWrap || !startPanel) return;

    function showError(msg: string) {
      if (errorBox && errorMsg) { errorMsg.textContent = msg; errorBox.hidden = false; }
    }
    function hideError() { if (errorBox) errorBox.hidden = true; }

    function resetStartButton() {
      if (!startBtn) return;
      startBtn.disabled = false;
      startBtn.innerHTML = '<span aria-hidden="true" class="text-xl">📸</span><span>شروع واقعیت افزوده</span>';
    }

    // ---------- Start AR ----------
    startBtn.addEventListener('click', async () => {
      hideError();

      const support = checkSupport();
      if (!support.supported) {
        if (unsupportedBox && unsupportedMsg) {
          unsupportedMsg.textContent = support.reason ?? '';
          unsupportedBox.hidden = false;
        }
        return;
      }

      startBtn.disabled = true;
      startBtn.innerHTML = '<span>در حال بارگذاری…</span>';

      try {
        // ---------- ۱. import three و locar ----------
        const THREE = await import('three');
        const LocAR = await import('locar');

        const app = new (LocAR as any).App({ cameraOptions: { hFov: 80 } });
        const locar = await app.start();

        // ---------- ۲. ثابت‌سازی ویدیو ----------
        await new Promise((r) => setTimeout(r, 500));
        const videoEl = document.querySelector('video');
        if (videoEl) {
          videoEl.muted = true;
          videoEl.setAttribute('muted', '');
          videoEl.setAttribute('playsinline', '');
          videoEl.setAttribute('webkit-playsinline', '');
          videoEl.style.setProperty('position', 'fixed', 'important');
          videoEl.style.setProperty('top', '0', 'important');
          videoEl.style.setProperty('left', '0', 'important');
          videoEl.style.setProperty('width', '100vw', 'important');
          videoEl.style.setProperty('height', '100vh', 'important');
          videoEl.style.setProperty('object-fit', 'cover', 'important');
          videoEl.style.setProperty('z-index', '1', 'important');
          try { await videoEl.play(); } catch { /* ignore */ }
        }

        // ثابت‌سازی canvas
        document.querySelectorAll('canvas').forEach((c) => {
          (c as HTMLElement).style.setProperty('position', 'fixed', 'important');
          (c as HTMLElement).style.setProperty('top', '0', 'important');
          (c as HTMLElement).style.setProperty('left', '0', 'important');
          (c as HTMLElement).style.setProperty('width', '100vw', 'important');
          (c as HTMLElement).style.setProperty('height', '100vh', 'important');
          (c as HTMLElement).style.setProperty('z-index', '2', 'important');
          (c as HTMLElement).style.setProperty('pointer-events', 'none');
          (c as HTMLElement).style.setProperty('background', 'transparent');
        });

        // ---------- ۳. GPS watch ----------
        await locar.startGps();

        // ---------- ۴. منتظر اولین fix GPS ----------
        const graveLat = parseFloat(sceneWrap.dataset.lat ?? '') || 32.0498053;
        const graveLng = parseFloat(sceneWrap.dataset.lng ?? '') || 48.8765405;

        await new Promise<void>((resolve) => {
          let done = false;
          const onGps = (e: any) => {
            if (done) return;
            const c = e.position?.coords;
            if (c && distanceEl && bearingEl) {
              const dist = calcDistance(c.latitude, c.longitude, graveLat, graveLng);
              const bearing = calcBearing(c.latitude, c.longitude, graveLat, graveLng);
              distanceEl.textContent = formatDist(dist);
              const dirs = ['شمال','شمال‌شرق','شرق','جنوب‌شرق','جنوب','جنوب‌غرب','غرب','شمال‌غرب'];
              bearingEl.textContent = `جهت: ${dirs[Math.round(bearing / 45) % 8]}`;
              if (hintEl) hintEl.hidden = dist < 50;
            }
            if (!done) {
              done = true;
              resolve();
            }
          };
          locar.on('gpsupdate', onGps);
          setTimeout(() => { if (!done) { done = true; resolve(); } }, 20000);
        });

        // ---------- ۵. اضافه کردن نشانگر ----------
        const group = new THREE.Group();

        const ring = new THREE.Mesh(
          new THREE.RingGeometry(0.8, 1.2, 32),
          new THREE.MeshBasicMaterial({ color: 0xE8833A, side: THREE.DoubleSide, transparent: true, opacity: 0.9 })
        );
        ring.rotation.x = -Math.PI / 2;
        ring.position.y = 0.05;
        group.add(ring);

        const cyl = new THREE.Mesh(
          new THREE.CylinderGeometry(0.15, 0.15, 3, 16),
          new THREE.MeshBasicMaterial({ color: 0xF5A623, transparent: true, opacity: 0.6 })
        );
        cyl.position.y = 1.5;
        group.add(cyl);

        locar.add(group, graveLng, graveLat, 0);

        // ---------- ۶. به‌روزرسانی مداوم HUD ----------
        locar.on('gpsupdate', (e: any) => {
          const c = e.position?.coords;
          if (!c || !distanceEl || !bearingEl) return;
          const dist = calcDistance(c.latitude, c.longitude, graveLat, graveLng);
          const bearing = calcBearing(c.latitude, c.longitude, graveLat, graveLng);
          distanceEl.textContent = formatDist(dist);
          const dirs = ['شمال','شمال‌شرق','شرق','جنوب‌شرق','جنوب','جنوب‌غرب','غرب','شمال‌غرب'];
          bearingEl.textContent = `جهت: ${dirs[Math.round(bearing / 45) % 8]}`;
          if (hintEl) hintEl.hidden = dist < 50;
        });

        // ---------- ۷. تابع cleanup ----------
        window.__arCleanup = () => {
          try { locar.stopGps(); } catch { /* ignore */ }
          document.querySelectorAll('video').forEach((v) => v.remove());
          document.querySelectorAll('canvas').forEach((c) => c.remove());
        };

        // ---------- ۸. نمایش صحنه ----------
        startPanel.hidden = true;
        sceneWrap.hidden = false;
        document.body.style.overflow = 'hidden';
      } catch (err: any) {
        const msg = err?.message || String(err);
        console.error('[AR] error:', err);
        showError(`خطا: ${msg}`);
        resetStartButton();
        // پاک‌سازی در صورت خطا
        document.querySelectorAll('video, canvas').forEach((el) => el.remove());
      }
    });

    // ---------- Close ----------
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        sceneWrap.hidden = true;
        startPanel.hidden = false;
        document.body.style.overflow = '';
        if (window.__arCleanup) {
          window.__arCleanup();
          window.__arCleanup = undefined;
        }
        resetStartButton();
        hideError();
      });
    }

    // ---------- Retry ----------
    if (retryBtn) {
      retryBtn.addEventListener('click', () => {
        hideError();
        startBtn.click();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAR);
  } else {
    initAR();
  }
</script>