---
import { config } from '../../utils/config';
import ARScene from './ARScene.astro';
import IPhoneGuide from './IPhoneGuide.astro';

const { location } = config;
---

<div class="py-2">
  <!-- سربرگ شیشه‌ای -->
  <header class="lg-card p-6 mb-5">
    <h2 class="text-xl font-bold text-stone-800 mb-1">یافتن قبر با دوربین</h2>
    <p class="text-sm text-stone-500">با دوربین گوشی، مسیر رسیدن به قبر را ببینید.</p>
  </header>

  <div data-ar-start-panel class="space-y-4">
    <!-- بنر هشدار آفلاین -->
    <div
      data-ar-offline-banner
      hidden
      class="lg-card p-4 flex items-start gap-3 border-amber-300/60"
      role="alert"
    >
      <span class="text-2xl shrink-0">📡</span>
      <div class="flex-1 min-w-0">
        <p class="text-amber-900 text-sm font-bold mb-1">شما آفلاین هستید</p>
        <p class="text-amber-800 text-xs leading-relaxed">
          برای دقت بالاتر GPS و تجربه بهتر واقعیت افزوده، اتصال اینترنت را روشن کنید.
          با این حال می‌توانید ادامه دهید.
        </p>
      </div>
    </div>

    <!-- راهنمای آیفون -->
    <IPhoneGuide />

    <!-- پیش‌نمایش دوربین -->
    <div class="lg-card p-2 overflow-hidden">
      <div class="aspect-video rounded-[24px] bg-gradient-to-br from-amber-50 to-orange-50 flex items-center justify-center relative overflow-hidden">
        <div class="text-center px-4">
          <div class="text-6xl mb-3">📷</div>
          <p class="text-stone-700 font-semibold text-base">دوربین گوشی شما فعال می‌شود</p>
          <p class="text-stone-500 text-sm mt-1">برای مشاهده نشانگر قبر، دکمه‌ی زیر را بزنید</p>
        </div>
      </div>
    </div>

    <!-- دکمه شروع -->
    <button
      type="button"
      data-ar-start
      class="lg-button-primary touch-target w-full inline-flex items-center justify-center gap-2 px-6 py-4 font-bold text-base"
    >
      <span aria-hidden="true" class="text-xl">📸</span>
      <span>شروع واقعیت افزوده</span>
    </button>

    <!-- عدم پشتیبانی -->
    <div data-ar-unsupported hidden class="lg-card p-4 text-sm border-amber-300/60" role="alert">
      <p data-ar-unsupported-msg class="text-stone-700"></p>
      <a
        href={location.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-2 text-amber-700 hover:text-amber-800 underline underline-offset-4 font-medium"
      >
        📍 مسیریابی با Google Maps
      </a>
    </div>

    <!-- راهنما -->
    <div class="lg-card p-5">
      <h3 class="text-sm font-bold text-stone-800 mb-3">راهنما</h3>
      <ul class="space-y-2 text-xs text-stone-600 leading-relaxed">
        <li class="flex items-start gap-2">
          <span class="text-amber-500 mt-0.5">•</span>
          <span>در فضای باز و با دید آسمان باز استفاده کنید</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-amber-500 mt-0.5">•</span>
          <span>گوشی را به آرامی بچرخانید تا نشانگر طلایی ظاهر شود</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-amber-500 mt-0.5">•</span>
          <span>فاصله و جهت در گوشه صفحه نمایش داده می‌شود</span>
        </li>
      </ul>
    </div>
  </div>

  <ARScene />
</div>

<script>
  declare global {
    interface Window {
      __arCleanup?: () => void;
    }
  }

  // ============================================================
  // محاسبات جغرافیایی
  // ============================================================
  function calcDistance(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 6371000;
    const toRad = (d: number) => (d * Math.PI) / 180;
    const dLat = toRad(lat2 - lat1);
    const dLon = toRad(lon2 - lon1);
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  function calcBearing(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const toRad = (d: number) => (d * Math.PI) / 180;
    const toDeg = (r: number) => (r * 180) / Math.PI;
    const dLon = toRad(lon2 - lon1);
    const y = Math.sin(dLon) * Math.cos(toRad(lat2));
    const x = Math.cos(toRad(lat1)) * Math.sin(toRad(lat2)) - Math.sin(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.cos(dLon);
    return (toDeg(Math.atan2(y, x)) + 360) % 360;
  }

  // ============================================================
  // بررسی GPS
  // ============================================================
  async function quickGpsCheck(): Promise<{ ok: boolean; accuracy?: number; message?: string }> {
    if (!('geolocation' in navigator)) {
      return { ok: false, message: 'مرورگر شما از GPS پشتیبانی نمی‌کند.' };
    }

    return new Promise((resolve) => {
      const timeoutId = setTimeout(() => {
        resolve({ ok: false, message: 'سیگنال GPS دریافت نشد. لطفاً به فضای باز بروید و دوباره تلاش کنید.' });
      }, 12000);

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          clearTimeout(timeoutId);
          const accuracy = pos.coords.accuracy;
          if (accuracy > 200) {
            resolve({
              ok: false,
              accuracy,
              message: `دقت موقعیت شما فقط ${Math.round(accuracy)} متر است، در حالی که GPS واقعی دقت زیر ۲۰ متر می‌دهد. لطفاً GPS گوشی را روشن کنید.`,
            });
            return;
          }
          resolve({ ok: true, accuracy });
        },
        (err) => {
          clearTimeout(timeoutId);
          if (err.code === 1) {
            resolve({ ok: false, message: 'دسترسی به موقعیت رد شده است. لطفاً در تنظیمات مرورگر مجوز بدهید.' });
          } else if (err.code === 2) {
            resolve({ ok: false, message: 'سرویس موقعیت (GPS) خاموش است. لطفاً آن را روشن کنید.' });
          } else {
            resolve({ ok: false, message: 'دریافت موقعیت طول کشید. به فضای باز بروید و دوباره تلاش کنید.' });
          }
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
      );
    });
  }

  // ============================================================
  // ساخت نشانگر سه‌بعدی (Beacon + Arrow)
  // ============================================================
  function buildBeacon(THREE: any) {
    const group = new THREE.Group();

    // ================================================
    // الف) نشانگر سینماتیک — برای فاصله > ۵۰۰ متر
    // ================================================
    const beaconGroup = new THREE.Group();
    group.add(beaconGroup);

    // ستون نور
    const columnGeo = new THREE.CylinderGeometry(0.12, 0.35, 5, 24, 1, true);
    const columnMat = new THREE.MeshBasicMaterial({
      color: 0xF5A623, transparent: true, opacity: 0.55,
      blending: THREE.AdditiveBlending, side: THREE.DoubleSide, depthWrite: false,
    });
    const column = new THREE.Mesh(columnGeo, columnMat);
    column.position.y = 2.5;
    beaconGroup.add(column);

    // الماس مرکزی
    const diamondGeo = new THREE.OctahedronGeometry(0.55, 0);
    const diamondMat = new THREE.MeshBasicMaterial({ color: 0xE8833A });
    const diamond = new THREE.Mesh(diamondGeo, diamondMat);
    diamond.position.y = 2.5;
    beaconGroup.add(diamond);

    // هاله درخشان
    const glowCanvas = document.createElement('canvas');
    glowCanvas.width = 128;
    glowCanvas.height = 128;
    const ctx = glowCanvas.getContext('2d')!;
    const grad = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    grad.addColorStop(0, 'rgba(245,166,35,0.9)');
    grad.addColorStop(0.4, 'rgba(232,131,58,0.5)');
    grad.addColorStop(1, 'rgba(232,131,58,0)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 128, 128);
    const glowTex = new THREE.CanvasTexture(glowCanvas);
    const glowMat = new THREE.SpriteMaterial({
      map: glowTex, transparent: true, opacity: 0.85,
      blending: THREE.AdditiveBlending, depthWrite: false,
    });
    const glow = new THREE.Sprite(glowMat);
    glow.scale.set(4, 4, 1);
    glow.position.y = 2.5;
    beaconGroup.add(glow);

    // حلقه‌ها
    const ring1 = new THREE.Mesh(
      new THREE.TorusGeometry(1.5, 0.08, 12, 48),
      new THREE.MeshBasicMaterial({ color: 0xE8833A, transparent: true, opacity: 0.9, blending: THREE.AdditiveBlending })
    );
    ring1.rotation.x = -Math.PI / 2;
    ring1.position.y = 0.05;
    beaconGroup.add(ring1);

    const ring2 = new THREE.Mesh(
      new THREE.TorusGeometry(1.0, 0.06, 12, 48),
      new THREE.MeshBasicMaterial({ color: 0xF5A623, transparent: true, opacity: 0.8, blending: THREE.AdditiveBlending })
    );
    ring2.position.y = 2.5;
    beaconGroup.add(ring2);

    const ring3 = new THREE.Mesh(
      new THREE.TorusGeometry(0.7, 0.04, 8, 32),
      new THREE.MeshBasicMaterial({ color: 0xFFD08A, transparent: true, opacity: 0.7, blending: THREE.AdditiveBlending })
    );
    ring3.position.y = 2.5;
    beaconGroup.add(ring3);

    // ================================================
    // ب) فلش رو به پایین — برای فاصله ≤ ۵۰۰ متر
    // ================================================
    const arrowGroup = new THREE.Group();
    group.add(arrowGroup);

    // بدنه‌ی فلش (شفت + تیغه) — با هم حرکت می‌کنند
    const arrowBody = new THREE.Group();
    arrowBody.position.y = 0;
    arrowGroup.add(arrowBody);

    // شفت (بالای فلش)
    const shaftGeo = new THREE.CylinderGeometry(0.16, 0.16, 0.9, 16);
    const shaftMat = new THREE.MeshBasicMaterial({ color: 0xFFD08A });
    const shaft = new THREE.Mesh(shaftGeo, shaftMat);
    shaft.position.y = 3.0;
    arrowBody.add(shaft);

    // تیغه (مخروط رو به پایین)
    const coneGeo = new THREE.ConeGeometry(0.7, 1.5, 32);
    const coneMat = new THREE.MeshBasicMaterial({
      color: 0xE8833A,
      transparent: true,
      opacity: 1,
    });
    const cone = new THREE.Mesh(coneGeo, coneMat);
    cone.rotation.z = Math.PI;
    cone.position.y = 1.75;
    arrowBody.add(cone);

    // هاله‌ی درخشان پشت فلش
    const arrowGlowCanvas = document.createElement('canvas');
    arrowGlowCanvas.width = 128;
    arrowGlowCanvas.height = 128;
    const actx = arrowGlowCanvas.getContext('2d')!;
    const agrad = actx.createRadialGradient(64, 64, 0, 64, 64, 64);
    agrad.addColorStop(0, 'rgba(255,215,100,0.95)');
    agrad.addColorStop(0.4, 'rgba(232,131,58,0.5)');
    agrad.addColorStop(1, 'rgba(232,131,58,0)');
    actx.fillStyle = agrad;
    actx.fillRect(0, 0, 128, 128);
    const arrowGlowTex = new THREE.CanvasTexture(arrowGlowCanvas);
    const arrowGlowMat = new THREE.SpriteMaterial({
      map: arrowGlowTex,
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const arrowGlow = new THREE.Sprite(arrowGlowMat);
    arrowGlow.scale.set(3.2, 3.2, 1);
    arrowGlow.position.y = 2.0;
    arrowGroup.add(arrowGlow);

    // حلقه‌ی کوچک روی زمین
    const arrowRing = new THREE.Mesh(
      new THREE.TorusGeometry(1.0, 0.06, 12, 48),
      new THREE.MeshBasicMaterial({
        color: 0xE8833A,
        transparent: true,
        opacity: 0.85,
        blending: THREE.AdditiveBlending,
      })
    );
    arrowRing.rotation.x = -Math.PI / 2;
    arrowRing.position.y = 0.05;
    arrowGroup.add(arrowRing);

    // در ابتدا فقط beacon نمایش داده می‌شود
    arrowGroup.visible = false;

    return {
      group,
      beaconGroup,
      arrowGroup,
      // beacon items
      column,
      diamond,
      glow,
      ring1,
      ring2,
      ring3,
      columnMat,
      glowMat,
      // arrow items
      arrowBody,
      shaft,
      cone,
      coneMat,
      arrowGlow,
      arrowGlowMat,
      arrowRing,
    };
  }

  // ============================================================
  // مقیاس نشانگر سینماتیک (فاصله > ۵۰۰ متر)
  // ============================================================
  function calcBeaconScale(actualDist: number): number {
    const NEAR = 500;
    const FAR = 1500;
    const MAX_SCALE = 1.4;
    const MIN_SCALE = 0.4;

    if (actualDist <= NEAR) return MAX_SCALE;
    if (actualDist >= FAR) return MIN_SCALE;

    const t = (actualDist - NEAR) / (FAR - NEAR);
    const eased = 1 - (1 - t) * (1 - t);
    return MAX_SCALE - eased * (MAX_SCALE - MIN_SCALE);
  }

  // ============================================================
  // مقیاس فلش رو به پایین (فاصله ≤ ۵۰۰ متر)
  // ============================================================
  function calcArrowScale(actualDist: number): number {
    const NEAR = 20;
    const FAR = 500;
    const MAX_SCALE = 1.6;
    const MIN_SCALE = 0.7;

    if (actualDist <= NEAR) return MAX_SCALE;
    if (actualDist >= FAR) return MIN_SCALE;

    const t = (actualDist - NEAR) / (FAR - NEAR);
    const eased = 1 - (1 - t) * (1 - t);
    return MAX_SCALE - eased * (MAX_SCALE - MIN_SCALE);
  }

  // ============================================================
  // Init AR
  // ============================================================
  function initAR() {
    const startPanel = document.querySelector<HTMLElement>('[data-ar-start-panel]');
    const startBtn = document.querySelector<HTMLButtonElement>('[data-ar-start]');
    const sceneWrap = document.querySelector<HTMLElement>('[data-ar-scene]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-ar-close]');
    const distanceEl = document.querySelector<HTMLElement>('[data-ar-distance]');
    const distanceUnitEl = document.querySelector<HTMLElement>('[data-ar-distance-unit]');
    const bearingEl = document.querySelector<HTMLElement>('[data-ar-bearing]');
    const arrowEl = document.querySelector<HTMLElement>('[data-ar-arrow]');
    const pulseDot = document.querySelector<HTMLElement>('[data-ar-pulse-dot]');
    const hintText = document.querySelector<HTMLElement>('[data-ar-hint-text]');
    const errorBox = document.querySelector<HTMLElement>('[data-ar-error]');
    const errorMsg = document.querySelector<HTMLElement>('[data-ar-error-msg]');
    const gpsOffBox = document.querySelector<HTMLElement>('[data-ar-gps-off]');
    const gpsOffMsg = document.querySelector<HTMLElement>('[data-ar-gps-off-msg]');
    const gpsRetryBtn = document.querySelector<HTMLButtonElement>('[data-ar-gps-retry]');
    const gpsCloseBtn = document.querySelector<HTMLButtonElement>('[data-ar-gps-close]');
    const retryBtn = document.querySelector<HTMLButtonElement>('[data-ar-retry]');
    const accuracyEl = document.querySelector<HTMLElement>('[data-ar-accuracy]');
    const accuracyDot = document.querySelector<HTMLElement>('[data-ar-accuracy-dot]');
    const accuracyWarn = document.querySelector<HTMLElement>('[data-ar-accuracy-warn]');
    const groundIndicator = document.querySelector<HTMLElement>('[data-ar-ground-indicator]');

    const loadingEl = document.querySelector<HTMLElement>('[data-ar-loading]');
    const loadingText = document.querySelector<HTMLElement>('[data-ar-loading-text]');
    const loadingHint = document.querySelector<HTMLElement>('[data-ar-loading-hint]');
    const loadingIcon = document.querySelector<HTMLElement>('[data-ar-loading-icon]');
    const loadingProgress = document.querySelector<HTMLElement>('[data-ar-loading-progress]');
    const loadingTimer = document.querySelector<HTMLElement>('[data-ar-loading-timer]');

    const offlineBanner = document.querySelector<HTMLElement>('[data-ar-offline-banner]');
    const offlineIndicator = document.querySelector<HTMLElement>('[data-ar-offline-indicator]');

    if (!startBtn || !sceneWrap || !startPanel) return;

    const graveLat = parseFloat(sceneWrap.dataset.lat ?? '') || 32.0498053;
    const graveLng = parseFloat(sceneWrap.dataset.lng ?? '') || 48.8765405;
    const dirs = ['شمال', 'شمال‌شرق', 'شرق', 'جنوب‌شرق', 'جنوب', 'جنوب‌غرب', 'غرب', 'شمال‌غرب'];

    // ============================================================
    // وضعیت آفلاین/آنلاین
    // ============================================================
    function updateOfflineStatus() {
      const isOnline = navigator.onLine;
      if (offlineBanner) offlineBanner.hidden = isOnline;
      if (offlineIndicator) offlineIndicator.hidden = isOnline;
    }
    updateOfflineStatus();
    window.addEventListener('online', updateOfflineStatus);
    window.addEventListener('offline', updateOfflineStatus);

    // ============================================================
    // Loading helpers
    // ============================================================
    let loadingTimerId: number | null = null;
    let loadingStartTime = 0;

    function showLoading(icon: string, text: string, hint: string, progress: number) {
      if (!loadingEl) return;
      loadingEl.hidden = false;
      if (loadingIcon) loadingIcon.textContent = icon;
      if (loadingText) loadingText.textContent = text;
      if (loadingHint) loadingHint.textContent = hint;
      if (loadingProgress) loadingProgress.style.width = `${progress}%`;
      if (loadingStartTime === 0) loadingStartTime = Date.now();
    }

    function updateLoading(icon: string, text: string, hint: string, progress: number) {
      if (!loadingEl || loadingEl.hidden) {
        showLoading(icon, text, hint, progress);
        return;
      }
      if (loadingIcon) loadingIcon.textContent = icon;
      if (loadingText) loadingText.textContent = text;
      if (loadingHint) loadingHint.textContent = hint;
      if (loadingProgress) loadingProgress.style.width = `${progress}%`;
    }

    function hideLoading() {
      if (loadingEl) loadingEl.hidden = true;
      if (loadingTimerId) {
        clearInterval(loadingTimerId);
        loadingTimerId = null;
      }
      loadingStartTime = 0;
      if (loadingTimer) loadingTimer.textContent = '';
    }

    function startLoadingTimer() {
      loadingStartTime = Date.now();
      if (loadingTimerId) clearInterval(loadingTimerId);
      loadingTimerId = window.setInterval(() => {
        const sec = Math.floor((Date.now() - loadingStartTime) / 1000);
        if (loadingTimer) loadingTimer.textContent = `${sec} ثانیه گذشته`;
      }, 500);
    }

    function stopLoadingTimer() {
      if (loadingTimerId) {
        clearInterval(loadingTimerId);
        loadingTimerId = null;
      }
    }

    // ============================================================
    // Helpers
    // ============================================================
    function showError(msg: string) {
      if (errorBox && errorMsg) { errorMsg.textContent = msg; errorBox.hidden = false; }
    }
    function hideError() { if (errorBox) errorBox.hidden = true; }
    function showGpsOff(message?: string) {
      if (gpsOffMsg && message) gpsOffMsg.textContent = message;
      if (gpsOffBox) gpsOffBox.hidden = false;
    }
    function hideGpsOff() { if (gpsOffBox) gpsOffBox.hidden = true; }

    function resetStartButton() {
      if (!startBtn) return;
      startBtn.disabled = false;
      startBtn.innerHTML = '<span aria-hidden="true" class="text-xl">📸</span><span>شروع واقعیت افزوده</span>';
    }

    // ============================================================
    // به‌روزرسانی HUD
    // ============================================================
    function updateHUD(lat: number, lng: number, cameraHeading?: number, accuracy?: number) {
      const dist = calcDistance(lat, lng, graveLat, graveLng);
      const bearing = calcBearing(lat, lng, graveLat, graveLng);

      if (distanceEl && distanceUnitEl) {
        if (dist < 1000) {
          distanceEl.textContent = String(Math.round(dist));
          distanceUnitEl.textContent = 'متر';
        } else {
          distanceEl.textContent = (dist / 1000).toFixed(1);
          distanceUnitEl.textContent = 'کیلومتر';
        }
      }

      if (bearingEl) bearingEl.textContent = dirs[Math.round(bearing / 45) % 8];

      if (arrowEl && cameraHeading !== undefined) {
        const rel = ((bearing - cameraHeading) + 360) % 360;
        arrowEl.style.transform = `rotate(${rel}deg)`;
        if (rel < 30 || rel > 330) {
          arrowEl.classList.add('aligned');
        } else {
          arrowEl.classList.remove('aligned');
        }
      }

      if (hintText) {
        if (dist < 30) {
          hintText.textContent = 'به قبر بسیار نزدیک هستید — فلش رو به پایین را ببینید';
          if (pulseDot) pulseDot.style.background = '#4ade80';
        } else if (dist < 500) {
          hintText.textContent = 'به محل قبر نزدیک شدید — فلش رو به پایین را دنبال کنید';
          if (pulseDot) pulseDot.style.background = '#4ade80';
        } else if (dist < 2000) {
          hintText.textContent = 'نزدیک می‌شوید! نشانگر طلایی را دنبال کنید';
          if (pulseDot) pulseDot.style.background = '#fbbf24';
        } else {
          hintText.textContent = 'گوشی را به سمت فلش بچرخانید تا نشانگر ظاهر شود';
          if (pulseDot) pulseDot.style.background = '#f5a623';
        }
      }

      if (accuracyEl && accuracyDot && accuracy !== undefined) {
        accuracyEl.textContent = `${Math.round(accuracy)} م`;
        let color = '#9ca3af';
        if (accuracy < 30) color = '#4ade80';
        else if (accuracy < 100) color = '#fbbf24';
        else color = '#ef4444';

        accuracyDot.style.background = color;
        accuracyEl.style.color = color;

        if (accuracyWarn) accuracyWarn.hidden = accuracy <= 100;
      }
    }

    // ============================================================
    // Start AR
    // ============================================================
    startBtn.addEventListener('click', async () => {
      hideError();
      hideGpsOff();

      startBtn.disabled = true;
      startBtn.innerHTML = '<span>در حال آماده‌سازی…</span>';

      sceneWrap.hidden = false;
      showLoading('📡', 'در حال بررسی موقعیت مکانی…', 'لطفاً صبر کنید', 10);
      startLoadingTimer();

      const gpsCheck = await quickGpsCheck();
      if (!gpsCheck.ok) {
        stopLoadingTimer();
        hideLoading();
        sceneWrap.hidden = true;
        startBtn.disabled = false;
        resetStartButton();
        showGpsOff(gpsCheck.message);
        return;
      }

      const initialAccuracy = gpsCheck.accuracy;

      try {
        updateLoading('⚙️', 'در حال بارگذاری موتور AR…', 'لطفاً صبر کنید', 25);

        const THREE = await import('three');
        const LocAR = await import('locar');

        updateLoading('📷', 'در حال راه‌اندازی دوربین…', 'اجازه دسترسی به دوربین را بدهید', 40);

        const app = new (LocAR as any).App({ cameraOptions: { hFov: 80 } });
        const locar = await app.start();

        await new Promise((r) => setTimeout(r, 500));
        const videoEl = document.querySelector('video');
        if (videoEl) {
          videoEl.muted = true;
          videoEl.setAttribute('muted', '');
          videoEl.setAttribute('playsinline', '');
          videoEl.setAttribute('webkit-playsinline', '');
          videoEl.style.setProperty('position', 'fixed', 'important');
          videoEl.style.setProperty('top', '0', 'important');
          videoEl.style.setProperty('left', '0', 'important');
          videoEl.style.setProperty('width', '100vw', 'important');
          videoEl.style.setProperty('height', '100vh', 'important');
          videoEl.style.setProperty('object-fit', 'cover', 'important');
          videoEl.style.setProperty('z-index', '1', 'important');
          try { await videoEl.play(); } catch { /* ignore */ }
        }

        document.querySelectorAll('canvas').forEach((c) => {
          const el = c as HTMLElement;
          el.style.setProperty('position', 'fixed', 'important');
          el.style.setProperty('top', '0', 'important');
          el.style.setProperty('left', '0', 'important');
          el.style.setProperty('width', '100vw', 'important');
          el.style.setProperty('height', '100vh', 'important');
          el.style.setProperty('z-index', '2', 'important');
          el.style.setProperty('pointer-events', 'none');
          el.style.setProperty('background', 'transparent');
        });

        updateLoading('🛰️', 'در حال اتصال به GPS…', 'دریافت سیگنال از ماهواره‌ها', 60);

        await locar.startGps();

        updateLoading('📍', 'در حال دریافت موقعیت دقیق…', 'این ممکن است ۱۰ تا ۳۰ ثانیه طول بکشد. لطفاً صبر کنید و صفحه را نبندید', 75);

        let firstFixTimeout = false;
        await new Promise<void>((resolve) => {
          let done = false;
          const onFirstGps = (e: any) => {
            if (done) return;
            const c = e.position?.coords;
            if (!c) return;
            done = true;
            console.log('[AR] first GPS fix:', c.latitude, c.longitude, 'accuracy:', c.accuracy);
            locar.off('gpsupdate', onFirstGps);
            resolve();
          };
          locar.on('gpsupdate', onFirstGps);
          setTimeout(() => {
            if (!done) {
              done = true;
              firstFixTimeout = true;
              console.log('[AR] GPS fix timeout — continuing anyway');
              resolve();
            }
          }, 20000);
        });

        if (firstFixTimeout) {
          console.log('[AR] continuing without GPS fix');
        }

        updateLoading('✨', 'در حال ساخت نشانگر سه‌بعدی…', 'چند لحظه دیگر آماده می‌شود', 90);

        const beacon = buildBeacon(THREE);
        locar.scene.add(beacon.group);
        beacon.group.visible = false;

        let cameraHeadingDeg = 0;
        let lastLat: number | null = null;
        let lastLng: number | null = null;
        let lastAccuracy: number | undefined = initialAccuracy;
        let lastUpdateTime = 0;

        // حالت فعلی — با hysteresis از فلش‌زدن جلوگیری می‌کند
        let isArrowMode = false;

        const onGps = (e: any) => {
          const c = e.position?.coords;
          if (!c) return;
          lastLat = c.latitude;
          lastLng = c.longitude;
          lastAccuracy = c.accuracy;
          updateHUD(c.latitude, c.longitude, cameraHeadingDeg, c.accuracy);
        };
        locar.on('gpsupdate', onGps);

        const tmpVec = new THREE.Vector3();
        const upVec = new THREE.Vector3(0, 0, -1);
        let running = true;
        const startTime = performance.now();

        function tick() {
          if (!running) return;
          requestAnimationFrame(tick);

          const t = (performance.now() - startTime) / 1000;

          // ---------- انیمیشن‌های Beacon ----------
          beacon.ring1.rotation.z = t * 0.6;
          beacon.ring2.rotation.z = -t * 1.2;
          beacon.ring2.rotation.x = Math.sin(t * 0.5) * 0.4;
          beacon.ring3.rotation.y = t * 1.8;
          beacon.ring3.rotation.x = t * 0.9;

          const pulse = 1 + Math.sin(t * 3) * 0.18;
          beacon.diamond.scale.setScalar(pulse);
          beacon.diamond.rotation.y = t * 1.5;
          beacon.diamond.rotation.x = Math.sin(t * 0.8) * 0.3;

          const glowPulse = 1 + Math.sin(t * 2) * 0.25;
          beacon.glow.scale.set(4 * glowPulse, 4 * glowPulse, 1);
          beacon.glowMat.opacity = 0.6 + Math.sin(t * 2) * 0.25;

          beacon.columnMat.opacity = 0.4 + Math.sin(t * 1.5) * 0.2;

          // ---------- انیمیشن فلش رو به پایین ----------
          const arrowBob = Math.sin(t * 2.2) * 0.35;
          beacon.arrowBody.position.y = arrowBob;
          beacon.arrowGlow.position.y = 2.0 + arrowBob;

          const arrowGlowPulse = 1 + Math.sin(t * 3.5) * 0.22;
          beacon.arrowGlow.scale.set(3.2 * arrowGlowPulse, 3.2 * arrowGlowPulse, 1);
          beacon.arrowGlowMat.opacity = 0.65 + Math.sin(t * 3.5) * 0.3;

          beacon.arrowRing.rotation.z = t * 0.4;

          beacon.coneMat.opacity = 0.85 + Math.sin(t * 2.2) * 0.15;

          // ---------- موقعیت‌یابی + مقیاس ----------
          if (lastLat !== null && lastLng !== null) {
            const camera = locar.camera;

            const [gx, gz] = locar.lonLatToWorldCoords(graveLng, graveLat);
            tmpVec.set(gx, 0, gz);

            const dir = tmpVec.clone().sub(camera.position);
            const actualDist = dir.length();
            dir.normalize();

            upVec.set(0, 0, -1).applyQuaternion(camera.quaternion);
            const dot = upVec.dot(dir);

            const inView = dot > 0.5 || actualDist < 30;
            beacon.group.visible = inView;

            if (inView) {
              const VIRTUAL_DIST = Math.min(actualDist, 8);
              const targetPos = camera.position.clone().add(dir.clone().multiplyScalar(VIRTUAL_DIST));
              targetPos.y = 0;
              beacon.group.position.lerp(targetPos, 0.2);

              // تعیین حالت (با hysteresis)
              if (!isArrowMode && actualDist < 480) {
                isArrowMode = true;
              } else if (isArrowMode && actualDist > 520) {
                isArrowMode = false;
              }

              beacon.beaconGroup.visible = !isArrowMode;
              beacon.arrowGroup.visible = isArrowMode;

              const targetScale = isArrowMode
                ? calcArrowScale(actualDist)
                : calcBeaconScale(actualDist);
              const currentScale = beacon.group.scale.x;
              const newScale = currentScale + (targetScale - currentScale) * 0.08;
              beacon.group.scale.setScalar(newScale);
            } else {
              beacon.beaconGroup.visible = false;
              beacon.arrowGroup.visible = false;
            }

            // heading دوربین
            upVec.set(0, 0, -1).applyQuaternion(camera.quaternion);
            const cameraHeadingRad = Math.atan2(upVec.x, -upVec.z);
            const headingDeg = ((cameraHeadingRad * 180 / Math.PI) + 360) % 360;

            if (arrowEl) {
              const bearing = calcBearing(lastLat, lastLng, graveLat, graveLng);
              const rel = ((bearing - headingDeg) + 360) % 360;
              arrowEl.style.transform = `rotate(${rel}deg)`;
              if (rel < 30 || rel > 330) {
                arrowEl.classList.add('aligned');
              } else {
                arrowEl.classList.remove('aligned');
              }
            }

            if (groundIndicator) {
              groundIndicator.hidden = actualDist > 30;
            }

            const now = performance.now();
            if (now - lastUpdateTime > 100) {
              lastUpdateTime = now;
              cameraHeadingDeg = headingDeg;
              updateHUD(lastLat, lastLng, cameraHeadingDeg, lastAccuracy);
            }
          }
        }
        tick();

        window.__arCleanup = () => {
          running = false;
          try { locar.stopGps(); } catch { /* ignore */ }
          try { locar.scene.remove(beacon.group); } catch { /* ignore */ }
          document.querySelectorAll('video').forEach((v) => v.remove());
          document.querySelectorAll('canvas').forEach((c) => c.remove());
          if (groundIndicator) groundIndicator.hidden = true;
        };

        updateLoading('✅', 'آماده!', 'به اطراف نگاه کنید', 100);
        await new Promise((r) => setTimeout(r, 400));
        stopLoadingTimer();
        hideLoading();

        startPanel.hidden = true;
        document.body.style.overflow = 'hidden';
      } catch (err: any) {
        stopLoadingTimer();
        hideLoading();
        const msg = err?.message || String(err);
        console.error('[AR] error:', err);
        showError(`خطا: ${msg}`);
        resetStartButton();
        sceneWrap.hidden = true;
        document.querySelectorAll('video, canvas').forEach((el) => el.remove());
      }
    });

    if (gpsRetryBtn) {
      gpsRetryBtn.addEventListener('click', () => {
        hideGpsOff();
        resetStartButton();
        startBtn.click();
      });
    }
    if (gpsCloseBtn) {
      gpsCloseBtn.addEventListener('click', () => hideGpsOff());
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        sceneWrap.hidden = true;
        startPanel.hidden = false;
        document.body.style.overflow = '';
        if (window.__arCleanup) {
          window.__arCleanup();
          window.__arCleanup = undefined;
        }
        resetStartButton();
        hideError();
        hideGpsOff();
        hideLoading();
      });
    }

    if (retryBtn) {
      retryBtn.addEventListener('click', () => {
        hideError();
        startBtn.click();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAR);
  } else {
    initAR();
  }
</script>