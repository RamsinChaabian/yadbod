---
import { config } from '../../utils/config';
const { location } = config;
---

<div
  data-ar-scene
  data-lat={location.latitude}
  data-lng={location.longitude}
  hidden
  class="fixed inset-0 z-[200]"
>
  <!-- راهنمای جهت (فلش طلایی) -->
  <div
    data-ar-compass
    class="absolute top-[38%] inset-x-0 z-40 pointer-events-none flex justify-center"
  >
    <div data-ar-arrow class="transition-transform duration-200" style="transform: rotate(0deg);">
      <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
        <defs>
          <linearGradient id="arrowGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#F5A623"/>
            <stop offset="1" stop-color="#E8833A"/>
          </linearGradient>
          <filter id="arrowGlow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="2" result="blur"/>
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>
        <path d="M30 8 L42 32 L30 26 L18 32 Z" fill="url(#arrowGrad)" filter="url(#arrowGlow)"/>
      </svg>
    </div>
  </div>

  <!-- HUD زنده با انیمیشن نبض -->
  <div
    data-ar-hud
    class="absolute top-4 start-4 z-30 rounded-3xl overflow-hidden shadow-2xl"
  >
    <div class="relative bg-gradient-to-br from-stone-900/95 via-stone-800/95 to-stone-900/95 backdrop-blur-2xl border border-amber-400/40 px-5 py-4 min-w-[210px]">
      <!-- ذرات نورانی -->
      <div class="absolute inset-0 overflow-hidden rounded-3xl pointer-events-none">
        <div class="absolute -top-8 -end-8 w-24 h-24 bg-amber-500/20 rounded-full blur-2xl"></div>
        <div class="absolute -bottom-8 -start-8 w-20 h-20 bg-orange-500/15 rounded-full blur-2xl"></div>
      </div>

      <div class="relative">
        <!-- لیبل -->
        <div class="flex items-center gap-2 mb-2">
          <span data-ar-pulse-dot class="w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(245,166,35,0.9)]"></span>
          <p class="text-amber-200/80 text-[10px] font-medium tracking-wider uppercase">فاصله تا قبر</p>
        </div>

        <!-- فاصله -->
        <div class="flex items-baseline gap-1">
          <p data-ar-distance class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-orange-400 font-black text-3xl tabular-nums leading-none">—</p>
          <span data-ar-distance-unit class="text-amber-200/60 text-xs font-medium"></span>
        </div>

        <!-- جداکننده -->
        <div class="my-3 h-px bg-gradient-to-r from-transparent via-amber-400/40 to-transparent"></div>

        <!-- جهت -->
        <div class="flex items-center justify-between mb-2">
          <p class="text-stone-400 text-[10px]">جهت</p>
          <p data-ar-bearing class="text-amber-200 text-xs font-bold">—</p>
        </div>

        <!-- دقت GPS -->
        <div class="pt-2 border-t border-amber-400/20 flex items-center justify-between">
          <p class="text-stone-400 text-[10px]">دقت GPS</p>
          <div class="flex items-center gap-1.5">
            <span data-ar-accuracy-dot class="w-2 h-2 rounded-full bg-stone-500"></span>
            <p data-ar-accuracy class="text-xs font-bold tabular-nums text-stone-300">—</p>
          </div>
        </div>

        <!-- هشدار دقت پایین -->
        <div data-ar-accuracy-warn hidden class="mt-3 rounded-xl bg-red-500/15 border border-red-500/40 px-3 py-2">
          <p class="text-red-200 text-[11px] leading-relaxed">
            ⚠️ دقت موقعیت پایین است. برای نتایج بهتر، GPS گوشی را روشن کنید.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- دکمه بستن با انیمیشن چرخش -->
  <button
    type="button"
    data-ar-close
    aria-label="بستن واقعیت افزوده"
    class="absolute top-4 end-4 z-30 w-12 h-12 rounded-full bg-stone-900/80 backdrop-blur-xl border border-amber-400/40 text-amber-200 flex items-center justify-center hover:bg-amber-500 hover:text-stone-900 hover:border-amber-500 hover:rotate-90 transition-all duration-300 shadow-xl touch-target"
  >
    <span aria-hidden="true" class="text-lg font-bold">✕</span>
  </button>

  <!-- پیام راهنما با انیمیشن شناور -->
  <div
    data-ar-hint
    class="absolute bottom-24 inset-x-4 z-30 rounded-3xl bg-gradient-to-r from-stone-900/90 via-stone-800/90 to-stone-900/90 backdrop-blur-2xl border border-amber-400/30 px-5 py-4 text-center shadow-2xl"
    style="animation: float 3s ease-in-out infinite;"
  >
    <div class="flex items-center justify-center gap-3">
      <div class="flex gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse" style="animation-delay: 0.2s"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse" style="animation-delay: 0.4s"></span>
      </div>
      <p data-ar-hint-text class="text-amber-100 text-xs font-medium">
        گوشی را به آرامی بچرخانید تا نشانگر ظاهر شود
      </p>
    </div>
  </div>

  <!-- لایه خطای GPS -->
  <div
    data-ar-gps-off
    hidden
    class="absolute inset-x-4 top-1/2 -translate-y-1/2 z-50 rounded-3xl bg-gradient-to-br from-stone-900 to-stone-800 border-2 border-amber-500/50 p-6 shadow-2xl max-w-md mx-auto"
  >
    <div class="text-center">
      <div class="text-6xl mb-4">📡</div>
      <h3 class="text-amber-300 text-lg font-bold mb-2">سرویس موقعیت غیرفعال است</h3>
      <p class="text-stone-300 text-sm leading-relaxed mb-5">
        برای یافتن قبر، نیاز به دسترسی به موقعیت مکانی دارید. لطفاً GPS و مجوز موقعیت را فعال کنید.
      </p>
      <div class="space-y-2 text-start bg-stone-950/50 rounded-2xl p-4 mb-5">
        <p class="text-amber-200 text-xs font-bold mb-2">راهنما:</p>
        <p class="text-stone-400 text-xs leading-relaxed">
          ۱. تنظیمات گوشی → موقعیت مکانی → روشن
        </p>
        <p class="text-stone-400 text-xs leading-relaxed">
          ۲. تنظیمات مرورگر → مجوزها → موقعیت → اجازه
        </p>
        <p class="text-stone-400 text-xs leading-relaxed">
          ۳. اگر VPN فعال است، آن را خاموش کنید
        </p>
      </div>
      <div class="flex gap-3">
        <button
          type="button"
          data-ar-gps-retry
          class="flex-1 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold py-3 px-4 hover:from-amber-600 hover:to-orange-600 transition-all shadow-lg active:scale-95"
        >
          تلاش مجدد
        </button>
        <button
          type="button"
          data-ar-gps-close
          class="rounded-2xl bg-stone-800 text-stone-300 font-medium py-3 px-4 hover:bg-stone-700 transition-all"
        >
          بستن
        </button>
      </div>
    </div>
  </div>

  <!-- پیام خطای عمومی -->
  <div
    data-ar-error
    hidden
    class="absolute inset-x-4 top-1/2 -translate-y-1/2 z-50 rounded-3xl bg-gradient-to-br from-red-950/95 to-red-900/95 border border-red-500/50 p-6 shadow-2xl max-w-md mx-auto"
    role="alert"
  >
    <div class="text-center">
      <div class="text-5xl mb-3">⚠️</div>
      <p data-ar-error-msg class="text-red-100 text-sm leading-relaxed mb-4"></p>
      <button
        type="button"
        data-ar-retry
        class="rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold py-3 px-6 hover:from-amber-600 hover:to-orange-600 transition-all shadow-lg active:scale-95"
      >
        تلاش مجدد
      </button>
    </div>
  </div>
</div>

<style is:global>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-4px); }
  }
</style>