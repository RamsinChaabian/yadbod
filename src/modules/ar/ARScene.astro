---
import { config } from '../../utils/config';
const { location } = config;
---

<div
  data-ar-scene
  data-lat={location.latitude}
  data-lng={location.longitude}
  hidden
  class="fixed inset-0 z-[200]"
>
  <!-- فلش راهنمای سینمایی -->
  <div
    data-ar-compass
    class="absolute top-[32%] inset-x-0 z-40 pointer-events-none flex justify-center"
  >
    <div class="ar-arrow-float">
      <div data-ar-arrow class="ar-arrow-rotate" style="transform: rotate(0deg);">
        <div data-ar-arrow-glow class="ar-arrow-glow"></div>
        <svg width="72" height="72" viewBox="0 0 72 72" fill="none" class="relative z-10">
          <defs>
            <linearGradient id="arrowGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#FFD08A"/>
              <stop offset="0.5" stop-color="#F5A623"/>
              <stop offset="1" stop-color="#E8833A"/>
            </linearGradient>
            <filter id="arrowGlow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="3" result="blur"/>
              <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>
          <path d="M36 6 L50 38 L36 30 L22 38 Z" fill="url(#arrowGrad)" filter="url(#arrowGlow)"/>
          <path d="M36 6 L50 38 L36 30 Z" fill="#FFFFFF" opacity="0.15"/>
        </svg>
        <div data-ar-arrow-beam class="ar-arrow-beam"></div>
      </div>
    </div>
  </div>

  <!-- HUD — شیشه‌ی تیره -->
  <div data-ar-hud class="absolute top-4 start-4 z-30 lg-dark overflow-hidden" style="border-radius: 28px;">
    <div class="px-5 py-4 min-w-[210px] relative">
      <!-- ذرات نورانی -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none" style="border-radius: 28px;">
        <div class="absolute -top-8 -end-8 w-24 h-24 bg-amber-500/20 rounded-full blur-2xl"></div>
        <div class="absolute -bottom-8 -start-8 w-20 h-20 bg-orange-500/15 rounded-full blur-2xl"></div>
      </div>

      <div class="relative">
        <!-- فاصله -->
        <div class="flex items-center gap-2 mb-2">
          <span data-ar-pulse-dot class="w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(245,166,35,0.9)]"></span>
          <p class="text-amber-200/80 text-[10px] font-medium tracking-wider uppercase">فاصله تا قبر</p>
        </div>

        <div class="flex items-baseline gap-1">
          <p data-ar-distance class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-orange-400 font-black text-3xl tabular-nums leading-none">—</p>
          <span data-ar-distance-unit class="text-amber-200/60 text-xs font-medium"></span>
        </div>

        <!-- جداکننده -->
        <div class="my-3 h-px bg-gradient-to-r from-transparent via-amber-400/40 to-transparent"></div>

        <!-- جهت -->
        <div class="flex items-center justify-between mb-2">
          <p class="text-stone-400 text-[10px]">جهت</p>
          <p data-ar-bearing class="text-amber-200 text-xs font-bold">—</p>
        </div>

        <!-- دقت GPS -->
        <div class="pt-2 border-t border-amber-400/20 flex items-center justify-between">
          <p class="text-stone-400 text-[10px]">دقت GPS</p>
          <div class="flex items-center gap-1.5">
            <span data-ar-accuracy-dot class="w-2 h-2 rounded-full bg-stone-500"></span>
            <p data-ar-accuracy class="text-xs font-bold tabular-nums text-stone-300">—</p>
          </div>
        </div>

        <!-- آفلاین -->
        <div data-ar-offline-indicator hidden class="mt-2 pt-2 border-t border-amber-400/20 flex items-center justify-between">
          <p class="text-stone-400 text-[10px]">وضعیت</p>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
            <p class="text-amber-300 text-xs font-bold">آفلاین</p>
          </div>
        </div>

        <!-- هشدار دقت -->
        <div data-ar-accuracy-warn hidden class="mt-3 rounded-xl bg-amber-500/15 border border-amber-500/40 px-3 py-2">
          <p class="text-amber-100 text-[11px] leading-relaxed">
            ⚠️ برای دقت بیشتر، GPS گوشی را روشن کنید
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- دکمه بستن — شیشه‌ی تیره -->
  <button
    type="button"
    data-ar-close
    aria-label="بستن واقعیت افزوده"
    class="lg-dark absolute top-4 end-4 z-30 w-12 h-12 flex items-center justify-center text-amber-200 hover:bg-amber-500/20 hover:text-amber-100 hover:rotate-90 transition-all duration-300 touch-target"
    style="border-radius: 50%;"
  >
    <span aria-hidden="true" class="text-lg font-bold">✕</span>
  </button>

  <!-- پیام راهنما — شیشه‌ی تیره -->
  <div
    data-ar-hint
    class="lg-dark absolute bottom-24 inset-x-4 z-30 px-5 py-4 text-center"
    style="animation: float 3s ease-in-out infinite; border-radius: 28px;"
  >
    <div class="flex items-center justify-center gap-3">
      <div class="flex gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse" style="animation-delay: 0.2s"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse" style="animation-delay: 0.4s"></span>
      </div>
      <p data-ar-hint-text class="text-amber-100 text-xs font-medium">
        گوشی را به آرامی بچرخانید تا نشانگر ظاهر شود
      </p>
    </div>
  </div>

  <!-- نشانگر زمین -->
  <div
    data-ar-ground-indicator
    hidden
    class="absolute bottom-32 inset-x-4 z-30 flex justify-center pointer-events-none"
  >
    <div class="px-6 py-3 rounded-[24px] bg-gradient-to-r from-emerald-500/90 to-green-500/90 backdrop-blur-lg border border-white/30 shadow-glass-lg" style="animation: pulse-ground 1.5s ease-in-out infinite;">
      <div class="flex items-center gap-3">
        <span class="text-2xl">📍</span>
        <p class="text-white text-sm font-bold">اینجا محل قبر است</p>
      </div>
    </div>
  </div>

  <!-- لایه Loading -->
  <div
    data-ar-loading
    hidden
    class="absolute inset-0 z-[60] flex items-center justify-center lg-overlay"
  >
    <div class="lg-dark p-8 max-w-sm" style="border-radius: 40px;">
      <div class="text-center">
        <div class="relative w-24 h-24 mx-auto mb-8">
          <div class="absolute inset-0 rounded-full border-4 border-amber-500/15"></div>
          <div class="absolute inset-0 rounded-full border-4 border-transparent border-t-amber-500 animate-spin"></div>
          <div class="absolute inset-0 rounded-full border-4 border-transparent border-b-orange-500 animate-spin" style="animation-direction: reverse; animation-duration: 1.5s;"></div>
          <div class="absolute inset-3 rounded-full bg-stone-800/80 backdrop-blur flex items-center justify-center shadow-inner">
            <span data-ar-loading-icon class="text-3xl">📡</span>
          </div>
        </div>

        <p data-ar-loading-text class="text-amber-200 text-base font-bold mb-3">آماده‌سازی...</p>
        <p data-ar-loading-hint class="text-stone-400 text-xs leading-relaxed mb-6">لطفاً صبر کنید و این صفحه را نبندید</p>

        <div class="w-56 h-1.5 rounded-full bg-stone-700/50 mx-auto overflow-hidden">
          <div
            data-ar-loading-progress
            class="h-full bg-gradient-to-r from-amber-500 via-orange-500 to-amber-500 rounded-full transition-all duration-700"
            style="width: 0%"
          ></div>
        </div>

        <p data-ar-loading-timer class="text-stone-500 text-[10px] mt-3 tabular-nums"></p>
      </div>
    </div>
  </div>

  <!-- کارت GPS خاموش — شیشه‌ی تیره -->
  <div
    data-ar-gps-off
    hidden
    class="lg-dark absolute inset-x-4 top-1/2 -translate-y-1/2 z-50 p-6 max-w-md mx-auto"
    style="border-radius: 40px;"
  >
    <div class="text-center">
      <div class="text-6xl mb-4">📡</div>
      <h3 class="text-amber-300 text-lg font-bold mb-2">سرویس موقعیت غیرفعال است</h3>
      <p data-ar-gps-off-msg class="text-stone-300 text-sm leading-relaxed mb-5">
        برای یافتن قبر، نیاز به دسترسی به موقعیت مکانی دارید. لطفاً GPS و مجوز موقعیت را فعال کنید.
      </p>

      <div class="space-y-2 text-start bg-stone-950/40 backdrop-blur-sm rounded-[20px] p-4 mb-5 border border-amber-400/15">
        <p class="text-amber-200 text-xs font-bold mb-3">چگونه GPS را روشن کنم؟</p>
        <div class="flex items-start gap-2">
          <span class="text-amber-400 text-xs font-bold mt-0.5">۱.</span>
          <p class="text-stone-400 text-xs leading-relaxed flex-1">
            از نوار اعلان گوشی، آیکون <strong class="text-amber-200">موقعیت مکانی</strong> را پیدا کنید و آن را روشن کنید
          </p>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-amber-400 text-xs font-bold mt-0.5">۲.</span>
          <p class="text-stone-400 text-xs leading-relaxed flex-1">
            یا: <strong class="text-amber-200">تنظیمات</strong> → <strong class="text-amber-200">موقعیت مکانی</strong> → <strong class="text-amber-200">روشن</strong>
          </p>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-amber-400 text-xs font-bold mt-0.5">۳.</span>
          <p class="text-stone-400 text-xs leading-relaxed flex-1">
            اگر VPN روشن است، آن را <strong class="text-amber-200">خاموش</strong> کنید
          </p>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-amber-400 text-xs font-bold mt-0.5">۴.</span>
          <p class="text-stone-400 text-xs leading-relaxed flex-1">
            در <strong class="text-amber-200">فضای باز</strong> یا کنار پنجره بایستید
          </p>
        </div>
      </div>

      <p class="text-amber-200/80 text-[11px] leading-relaxed mb-5 italic">
        پس از روشن کردن GPS، روی «تلاش مجدد» بزنید — نیازی به رفرش صفحه نیست.
      </p>

      <div class="flex gap-3">
        <button
          type="button"
          data-ar-gps-retry
          class="lg-button-primary flex-1 inline-flex items-center justify-center gap-2 py-3 px-4 font-bold"
        >
          <span>🔄</span>
          <span>تلاش مجدد</span>
        </button>
        <button
          type="button"
          data-ar-gps-close
          class="lg-thin rounded-[24px] text-stone-300 font-medium py-3 px-4 hover:bg-white/15 transition-all"
        >
          بستن
        </button>
      </div>
    </div>
  </div>

  <!-- پیام خطا — شیشه‌ی تیره -->
  <div
    data-ar-error
    hidden
    class="lg-dark absolute inset-x-4 top-1/2 -translate-y-1/2 z-50 p-6 max-w-md mx-auto border-red-500/50"
    style="border-radius: 40px;"
    role="alert"
  >
    <div class="text-center">
      <div class="text-5xl mb-3">⚠️</div>
      <p data-ar-error-msg class="text-red-100 text-sm leading-relaxed mb-4"></p>
      <button
        type="button"
        data-ar-retry
        class="lg-button-primary py-3 px-6 font-bold"
      >
        تلاش مجدد
      </button>
    </div>
  </div>
</div>

<style is:global>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-4px); }
  }

  @keyframes arrow-float {
    0%, 100% { transform: translateY(-6px); }
    50% { transform: translateY(6px); }
  }

  @keyframes arrow-glow-pulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.9; transform: scale(1.25); }
  }

  @keyframes arrow-beam {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 0.65; transform: scaleY(1.15); }
  }

  @keyframes pulse-ground {
    0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.4); }
    50% { transform: scale(1.03); box-shadow: 0 0 0 12px rgba(52, 211, 153, 0); }
  }

  .ar-arrow-float {
    animation: arrow-float 2.4s ease-in-out infinite;
    will-change: transform;
  }

  .ar-arrow-rotate {
    position: relative;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform;
  }

  .ar-arrow-glow {
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(245, 166, 35, 0.5) 0%,
      rgba(232, 131, 58, 0.25) 40%,
      rgba(232, 131, 58, 0) 70%
    );
    animation: arrow-glow-pulse 1.6s ease-in-out infinite;
    pointer-events: none;
  }

  .ar-arrow-rotate.aligned .ar-arrow-glow {
    background: radial-gradient(
      circle,
      rgba(255, 215, 100, 0.9) 0%,
      rgba(255, 180, 60, 0.5) 40%,
      rgba(255, 180, 60, 0) 70%
    );
    animation: arrow-glow-pulse 0.9s ease-in-out infinite;
  }

  .ar-arrow-beam {
    position: absolute;
    left: 50%;
    bottom: 100%;
    transform: translateX(-50%);
    transform-origin: bottom center;
    width: 3px;
    height: 80px;
    background: linear-gradient(
      to top,
      rgba(245, 166, 35, 0.7),
      rgba(245, 166, 35, 0.3),
      rgba(245, 166, 35, 0)
    );
    border-radius: 2px;
    filter: blur(1px);
    animation: arrow-beam 1.6s ease-in-out infinite;
    pointer-events: none;
  }

  .ar-arrow-rotate.aligned .ar-arrow-beam {
    height: 110px;
    width: 4px;
    background: linear-gradient(
      to top,
      rgba(255, 215, 100, 0.95),
      rgba(255, 180, 60, 0.5),
      rgba(255, 180, 60, 0)
    );
    animation: arrow-beam 0.9s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .ar-arrow-float,
    .ar-arrow-glow,
    .ar-arrow-beam,
    [data-ar-ground-indicator] > div {
      animation: none !important;
    }
  }
</style>