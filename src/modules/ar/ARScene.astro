---
import { config } from '../../utils/config';
const { location } = config;
---

<div
  data-ar-scene
  data-lat={location.latitude}
  data-lng={location.longitude}
  hidden
  class="fixed inset-0 z-[200] bg-black"
>
  <!-- HUD فاصله و جهت -->
  <div
    data-ar-hud
    class="absolute top-4 start-4 z-30 rounded-2xl bg-white/90 backdrop-blur-lg border border-amber-200 px-4 py-3 text-sm text-stone-800 shadow-xl"
  >
    <p class="text-stone-500 text-xs mb-1">فاصله تا قبر</p>
    <p data-ar-distance class="text-amber-600 font-bold text-xl tabular-nums">—</p>
    <p data-ar-bearing class="text-stone-500 text-xs mt-1">—</p>
  </div>

  <!-- دکمه بستن -->
  <button
    type="button"
    data-ar-close
    aria-label="بستن واقعیت افزوده"
    class="absolute top-4 end-4 z-30 w-12 h-12 rounded-full bg-white/90 backdrop-blur border border-amber-200 text-stone-700 flex items-center justify-center hover:bg-amber-500 hover:text-white transition-colors shadow-xl touch-target"
  >
    <span aria-hidden="true" class="text-lg">✕</span>
  </button>

  <!-- پیام راهنما -->
  <div
    data-ar-hint
    class="absolute bottom-24 inset-x-4 z-30 rounded-2xl bg-white/90 backdrop-blur-lg border border-amber-200 px-4 py-3 text-center text-sm text-stone-700 shadow-xl"
  >
    <p>📱 دوربین را به آرامی بچرخانید تا نشانگر قبر را پیدا کنید…</p>
  </div>

  <!-- صحنه A-Frame بهصورت داینامیک در JS ساخته میشود -->
  <div data-ar-scene-container class="absolute inset-0"></div>
</div>