---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/paths';
import { getExcerpt } from '../../utils/content';

interface Props {
  memory: CollectionEntry<'memories'>;
}

const { memory } = Astro.props;
const { id, data, body } = memory;
const excerpt = getExcerpt(body, 120);
const tagsKey = data.tags.join(',');
---

<article
  class="group rounded-lg overflow-hidden bg-obsidian-elevated border border-gold/10 hover:border-gold/40 transition-colors duration-300"
  data-memory-card
  data-tags={tagsKey}
>
  <button
    type="button"
    class="w-full text-start touch-target"
    data-memory-open={id}
    aria-label={`مشاهده خاطره: ${data.title}`}
  >
    <div class="aspect-video bg-obsidian overflow-hidden relative">
      {data.media ? (
        <img
          src={withBase(data.media.src)}
          alt={data.media.alt ?? data.title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-ivory-muted text-3xl opacity-40">
          💭
        </div>
      )}
      {data.featured && (
        <span class="absolute top-2 end-2 text-[10px] font-bold tracking-wider text-obsidian bg-gold px-2 py-0.5 rounded">
          ویژه
        </span>
      )}
    </div>

    <div class="p-4">
      <h3 class="text-ivory font-semibold text-base mb-1 leading-snug">
        {data.title}
      </h3>

      {(data.dateShamsi || data.location) && (
        <p class="text-xs text-ivory-muted mb-2">
          {data.dateShamsi}
          {data.dateShamsi && data.location && ' — '}
          {data.location}
        </p>
      )}

      {excerpt && (
        <p class="text-sm text-ivory-soft leading-relaxed line-clamp-3">
          {excerpt}
        </p>
      )}

      {data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-3">
          {data.tags.map((tag) => (
            <span class="text-[10px] text-ivory-muted border border-gold/20 rounded-full px-2 py-0.5">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </button>
</article>