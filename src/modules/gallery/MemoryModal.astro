---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/paths';

interface Props {
  memory: CollectionEntry<'memories'>;
}

const { memory } = Astro.props;
const { id, data } = memory;
const titleId = `memory-title-${id}`;
---

<div
  data-memory-modal={id}
  role="dialog"
  aria-modal="true"
  aria-labelledby={titleId}
  class="hidden fixed inset-0 z-[100]"
>
  <div
    data-modal-backdrop
    class="absolute inset-0 bg-obsidian/90 backdrop-blur-sm"
    aria-hidden="true"
  ></div>

  <div class="relative w-full h-full overflow-y-auto overscroll-contain">
    <div class="min-h-full flex items-start sm:items-center justify-center p-3 sm:p-6">
      <article class="relative w-full max-w-3xl bg-obsidian-soft border border-gold/30 rounded-2xl shadow-2xl overflow-hidden my-auto">
        <button
          type="button"
          data-modal-close
          aria-label="بستن خاطره"
          class="absolute top-3 end-3 z-10 w-11 h-11 rounded-full bg-obsidian/85 backdrop-blur border border-gold/30 text-ivory flex items-center justify-center hover:bg-gold hover:text-obsidian transition-colors"
        >
          <span aria-hidden="true" class="text-lg leading-none">✕</span>
        </button>

        {data.media && (
          <div class="aspect-video bg-obsidian">
            {data.media.type === 'image' ? (
              <img
                src={withBase(data.media.src)}
                alt={data.media.alt ?? data.title}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <video
                src={withBase(data.media.src)}
                controls
                preload="none"
                class="w-full h-full object-cover bg-black"
              >
                مرورگر شما از پخش ویدیو پشتیبانی نمی‌کند.
              </video>
            )}
          </div>
        )}

        <div class="p-5 sm:p-8">
          <header class="mb-5">
            <h2 id={titleId} class="text-xl sm:text-2xl font-bold text-gold leading-snug">
              {data.title}
            </h2>
            {(data.dateShamsi || data.location) && (
              <p class="mt-2 text-xs sm:text-sm text-ivory-muted">
                {data.dateShamsi}
                {data.dateShamsi && data.location && ' — '}
                {data.location}
              </p>
            )}
          </header>

          <div class="prose-custom text-ivory-soft leading-loose">
            <slot />
          </div>

          {data.media?.caption && (
            <p class="mt-5 text-xs text-ivory-muted italic text-center">
              {data.media.caption}
            </p>
          )}

          {data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-6 pt-5 border-t border-gold/15">
              {data.tags.map((tag) => (
                <span class="text-[11px] text-ivory-muted border border-gold/25 rounded-full px-2.5 py-0.5">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </article>
    </div>
  </div>
</div>

<style>
  [data-memory-modal] :global(.prose-custom p) {
    margin-bottom: 1rem;
  }
  [data-memory-modal] :global(.prose-custom p:last-child) {
    margin-bottom: 0;
  }
  [data-memory-modal] :global(.prose-custom blockquote) {
    border-right: 3px solid var(--color-gold);
    padding-right: 1rem;
    margin: 1.5rem 0;
    color: var(--color-gold-light);
    font-style: italic;
  }
</style>