---
// src/modules/candles/CandlesModule.astro
---

<section class="candles-module relative py-6 sm:py-10 px-3 sm:px-6 max-w-6xl mx-auto select-none" dir="rtl">
  
  <!-- ۱. کارت شیشه‌ای هدر و فرم روشن کردن شمع (هماهنگ با تم اصلی پروژه) -->
  <div class="relative z-10 rounded-[2rem] bg-gradient-to-b from-stone-900/90 via-stone-950/95 to-stone-950 border border-amber-500/25 p-6 sm:p-10 shadow-[0_25px_70px_-15px_rgba(0,0,0,0.75),0_0_40px_rgba(245,158,11,0.08)] backdrop-blur-2xl mb-10 overflow-hidden">
    
    <!-- پرتوهای نوری پس‌زمینه کارت فرم -->
    <div class="pointer-events-none absolute -top-28 left-1/2 -translate-x-1/2 w-[28rem] h-56 bg-gradient-to-b from-amber-500/20 via-orange-500/10 to-transparent blur-3xl rounded-full"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-24 w-72 h-72 bg-amber-600/10 blur-3xl rounded-full"></div>

    <div class="relative z-10 text-center max-w-xl mx-auto">
      <!-- نشانگر سه‌بعدی شمع در بالای فرم -->
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-500/20 via-amber-500/5 to-transparent border border-amber-400/30 shadow-[0_0_35px_rgba(245,158,11,0.3),inset_0_1px_1px_rgba(255,255,255,0.2)] mb-5">
        <span class="text-3xl filter drop-shadow-[0_0_12px_rgba(251,191,36,0.9)] animate-pulse">🕯️</span>
      </div>

      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold bg-gradient-to-r from-amber-100 via-amber-300 to-orange-200 bg-clip-text text-transparent mb-3 tracking-tight">
        تالار شمع‌های یادبود
      </h2>
      
      <p class="text-stone-300/90 text-xs sm:text-sm md:text-base leading-relaxed mb-7">
        به یاد و احترام عزیزمان، شمعی روشن کنید. هر شمع به مدت
        <span class="text-amber-400 font-bold underline decoration-amber-500/40 underline-offset-4"> ۳۰ روز </span>
        روشن می‌ماند و به آرامی ذوب می‌شود، اما نام و یاد شما برای همیشه در این تالار جاودانه خواهد ماند.
      </p>

      <!-- فرم ثبت شمع -->
      <form id="light-candle-form" class="max-w-md mx-auto space-y-4">
        <div class="relative group">
          <div class="absolute -inset-0.5 bg-gradient-to-r from-amber-500/40 via-orange-500/40 to-amber-500/40 rounded-2xl blur opacity-30 group-focus-within:opacity-80 transition duration-500"></div>
          <input
            type="text"
            id="candle-user-name"
            required
            maxlength="50"
            autocomplete="name"
            placeholder="نام و نام خانوادگی خود را وارد کنید..."
            class="relative w-full px-5 py-4 rounded-2xl bg-stone-950/90 border border-amber-500/25 text-amber-50 placeholder-stone-500 text-sm sm:text-base text-center focus:outline-none focus:border-amber-400 transition-all shadow-inner"
          />
        </div>

        <button
          type="submit"
          id="submit-candle-btn"
          class="relative w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-amber-500 via-amber-400 to-orange-500 hover:from-amber-400 hover:via-amber-300 hover:to-orange-400 text-stone-950 font-extrabold text-sm sm:text-base shadow-[0_10px_30px_-5px_rgba(245,158,11,0.5),inset_0_1px_1px_rgba(255,255,255,0.6)] hover:shadow-[0_15px_40px_-5px_rgba(245,158,11,0.75)] active:scale-[0.99] transition-all duration-300 flex items-center justify-center gap-2.5 cursor-pointer overflow-hidden group"
        >
          <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></span>
          <span class="text-lg">🕯️</span>
          <span id="submit-candle-text">روشن کردن شمع به یادگار</span>
        </button>

        <p id="candle-form-status" class="text-xs sm:text-sm min-h-[1.25rem] font-medium transition-all duration-300"></p>
      </form>

      <!-- نوار آمار زنده تالار -->
      <div class="mt-7 pt-5 border-t border-stone-800/80 flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs sm:text-sm">
        <div class="flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 px-3.5 py-1.5 rounded-full">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
          </span>
          <span class="text-stone-300">شمع‌های روشن:</span>
          <strong id="active-candles-count" class="text-amber-300 font-extrabold text-sm">۰</strong>
        </div>

        <div class="flex items-center gap-2 bg-stone-900/90 border border-stone-800 px-3.5 py-1.5 rounded-full">
          <span class="h-2 w-2 rounded-full bg-stone-500"></span>
          <span class="text-stone-400">کل شمع‌های ثبت‌شده:</span>
          <strong id="total-candles-count" class="text-stone-200 font-extrabold text-sm">۰</strong>
        </div>
      </div>
    </div>
  </div>

  <!-- ۲. صحنه سینماتیک و سه‌بعدی تالار شمع‌ها (3D Sanctuary Stage) -->
  <div id="candles-sanctuary" class="sanctuary-stage relative min-h-[460px] rounded-[2.25rem] bg-[#090807] border border-amber-500/15 p-5 sm:p-10 md:p-12 shadow-[0_30px_80px_rgba(0,0,0,0.9),inset_0_0_80px_rgba(0,0,0,0.95)] overflow-hidden">
    
    <!-- نورپردازی حجمی سقف و کف تالار -->
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_0%,rgba(245,158,11,0.12),transparent_70%)]"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_95%,rgba(217,119,6,0.08),transparent_65%)]"></div>

    <!-- ذرات معلق نورانی در فضای تالار (Ambient Floating Embers) -->
    <div class="ambient-embers pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <span class="ember e-1"></span>
      <span class="ember e-2"></span>
      <span class="ember e-3"></span>
      <span class="ember e-4"></span>
      <span class="ember e-5"></span>
      <span class="ember e-6"></span>
    </div>

    <!-- وضعیت در حال بارگذاری -->
    <div id="candles-loading" class="relative z-10 flex flex-col items-center justify-center py-28 text-stone-400">
      <div class="relative w-12 h-12 flex items-center justify-center mb-4">
        <div class="absolute inset-0 rounded-full border-2 border-amber-500/20"></div>
        <div class="absolute inset-0 rounded-full border-2 border-amber-400 border-t-transparent animate-spin"></div>
        <span class="text-lg">🕯️</span>
      </div>
      <p class="text-sm text-amber-100/70 font-medium">در حال چیدمان شمع‌های یادبود...</p>
    </div>

    <!-- شبکه سه‌بعدی شمع‌ها -->
    <div id="candles-grid" class="relative z-10 hidden grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-5 gap-y-14 items-end justify-items-center pt-12 pb-6">
    </div>
  </div>
</section>

<style is:global>
  /* ===== ذرات معلق تالار (Ambient Embers) ===== */
  .ambient-embers .ember {
    position: absolute;
    bottom: -10px;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: radial-gradient(circle, #fde68a 0%, #f59e0b 60%, transparent 100%);
    box-shadow: 0 0 10px 2px rgba(245, 158, 11, 0.6);
    opacity: 0;
    animation: float-ember 10s infinite ease-in-out;
  }
  .ambient-embers .e-1 { left: 12%; animation-duration: 9s; animation-delay: 0s; }
  .ambient-embers .e-2 { left: 28%; animation-duration: 12s; animation-delay: 2s; }
  .ambient-embers .e-3 { left: 48%; animation-duration: 8.5s; animation-delay: 4s; }
  .ambient-embers .e-4 { left: 66%; animation-duration: 11s; animation-delay: 1.5s; }
  .ambient-embers .e-5 { left: 82%; animation-duration: 10s; animation-delay: 3.5s; }
  .ambient-embers .e-6 { left: 91%; animation-duration: 13s; animation-delay: 5s; }

  @keyframes float-ember {
    0%   { transform: translateY(0) translateX(0) scale(0.6); opacity: 0; }
    20%  { opacity: 0.55; }
    60%  { transform: translateY(-220px) translateX(18px) scale(1); opacity: 0.35; }
    100% { transform: translateY(-420px) translateX(-14px) scale(0.3); opacity: 0; }
  }

  /* ===== کارت و استیج سه‌بعدی هر شمع (3D Perspective Pod) ===== */
  .candle-pod-3d {
    perspective: 900px;
    width: 100%;
    max-width: 175px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .candle-scene-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-style: preserve-3d;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* بخش بصری نگه‌دارنده شمع با ارتفاع ثابت برای تراز بودن پایه‌ها */
  .candle-visual-box {
    position: relative;
    height: 175px;
    width: 110px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    transform-style: preserve-3d;
  }

  /* ===== ۱. سیستم شعله ۴ لایه سینماتیک ===== */
  .flame-system-3d {
    position: relative;
    width: 34px;
    height: 54px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin-bottom: -4px;
    z-index: 6;
    transform: translateZ(18px);
    pointer-events: none;
  }

  /* هاله نورانی بزرگ پشت شعله */
  .flame-ambient-halo {
    position: absolute;
    bottom: -18px;
    width: 135px;
    height: 135px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(251, 191, 36, 0.35) 0%,
      rgba(245, 158, 11, 0.14) 38%,
      rgba(234, 88, 12, 0.04) 62%,
      transparent 78%
    );
    animation: halo-breathe 3.6s infinite ease-in-out alternate;
    pointer-events: none;
  }

  /* بدنه اصلی شعله */
  .flame-main-body {
    position: relative;
    width: 18px;
    height: 40px;
    border-radius: 50% 50% 36% 36% / 68% 68% 32% 32%;
    background: radial-gradient(
      ellipse at 50% 82%,
      rgba(255, 255, 255, 0.98) 0%,
      rgba(254, 240, 138, 0.96) 24%,
      rgba(251, 191, 36, 0.92) 52%,
      rgba(234, 88, 12, 0.78) 80%,
      rgba(180, 83, 9, 0) 100%
    );
    box-shadow:
      0 0 18px 4px rgba(251, 191, 36, 0.65),
      0 -10px 32px 8px rgba(245, 158, 11, 0.4),
      0 -20px 50px 12px rgba(234, 88, 12, 0.2);
    transform-origin: 50% 90%;
    animation: flame-dance-3d var(--flicker-speed, 2.9s) infinite ease-in-out alternate;
  }

  /* هسته سفید خیره‌کننده میانی */
  .flame-inner-bright {
    position: absolute;
    bottom: 4px;
    width: 9px;
    height: 21px;
    border-radius: 50% 50% 40% 40% / 70% 70% 30% 30%;
    background: linear-gradient(to top, #ffffff 10%, #fef08a 75%, transparent 100%);
    opacity: 0.95;
    filter: blur(0.4px);
  }

  /* پایه آبی حرارتی پایین فتیله */
  .flame-blue-base {
    position: absolute;
    bottom: 0px;
    width: 9px;
    height: 8px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(96, 165, 250, 0.9) 0%, rgba(59, 130, 246, 0.4) 60%, transparent 100%);
    filter: blur(0.5px);
  }

  /* جرقه ریز بالای شعله */
  .flame-spark {
    position: absolute;
    bottom: 38px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #fef08a;
    box-shadow: 0 0 6px #f59e0b;
    animation: spark-rise 2.4s infinite ease-out;
  }

  /* ===== ۲. فتیله شمع (Wick) ===== */
  .candle-wick-3d {
    width: 2.5px;
    height: 9px;
    background: linear-gradient(180deg, #fb923c 0%, #44403c 45%, #1c1917 100%);
    border-radius: 2px;
    position: relative;
    z-index: 5;
    margin-bottom: -3px;
    transform: translateZ(15px);
  }

  .candle-wick-3d.is-melted {
    height: 6px;
    background: #1c1917;
    transform: translateZ(15px) rotate(18deg) translateY(2px);
  }

  /* ===== ۳. استوانه سه‌بعدی موم شمع با Subsurface Scattering ===== */
  .candle-cylinder-3d {
    position: relative;
    width: 46px;
    border-radius: 6px 6px 8px 8px;
    z-index: 4;
    transform: translateZ(12px);
    transition: height 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    /* شبیه‌سازی استوانه سه‌بعدی با گرادیانت افقی */
    background: linear-gradient(
      90deg,
      #a89f91 0%,
      #dfd7ca 18%,
      #fbf8f3 42%,
      #e6dec8 68%,
      #b5aa99 88%,
      #787065 100%
    );
    box-shadow:
      inset 0 18px 22px -6px rgba(251, 191, 36, 0.55), /* نفوذ نور گرم شعله به داخل موم (SSS) */
      inset 0 -14px 18px rgba(12, 10, 9, 0.55),
      inset 3px 0 6px rgba(255, 255, 255, 0.5),
      inset -4px 0 8px rgba(0, 0, 0, 0.45),
      0 14px 24px -4px rgba(0, 0, 0, 0.85);
  }

  /* شمع آب‌شده فاقد درخشش درونی موم است */
  .candle-cylinder-3d.is-melted {
    background: linear-gradient(
      90deg,
      #57534e 0%,
      #78716c 30%,
      #a8a29e 50%,
      #57534e 85%,
      #292524 100%
    );
    box-shadow:
      inset 0 -6px 10px rgba(0, 0, 0, 0.7),
      0 8px 16px rgba(0, 0, 0, 0.85);
  }

  /* دهانه بیضی‌شکل بالای استوانه شمع (3D Top Meniscus & Melted Pool) */
  .candle-top-rim {
    position: absolute;
    top: -6px;
    left: 0;
    width: 100%;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      #fde68a 0%,
      #f59e0b 38%,
      #f5ebe0 72%,
      #c7bdb1 100%
    );
    box-shadow:
      inset 0 2px 4px rgba(0, 0, 0, 0.25),
      0 0 12px rgba(251, 191, 36, 0.4);
  }

  .candle-cylinder-3d.is-melted .candle-top-rim {
    background: radial-gradient(ellipse at center, #292524 0%, #57534e 65%, #78716c 100%);
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.8);
  }

  /* اشک‌های موم سه‌بعدی روی بدنه */
  .wax-stream {
    position: absolute;
    top: 3px;
    width: 5px;
    border-radius: 0 0 999px 999px;
    background: linear-gradient(
      90deg,
      rgba(214, 204, 194, 0.9),
      rgba(255, 252, 247, 0.98) 50%,
      rgba(168, 159, 145, 0.9)
    );
    box-shadow: 1px 3px 4px rgba(0, 0, 0, 0.35);
    opacity: 0.92;
  }

  .wax-stream::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: -0.5px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: inherit;
  }

  /* ===== ۴. دود سینماتیک شمع‌های به‌پایان‌رسیده ===== */
  .smoke-plume {
    position: relative;
    width: 14px;
    height: 44px;
    margin-bottom: -2px;
    z-index: 5;
    pointer-events: none;
  }

  .smoke-wisp {
    position: absolute;
    bottom: 0;
    left: 4px;
    width: 6px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(to top, rgba(168, 162, 158, 0.35), rgba(214, 211, 209, 0.12), transparent);
    filter: blur(3px);
    animation: smoke-curl 4.2s infinite ease-out;
  }

  .smoke-wisp.w-2 {
    animation-delay: -2.1s;
    left: 6px;
  }

  /* ===== ۵. پایه برنزی/سنگی سه‌بعدی شمع + بازتاب نور روی زمین ===== */
  .candle-pedestal-3d {
    position: relative;
    width: 72px;
    height: 14px;
    border-radius: 50%;
    background: linear-gradient(
      90deg,
      #1c1917 0%,
      #57534e 25%,
      #a8a29e 48%,
      #44403c 78%,
      #0c0a09 100%
    );
    box-shadow:
      0 8px 18px rgba(0, 0, 0, 0.95),
      inset 0 2px 3px rgba(255, 255, 255, 0.28),
      inset 0 -3px 6px rgba(0, 0, 0, 0.85);
    margin-top: -5px;
    z-index: 3;
    transform: translateZ(8px);
  }

  /* بازتاب نور گرم شعله روی سطح پایه و زمین */
  .floor-light-pool {
    position: absolute;
    bottom: -8px;
    width: 115px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(245, 158, 11, 0.32) 0%,
      rgba(217, 119, 6, 0.12) 50%,
      transparent 78%
    );
    filter: blur(4px);
    z-index: 1;
    pointer-events: none;
  }

  /* ===== ۶. پلاک مشخصات شیشه‌ای زیر هر شمع ===== */
  .candle-plaque-3d {
    margin-top: 14px;
    width: 100%;
    padding: 10px 12px;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(28, 25, 23, 0.82) 0%, rgba(12, 10, 9, 0.92) 100%);
    border: 1px solid rgba(245, 158, 11, 0.16);
    box-shadow:
      0 12px 25px -6px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(10px);
    text-align: center;
    transform: translateZ(22px);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .candle-pod-3d:hover .candle-plaque-3d {
    border-color: rgba(251, 191, 36, 0.45);
    box-shadow:
      0 16px 32px -6px rgba(0, 0, 0, 0.85),
      0 0 20px rgba(245, 158, 11, 0.15);
  }

  /* انیمیشن‌های کلیدی شعله و دود */
  @keyframes flame-dance-3d {
    0%   { transform: scale(1, 1) rotate(-1.5deg) skewX(-1deg); }
    25%  { transform: scale(1.04, 0.96) rotate(1.2deg) skewX(1.2deg); }
    50%  { transform: scale(0.96, 1.05) rotate(-0.8deg) skewX(-0.5deg); }
    75%  { transform: scale(1.03, 0.98) rotate(1.8deg) skewX(1deg); }
    100% { transform: scale(0.99, 1.03) rotate(-0.5deg) skewX(0deg); }
  }

  @keyframes halo-breathe {
    0%   { transform: scale(0.92); opacity: 0.72; }
    100% { transform: scale(1.12); opacity: 1; }
  }

  @keyframes spark-rise {
    0%   { transform: translateY(0) scale(1); opacity: 0.9; }
    100% { transform: translateY(-22px) translateX(5px) scale(0); opacity: 0; }
  }

  @keyframes smoke-curl {
    0%   { transform: translateY(0) translateX(0) scaleX(1); opacity: 0.42; }
    50%  { transform: translateY(-16px) translateX(-5px) scaleX(1.8); opacity: 0.22; }
    100% { transform: translateY(-34px) translateX(6px) scaleX(2.6); opacity: 0; }
  }
</style>

<script>
  import { supabase, type CandleRecord } from '../../utils/supabase';

  // طول عمر دقیق شمع: ۳۰ روز به میلی‌ثانیه
  const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
  const MAX_WAX_HEIGHT = 112; // ارتفاع شمع تازه روشن‌شده (پیکسل)
  const MIN_WAX_HEIGHT = 16;  // ارتفاع شمع کاملاً آب‌شده پس از ۳۰ روز (پیکسل)

  const form = document.getElementById('light-candle-form') as HTMLFormElement | null;
  const nameInput = document.getElementById('candle-user-name') as HTMLInputElement | null;
  const submitBtn = document.getElementById('submit-candle-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('submit-candle-text');
  const statusEl = document.getElementById('candle-form-status');
  const loadingEl = document.getElementById('candles-loading');
  const gridEl = document.getElementById('candles-grid');
  const activeCountEl = document.getElementById('active-candles-count');
  const totalCountEl = document.getElementById('total-candles-count');

  let candlesList: CandleRecord[] = [];

  // محاسبه دقیق پارامترهای سینماتیک هر شمع بر اساس زمان سپری‌شده
  function computeCandleMetrics(createdAtIso: string) {
    const createdTime = new Date(createdAtIso).getTime();
    const now = Date.now();
    const elapsedMs = Math.max(0, now - createdTime);

    const remainingRatio = Math.max(0, Math.min(1, 1 - elapsedMs / THIRTY_DAYS_MS));
    const isAlive = remainingRatio > 0;

    const waxHeightPx = Math.round(
      MIN_WAX_HEIGHT + remainingRatio * (MAX_WAX_HEIGHT - MIN_WAX_HEIGHT)
    );

    const remainingDays = Math.ceil((THIRTY_DAYS_MS - elapsedMs) / (1000 * 60 * 60 * 24));
    const lifePercent = Math.round(remainingRatio * 100);

    const formattedDate = new Intl.DateTimeFormat('fa-IR', {
      month: 'short',
      day: 'numeric',
    }).format(new Date(createdAtIso));

    return {
      isAlive,
      remainingRatio,
      waxHeightPx,
      remainingDays: Math.max(0, remainingDays),
      lifePercent,
      formattedDate,
    };
  }

  function escapeHtml(str: string) {
    return str.replace(/[&<>"']/g, (m) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[m] || m));
  }

  // فعال‌سازی افکت چرخش سه‌بعدی (3D Tilt) با حرکت موس روی هر شمع
  function attach3DTiltInteractions() {
    if (!gridEl) return;
    const pods = gridEl.querySelectorAll<HTMLElement>('.candle-pod-3d');

    pods.forEach((pod) => {
      const inner = pod.querySelector<HTMLElement>('.candle-scene-inner');
      if (!inner) return;

      pod.addEventListener('pointermove', (e) => {
        const rect = pod.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        const rotateY = (x * 18).toFixed(2);
        const rotateX = (-y * 14).toFixed(2);
        inner.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
      });

      pod.addEventListener('pointerleave', () => {
        inner.style.transform = 'rotateX(0deg) rotateY(0deg) translateY(0px)';
      });
    });
  }

  function renderCandles() {
    if (!gridEl || !loadingEl) return;

    loadingEl.classList.add('hidden');
    gridEl.classList.remove('hidden');
    gridEl.classList.add('grid');

    let activeCount = 0;

    if (candlesList.length === 0) {
      gridEl.innerHTML = `
        <div class="col-span-full text-center py-20 px-4">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-amber-500/10 border border-amber-500/20 text-2xl mb-3">🕯️</div>
          <p class="text-stone-300 font-semibold text-base mb-1">هنوز شمعی در این تالار روشن نشده است</p>
          <p class="text-stone-500 text-xs">اولین نفری باشید که به یاد و احترام ایشان شمعی روشن می‌کند.</p>
        </div>
      `;
      if (activeCountEl) activeCountEl.textContent = '۰';
      if (totalCountEl) totalCountEl.textContent = '۰';
      return;
    }

    gridEl.innerHTML = candlesList.map((candle, index) => {
      const metrics = computeCandleMetrics(candle.created_at);
      if (metrics.isAlive) activeCount++;

      // تنوع طبیعی در رقص نور هر شمع
      const animDelay = ((index * 0.43) % 2.8).toFixed(2);
      const flickerSpeed = (2.4 + ((index * 0.29) % 1.1)).toFixed(2);
      const flameScale = (0.78 + metrics.remainingRatio * 0.24).toFixed(2);
      const haloOpacity = (0.45 + metrics.remainingRatio * 0.55).toFixed(2);

      // ارتفاع اشک‌های موم متناسب با میزان آب شدن شمع
      const drip1 = Math.min(metrics.waxHeightPx - 6, Math.round((1 - metrics.remainingRatio) * 38 + 10));
      const drip2 = Math.min(metrics.waxHeightPx - 8, Math.round((1 - metrics.remainingRatio) * 26 + 7));
      const drip3 = Math.min(metrics.waxHeightPx - 10, Math.round((1 - metrics.remainingRatio) * 18 + 5));

      return `
        <div class="candle-pod-3d ${metrics.isAlive ? '' : 'opacity-75 hover:opacity-100 transition-opacity'}">
          <div class="candle-scene-inner">
            
            <!-- بخش سه‌بعدی شمع و پایه -->
            <div class="candle-visual-box">
              ${metrics.isAlive ? `
                <div class="flame-system-3d" style="--flicker-speed: ${flickerSpeed}s;">
                  <div class="flame-ambient-halo" style="animation-delay: -${animDelay}s; opacity:${haloOpacity};"></div>
                  <div class="flame-main-body" style="animation-delay: -${animDelay}s; transform: scale(${flameScale});"></div>
                  <div class="flame-inner-bright"></div>
                  <div class="flame-blue-base"></div>
                  <div class="flame-spark" style="animation-delay: -${animDelay}s;"></div>
                </div>
              ` : `
                <div class="smoke-plume">
                  <span class="smoke-wisp w-1"></span>
                  <span class="smoke-wisp w-2"></span>
                </div>
              `}

              <div class="candle-wick-3d ${metrics.isAlive ? '' : 'is-melted'}"></div>

              <div class="candle-cylinder-3d ${metrics.isAlive ? '' : 'is-melted'}" style="height: ${metrics.waxHeightPx}px;">
                <div class="candle-top-rim"></div>
                <span class="wax-stream" style="left: 7px; height: ${drip1}px;"></span>
                <span class="wax-stream" style="left: 21px; height: ${drip3}px;"></span>
                <span class="wax-stream" style="right: 8px; height: ${drip2}px;"></span>
              </div>

              <div class="candle-pedestal-3d"></div>
              ${metrics.isAlive ? `<div class="floor-light-pool" style="opacity: ${haloOpacity};"></div>` : ''}
            </div>

            <!-- پلاک مشخصات و نوار عمر شمع -->
            <div class="candle-plaque-3d">
              <p class="text-amber-50 font-bold text-xs sm:text-sm truncate" title="${escapeHtml(candle.name)}">
                ${escapeHtml(candle.name)}
              </p>

              <div class="mt-2 flex items-center justify-center gap-1.5">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-medium ${
                  metrics.isAlive
                    ? 'bg-amber-500/15 text-amber-300 border border-amber-500/30'
                    : 'bg-stone-800/90 text-stone-400 border border-stone-700/60'
                }">
                  ${metrics.isAlive
                    ? `🔥 ${metrics.remainingDays.toLocaleString('fa-IR')} روز باقی‌مانده`
                    : `خاموش‌شده (${metrics.formattedDate})`
                  }
                </span>
              </div>

              ${metrics.isAlive ? `
                <div class="mt-2 w-full h-1 rounded-full bg-stone-800 overflow-hidden" title="${metrics.lifePercent}% از عمر شمع باقی مانده">
                  <div class="h-full rounded-full bg-gradient-to-r from-orange-500 via-amber-400 to-yellow-200 transition-all duration-700" style="width: ${metrics.lifePercent}%;"></div>
                </div>
              ` : ''}
            </div>

          </div>
        </div>
      `;
    }).join('');

    if (activeCountEl) activeCountEl.textContent = activeCount.toLocaleString('fa-IR');
    if (totalCountEl) totalCountEl.textContent = candlesList.length.toLocaleString('fa-IR');

    attach3DTiltInteractions();
  }

  async function fetchAllCandles() {
    if (!supabase) {
      if (loadingEl) {
        loadingEl.innerHTML = `<p class="text-amber-400/90 text-sm">متغیرهای اتصال به Supabase تنظیم نشده‌اند.</p>`;
      }
      return;
    }

    const { data, error } = await supabase
      .from('candles')
      .select('id, name, created_at')
      .order('created_at', { ascending: false });

    if (error) {
      console.error('Supabase fetch error:', error);
      if (loadingEl) {
        loadingEl.innerHTML = `<p class="text-red-400 text-sm">خطا در دریافت اطلاعات شمع‌ها. لطفاً اتصال اینترنت را بررسی کنید.</p>`;
      }
      return;
    }

    candlesList = data || [];
    renderCandles();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!supabase || !nameInput || !submitBtn) return;

    const name = nameInput.value.trim();
    if (!name) return;

    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-60', 'pointer-events-none');
    if (submitText) submitText.textContent = 'در حال روشن کردن شمع...';
    if (statusEl) {
      statusEl.textContent = 'در حال ثبت در تالار یادبود...';
      statusEl.className = 'text-xs sm:text-sm text-amber-300 min-h-[1.25rem]';
    }

    const { data, error } = await supabase
      .from('candles')
      .insert([{ name }])
      .select('id, name, created_at')
      .single();

    submitBtn.disabled = false;
    submitBtn.classList.remove('opacity-60', 'pointer-events-none');
    if (submitText) submitText.textContent = 'روشن کردن شمع به یادگار';

    if (error) {
      console.error('Supabase insert error:', error);
      if (statusEl) {
        statusEl.textContent = 'خطا در ثبت شمع. لطفاً دوباره تلاش کنید.';
        statusEl.className = 'text-xs sm:text-sm text-red-400 min-h-[1.25rem]';
      }
      return;
    }

    if (data) {
      candlesList.unshift(data);
      renderCandles();
      form.reset();
      if (statusEl) {
        statusEl.textContent = '✨ شمع شما با موفقیت روشن شد و تا ۳۰ روز آینده در این تالار می‌درخشد.';
        statusEl.className = 'text-xs sm:text-sm text-emerald-400 min-h-[1.25rem]';
      }
    }
  });

  fetchAllCandles();
  setInterval(renderCandles, 60 * 1000);
</script>