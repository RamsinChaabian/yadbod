---
import { config } from '../../utils/config';

const { location } = config;
---

<div class="py-2">
  <!-- سربرگ شیشه‌ای -->
  <header class="lg-card p-5 mb-4">
    <h2 class="text-xl font-bold text-stone-800 mb-1">مسیریابی به محل قبر</h2>
    <p class="text-sm text-stone-500">
      {location.cemeteryName} — {location.city}، {location.province}
    </p>
  </header>

  <div
    data-map-root
    data-lat={location.latitude}
    data-lng={location.longitude}
    data-zoom={location.defaultZoom}
    class="relative"
  >
    <!-- نقشه در یک قاب شیشه‌ای -->
    <div class="lg-card p-2 overflow-hidden">
      <div
        data-map
        class="w-full h-[60vh] min-h-[340px] sm:min-h-[420px] rounded-[24px] overflow-hidden bg-stone-100"
        aria-label="نقشه محل قبر"
      >
        <div class="w-full h-full flex items-center justify-center text-stone-400 text-sm" data-map-loading>
          <span>در حال بارگذاری نقشه…</span>
        </div>
      </div>
    </div>

    <!-- دکمه‌ها -->
    <div class="mt-4 flex flex-wrap gap-3">
      <button
        type="button"
        data-action="navigate"
        class="lg-button-primary touch-target inline-flex items-center gap-2 px-5 py-3 font-bold disabled:opacity-50 disabled:cursor-not-allowed flex-1 sm:flex-none justify-center"
      >
        <span aria-hidden="true">🧭</span>
        <span data-navigate-label>مسیریابی از موقعیت من</span>
      </button>

      <a
        data-google-link
        href={location.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="lg-button touch-target inline-flex items-center gap-2 px-5 py-3 font-semibold text-amber-700 flex-1 sm:flex-none justify-center"
      >
        <span aria-hidden="true">📍</span>
        <span>باز کردن در Google Maps</span>
      </a>
    </div>

    <!-- اطلاعات مسیر -->
    <div
      data-route-info
      hidden
      class="lg-card p-5 mt-4"
    >
      <p class="text-stone-500 text-sm font-medium mb-3">مسیر پیشنهادی</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-stone-700">
        <p class="flex items-center gap-2">
          <span>📏</span>
          <span>فاصله:</span>
          <span data-route-distance class="text-amber-700 font-bold">—</span>
        </p>
        <p class="flex items-center gap-2">
          <span>⏱️</span>
          <span>زمان تقریبی:</span>
          <span data-route-duration class="text-amber-700 font-bold">—</span>
        </p>
      </div>
      <p class="mt-3 text-xs text-stone-400 leading-relaxed">
        این مسیر فقط جهت راهنمایی است. لطفاً قوانین رانندگی را رعایت کنید.
      </p>
    </div>

    <!-- خطا -->
    <p
      data-map-error
      hidden
      class="lg-card p-4 mt-4 text-sm text-red-700 border-red-300/50"
      role="alert"
    ></p>
  </div>
</div>

<style is:global>
  /* استایل کاشی‌های نقشه — روشن و هماهنگ با Liquid Glass */
  .leaflet-container {
    background: #F5EDE0;
    font-family: var(--font-sans);
    border-radius: 24px;
  }

  .leaflet-popup-content-wrapper,
  .leaflet-popup-tip {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    color: #4A3F35;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 16px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 8px 32px rgba(74, 63, 53, 0.15);
  }

  .leaflet-popup-content {
    margin: 12px 16px;
    font-size: 13px;
    line-height: 1.6;
  }

  .leaflet-popup-tip {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.7);
  }

  .leaflet-control-attribution {
    background: rgba(255, 255, 255, 0.7) !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #8B7D6B !important;
    font-size: 10px;
    border-radius: 8px 0 0 0;
  }

  .leaflet-control-attribution a {
    color: #B8915A !important;
  }

  .leaflet-bar a,
  .leaflet-bar a:hover {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #4A3F35;
    border-bottom-color: rgba(184, 145, 90, 0.2);
    transition: all 0.2s;
  }

  .leaflet-bar a:hover {
    background: rgba(232, 131, 58, 0.9);
    color: white;
  }

  .leaflet-bar a:first-child {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
  }

  .leaflet-bar a:last-child {
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
  }

  .grave-marker, .user-marker {
    background: transparent !important;
    border: none !important;
  }

  /* انیمیشن پالس مسیر سبز */
  .route-line-glow {
    filter: blur(4px);
    animation: route-glow-pulse 2s ease-in-out infinite;
  }

  @keyframes route-glow-pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.95; }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-line-glow {
      animation: none !important;
    }
  }
</style>

<script>
  async function initMap() {
    const root = document.querySelector<HTMLElement>('[data-map-root]');
    if (!root) return;

    const mapEl = root.querySelector<HTMLElement>('[data-map]');
    const loadingEl = root.querySelector<HTMLElement>('[data-map-loading]');
    const errorEl = root.querySelector<HTMLElement>('[data-map-error]');
    const navigateBtn = root.querySelector<HTMLButtonElement>('[data-action="navigate"]');
    const navigateLabel = root.querySelector<HTMLElement>('[data-navigate-label]');
    const googleLink = root.querySelector<HTMLAnchorElement>('[data-google-link]');
    const routeInfo = root.querySelector<HTMLElement>('[data-route-info]');
    const distanceEl = root.querySelector<HTMLElement>('[data-route-distance]');
    const durationEl = root.querySelector<HTMLElement>('[data-route-duration]');

    if (!mapEl) return;

    const lat = parseFloat(root.dataset.lat ?? '0');
    const lng = parseFloat(root.dataset.lng ?? '0');
    const zoom = parseFloat(root.dataset.zoom ?? '17');

    let L: typeof import('leaflet');
    try {
      L = await import('leaflet');
      await import('leaflet/dist/leaflet.css');
    } catch (e) {
      showError('بارگذاری کتابخانه نقشه با مشکل مواجه شد.');
      return;
    }

    loadingEl?.remove();

    const map = L.map(mapEl, {
      center: [lat, lng],
      zoom,
      zoomControl: true,
      attributionControl: true,
      scrollWheelZoom: true,
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    const graveIcon = L.divIcon({
      className: 'grave-marker',
      html: `
        <div style="position:relative;width:40px;height:52px;filter:drop-shadow(0 4px 8px rgba(0,0,0,0.3));">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 52" style="width:100%;height:100%;">
            <path d="M20 0 C9 0 0 9 0 20 C0 34 20 52 20 52 C20 52 40 34 40 20 C40 9 31 0 20 0 Z" fill="#E8833A" stroke="#FFFFFF" stroke-width="2"/>
            <circle cx="20" cy="20" r="7" fill="#FFFFFF"/>
            <circle cx="20" cy="20" r="3" fill="#E8833A"/>
          </svg>
        </div>`,
      iconSize: [40, 52],
      iconAnchor: [20, 52],
      popupAnchor: [0, -52],
    });

    const graveMarker = L.marker([lat, lng], { icon: graveIcon, title: 'محل قبر' }).addTo(map);
    graveMarker.bindPopup(`<strong>قبرستان صاحب‌الزمان</strong><br/>شوشتر، خوزستان`);

    let routeGlow: L.Polyline | null = null;
    let routeCore: L.Polyline | null = null;
    let routeInner: L.Polyline | null = null;
    let userMarker: L.Marker | null = null;

    let pulseRafId: number | null = null;
    let pulseStartTime = 0;

    function startRoutePulse() {
      if (pulseRafId !== null) return;
      pulseStartTime = performance.now();

      const pulse = () => {
        if (!routeGlow || !routeCore) {
          pulseRafId = null;
          return;
        }

        const elapsed = (performance.now() - pulseStartTime) / 1000;
        const wave = (Math.sin(elapsed * 2.2) + 1) / 2;

        routeGlow.setStyle({
          opacity: 0.35 + wave * 0.5,
          weight: 10 + wave * 6,
        });

        routeCore.setStyle({
          weight: 4.5 + wave * 1.5,
        });

        pulseRafId = requestAnimationFrame(pulse);
      };

      pulseRafId = requestAnimationFrame(pulse);
    }

    function stopRoutePulse() {
      if (pulseRafId !== null) {
        cancelAnimationFrame(pulseRafId);
        pulseRafId = null;
      }
    }

    function clearRoute() {
      stopRoutePulse();
      if (routeGlow) { routeGlow.remove(); routeGlow = null; }
      if (routeCore) { routeCore.remove(); routeCore = null; }
      if (routeInner) { routeInner.remove(); routeInner = null; }
    }

    function drawRoute(latlngs: [number, number][]) {
      clearRoute();

      routeGlow = L.polyline(latlngs, {
        color: '#4ADE80',
        weight: 14,
        opacity: 0.6,
        lineJoin: 'round',
        lineCap: 'round',
        className: 'route-line-glow',
        interactive: false,
      }).addTo(map);

      routeCore = L.polyline(latlngs, {
        color: '#22C55E',
        weight: 5,
        opacity: 0.95,
        lineJoin: 'round',
        lineCap: 'round',
        interactive: false,
      }).addTo(map);

      routeInner = L.polyline(latlngs, {
        color: '#BBF7D0',
        weight: 1.5,
        opacity: 0.9,
        lineJoin: 'round',
        lineCap: 'round',
        interactive: false,
      }).addTo(map);

      startRoutePulse();
    }

    function showError(msg: string) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }
    function hideError() {
      if (errorEl) errorEl.hidden = true;
    }
    function setLoading(loading: boolean) {
      if (!navigateBtn || !navigateLabel) return;
      navigateBtn.disabled = loading;
      navigateLabel.textContent = loading ? 'در حال محاسبه مسیر…' : 'مسیریابی از موقعیت من';
    }

    if (navigateBtn) {
      navigateBtn.addEventListener('click', async () => {
        hideError();
        setLoading(true);

        try {
          const pos = await new Promise<GeolocationPosition>((resolve, reject) => {
            if (!navigator.geolocation) {
              reject(new Error('مرورگر شما از GPS پشتیبانی نمی‌کند.'));
              return;
            }
            navigator.geolocation.getCurrentPosition(resolve, (err) => {
              const msgs: Record<number, string> = {
                1: 'دسترسی به موقعیت رد شد. لطفاً در تنظیمات مرورگر مجوز بدهید.',
                2: 'موقعیت شما در دسترس نیست.',
                3: 'زمان دریافت موقعیت به پایان رسید.',
              };
              reject(new Error(msgs[err.code] ?? 'خطا در دریافت موقعیت.'));
            }, { enableHighAccuracy: true, timeout: 15000, maximumAge: 30000 });
          });

          const userLat = pos.coords.latitude;
          const userLng = pos.coords.longitude;

          if (googleLink) {
            googleLink.href = `https://www.google.com/maps/dir/?api=1&origin=${userLat},${userLng}&destination=${lat},${lng}&travelmode=driving`;
          }

          if (userMarker) userMarker.remove();
          const userIcon = L.divIcon({
            className: 'user-marker',
            html: `
              <div style="position:relative;width:24px;height:24px;">
                <span style="position:absolute;inset:0;border-radius:50%;background:#4A9EFF;opacity:.3;animation:user-pulse 2s ease-out infinite;"></span>
                <span style="position:absolute;inset:4px;border-radius:50%;background:#4A9EFF;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.4);"></span>
              </div>`,
            iconSize: [24, 24],
            iconAnchor: [12, 12],
          });
          userMarker = L.marker([userLat, userLng], { icon: userIcon, title: 'موقعیت شما' }).addTo(map);

          const key = import.meta.env.PUBLIC_ORS_API_KEY;
          if (!key) throw new Error('کلید OpenRouteService تنظیم نشده است.');

          const res = await fetch('https://api.openrouteservice.org/v2/directions/driving-car/geojson', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: key,
              Accept: 'application/geo+json, application/json',
            },
            body: JSON.stringify({
              coordinates: [[userLng, userLat], [lng, lat]],
              instructions: false,
              preference: 'recommended',
              units: 'm',
            }),
          });

          if (!res.ok) {
            const t = await res.text().catch(() => '');
            throw new Error(`خطای سرویس مسیریابی (${res.status}). ${t ? '' : 'لطفاً بعداً امتحان کنید.'}`);
          }

          const data = await res.json();
          const feature = data?.features?.[0];
          if (!feature) throw new Error('مسیری برای این مقصد یافت نشد.');

          const coords = feature.geometry.coordinates as [number, number][];
          const distance = feature.properties?.summary?.distance ?? 0;
          const duration = feature.properties?.summary?.duration ?? 0;

          const latlngs = coords.map(([x, y]) => [y, x]) as [number, number][];
          drawRoute(latlngs);

          const bounds = L.latLngBounds(latlngs);
          map.fitBounds(bounds, { padding: [40, 40] });

          if (routeInfo && distanceEl && durationEl) {
            const distText = distance < 1000
              ? `${Math.round(distance)} متر`
              : `${(distance / 1000).toFixed(1)} کیلومتر`;
            const totalMin = Math.round(duration / 60);
            const durText = totalMin < 60
              ? `${totalMin} دقیقه`
              : (totalMin % 60 === 0
                  ? `${Math.floor(totalMin / 60)} ساعت`
                  : `${Math.floor(totalMin / 60)} ساعت و ${totalMin % 60} دقیقه`);

            distanceEl.textContent = distText;
            durationEl.textContent = durText;
            routeInfo.hidden = false;
          }
        } catch (err) {
          const msg = err instanceof Error ? err.message : 'خطای ناشناخته در مسیریابی.';
          showError(msg);
          console.warn('[map]', err);
        } finally {
          setLoading(false);
        }
      });
    }

    window.addEventListener('pagehide', () => {
      stopRoutePulse();
    });
  }

  let mapInitialized = false;

  function bootWhenVisible() {
    if (mapInitialized) return;

    const root = document.querySelector<HTMLElement>('[data-map-root]');
    if (!root) return;

    const panel = root.closest<HTMLElement>('[data-tab-panel]');

    if (panel && !panel.hasAttribute('hidden')) {
      mapInitialized = true;
      initMap();
      return;
    }

    const checkAndInit = () => {
      if (mapInitialized) return;
      const currentPanel = root.closest<HTMLElement>('[data-tab-panel]');
      if (currentPanel && !currentPanel.hasAttribute('hidden')) {
        mapInitialized = true;
        initMap();
      }
    };

    window.addEventListener('hashchange', checkAndInit);

    if (panel) {
      const observer = new MutationObserver(() => {
        if (!panel.hasAttribute('hidden')) {
          observer.disconnect();
          checkAndInit();
        }
      });
      observer.observe(panel, { attributes: true, attributeFilter: ['hidden'] });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootWhenVisible);
  } else {
    bootWhenVisible();
  }
</script>