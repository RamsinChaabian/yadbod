---
import '../styles/global.css';
import { config } from '../utils/config';
import Seo from '../components/Seo.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = config.site.title,
  description = config.site.description,
} = Astro.props;

const fullTitle = title === config.site.title ? title : `${title} | ${config.site.title}`;
const animationsEnabled = config.features.animations;
---

<!doctype html>
<html lang={config.site.lang} dir={config.site.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFF8F0" />
    <title>{fullTitle}</title>
    <Seo />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css"
    />
    <slot name="head" />
  </head>
  <body class="bg-cream text-brown min-h-dvh antialiased">
    <slot />

    {animationsEnabled && (
      <script>
        async function bootGSAP() {
          try {
            const mod = await import('../animations/gsap');
            await mod.initAnimations();
          } catch (err) {
            console.warn('[gsap] failed:', err);
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bootGSAP);
        } else {
          bootGSAP();
        }
      </script>
    )}
  </body>
</html>