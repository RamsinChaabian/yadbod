---
import '../styles/global.css';
import { config } from '../utils/config';
import Seo from '../components/Seo.astro';
import PwaStatus from '../components/layout/PwaStatus.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = config.site.title,
  description = config.site.description,
} = Astro.props;

const fullTitle = title === config.site.title ? title : `${title} | ${config.site.title}`;
const animationsEnabled = config.features.animations;
---

<!doctype html>
<html lang={config.site.lang} dir={config.site.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#E8833A" />
    <title>{fullTitle}</title>
    <Seo />
    <link rel="icon" type="image/png" sizes="64x64" href="/pwa-64x64.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/pwa-192x192.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="یادبود نجیه" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css"
    />
    <slot name="head" />
  </head>
  <body class="bg-cream text-brown min-h-dvh antialiased">
    <slot />
    <PwaStatus />
    {animationsEnabled && (
      <script>
        async function bootGSAP() {
          try {
            const mod = await import('../animations/gsap');
            await mod.initAnimations();
          } catch (err) {
            console.warn('[gsap] failed:', err);
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bootGSAP);
        } else {
          bootGSAP();
        }
      </script>
    )}

    <!-- Service Worker Registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.warn('[PWA] Service Worker registration failed:', err);
          });
        });
      }
    </script>
  </body>
</html>