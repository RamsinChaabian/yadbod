---
import '../styles/global.css';
import { config } from '../utils/config';
import Seo from '../components/Seo.astro';
import PwaStatus from '../components/layout/PwaStatus.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = config.site.title,
  description = config.site.description,
  noindex = false,
} = Astro.props;

const fullTitle = title === config.site.title ? title : `${title} | ${config.site.title}`;
const animationsEnabled = config.features.animations;
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang={config.site.lang} dir={config.site.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#E8833A" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#E8833A" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>{fullTitle}</title>

    <Seo title={fullTitle} description={description} noindex={noindex} />

    <!-- Icons -->
    <link rel="icon" type="image/png" sizes="64x64" href="/pwa-64x64.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/pwa-192x192.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png" />

    <!-- PWA Manifest + iOS meta — فقط در production -->
    {isProd && <link rel="manifest" href="/manifest.webmanifest" />}
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="یادبود نجیه" />

    <slot name="head" />

    <!-- Turnstile — برای دیوار شمع‌ها -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </head>

  <body class="text-brown min-h-dvh antialiased">
    <slot />
    <Footer />

    <PwaStatus />

    {animationsEnabled && (
      <script>
        async function bootGSAP() {
          try {
            const mod = await import('../animations/gsap');
            await mod.initAnimations();
          } catch (err) {
            console.warn('[gsap] failed:', err);
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bootGSAP);
        } else {
          bootGSAP();
        }
      </script>
    )}

    <!-- Service Worker Registration — فقط در production -->
    {isProd && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch((err) => {
              console.warn('[PWA] Service Worker registration failed:', err);
            });
          });
        }
      </script>
    )}
  </body>
</html>